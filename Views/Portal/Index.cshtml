</div>
<h2 class="font-headline-lg text-headline-lg text-on-surface font-semibold">Từng khoảnh khắc kiến trúc tĩnh tại</h2>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">Một góc nhìn chân thực về sự giao hòa hoàn hảo giữa thiên nhiên và nghệ thuật bài trí.</p>
</div>

@{
    var galleryList = (ViewBag.GalleryImages as IEnumerable<HotelManagement.Web.Models.Entities.HotelGalleryImage>)?.ToList() 
                      ?? new List<HotelManagement.Web.Models.Entities.HotelGalleryImage>();
    int totalCount = galleryList.Count;
    int visibleCount = 5;
    int remainingCount = totalCount > visibleCount ? (totalCount - (visibleCount - 1)) : 0;
}

@if (galleryList.Any())
{
    <!-- Curated Editorial Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-space-md">
        @for (int i = 0; i < Math.Min(totalCount, visibleCount); i++)
        {
            var img = galleryList[i];
            bool isFirstBigCard = (i == 0);
            bool isLastVisibleWithMore = (i == visibleCount - 1 && remainingCount > 0);
            
            string cardClasses = isFirstBigCard 
                ? "md:col-span-2 lg:col-span-2 md:row-span-2 rounded-xl overflow-hidden shadow-sm relative group h-[480px] block" 
                : "rounded-xl overflow-hidden shadow-sm relative group h-[230px] block";

            <a href="@img.ImageUrl" data-fancybox="hotel-gallery" data-caption="@img.Title" class="@cardClasses">
                <div class="w-full h-full bg-cover bg-center group-hover:scale-105 transition-transform duration-700" style="background-image: url('@img.ImageUrl')"></div>
                
                @if (isLastVisibleWithMore)
                {
                    <!-- Dark Gray Overlay showing remaining photo count -->
                    <div class="absolute inset-0 bg-slate-900/60 group-hover:bg-slate-900/75 backdrop-blur-[2px] transition-all flex flex-col items-center justify-center text-white">
                        <span class="font-bold text-3xl md:text-4xl tracking-tight">+@remainingCount</span>
                        <span class="text-xs uppercase font-medium tracking-wider text-slate-200 mt-1">Xem thêm ảnh</span>
                    </div>
                }
            </a>
        }
    </div>

    <!-- Hidden remaining images for Fancybox gallery viewing -->
    @if (totalCount > visibleCount)
    {
        <div class="hidden">
            @for (int i = visibleCount - 1; i < totalCount; i++)
            {
                var img = galleryList[i];
                <a href="@img.ImageUrl" data-fancybox="hotel-gallery" data-caption="@img.Title"></a>
            }
        </div>
    }
}
</section>
