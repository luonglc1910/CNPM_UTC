@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Trang chủ";
}
<div class="flex flex-col w-full">
<!-- 1. HERO SECTION -->
<section class="relative w-full h-[720px] -mt-20 overflow-hidden flex items-center justify-center">
<!-- Background Image with Scrim -->
<div class="absolute inset-0 bg-cover bg-center" data-alt="Luxurious beachfront boutique hotel infinity pool at twilight, surrounded by modern architectural teak pavilions, ambient warm brass lantern lighting, calm emerald ocean reflections, modern Vietnamese minimalist aesthetic, shot on medium format camera with soft atmospheric mist" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuB2GPkdHunTSWkaEE4tQZalRBlOJHqtIRvSuh2JNrTuWlP7xh_es0ZZIhVJpiHY_0t3sFBxzuKHlfRlRYshjlog_6YXgCJUZchQbUsiWQroIt95iguU0PFabk-8pkp4j4YoIoS9Hczgq0Phez3xFlnest21wzGcClDwnEC9JKU5jn9MRXu1osGJXZ67UxcqTygpC2yDS2Yy1xQ5eqrqzCctYuieITUPbsiIPsgN79yG8ceiC4TZng')"></div>
<!-- Dark Teal & Ambient Scrim -->
<div class="absolute inset-0 bg-gradient-to-t from-primary via-primary-container/85 to-primary-container/60"></div>
<div class="absolute inset-0 bg-radial-gradient from-transparent via-transparent to-primary/40 pointer-events-none"></div>
<!-- Hero Content -->
<div class="relative z-10 max-w-[1280px] w-full mx-auto px-margin-sm md:px-margin pt-24 pb-16 flex flex-col items-center text-center">
<!-- Eyebrow -->
<div class="inline-flex items-center gap-space-xs px-3 py-1 rounded-full bg-surface-container-lowest/10 backdrop-blur-sm mb-space-md">
<span class="font-label-sm text-label-sm tracking-[0.25em] uppercase text-secondary-fixed font-semibold">Welcome to Aura Boutique Hotel</span>
</div>
<!-- H1 -->
<h1 class="font-display-lg text-display-lg md:text-[54px] md:leading-[64px] text-surface-container-lowest font-bold max-w-4xl tracking-tight mb-space-md">
        Một kỳ nghỉ đáng nhớ<br class="hidden sm:inline"> bắt đầu từ đây
      </h1>
<!-- Description -->
<p class="font-body-lg text-body-lg text-surface-variant max-w-2xl font-light mb-space-lg leading-relaxed">
        Trải nghiệm không gian nghỉ dưỡng tinh tế, dịch vụ tận tâm và những tiện nghi được chăm chút cho từng khoảnh khắc lưu trú tĩnh tại và thi vị.
      </p>
<!-- CTAs -->
<div class="flex flex-wrap items-center justify-center gap-space-md mb-space-xl">


</div>
<!-- Floating Review Badge -->

</div>
</section>
<!-- 2. BOOKING SEARCH COMPONENT (Overlapping) -->
<div class="relative z-20 max-w-[1200px] w-full mx-auto px-margin-sm md:px-margin -mt-16" id="booking-widget">
<div class="bg-surface-container-lowest rounded-xl shadow-[0_12px_36px_rgba(20,49,44,0.12)] p-space-md md:p-space-lg">
<form asp-action="Search" asp-controller="Portal" method="get" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-space-md items-end">
<!-- 1) Check-in Date -->
<div class="lg:col-span-3 flex flex-col gap-1.5">
<label class="font-label-sm text-label-sm uppercase tracking-wider text-outline font-semibold flex items-center gap-1">
<span class="material-symbols-outlined text-[16px] text-secondary">calendar_today</span>
            Ngày nhận phòng
          </label>
<div class="relative bg-surface-container-low rounded-lg p-2.5 flex items-center justify-between cursor-pointer hover:bg-surface-container transition-colors">
<input type="date" name="checkIn" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="appearance-none bg-transparent w-full font-headline-sm text-headline-sm text-on-surface font-semibold focus:outline-none" required />
</div>
</div>
<!-- 2) Check-out Date -->
<div class="lg:col-span-3 flex flex-col gap-1.5">
<label class="font-label-sm text-label-sm uppercase tracking-wider text-outline font-semibold flex items-center gap-1">
<span class="material-symbols-outlined text-[16px] text-secondary">event</span>
            Ngày trả phòng
          </label>
<div class="relative bg-surface-container-low rounded-lg p-2.5 flex items-center justify-between cursor-pointer hover:bg-surface-container transition-colors">
<input type="date" name="checkOut" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" class="appearance-none bg-transparent w-full font-headline-sm text-headline-sm text-on-surface font-semibold focus:outline-none" required />
</div>
</div>
<!-- 3) Guests -->
<div class="lg:col-span-2 flex flex-col gap-1.5">
<label class="font-label-sm text-label-sm uppercase tracking-wider text-outline font-semibold flex items-center gap-1">
<span class="material-symbols-outlined text-[16px] text-secondary">group</span>
            Số lượng khách
          </label>
<div class="relative bg-surface-container-low rounded-lg p-2.5 flex items-center justify-between cursor-pointer hover:bg-surface-container transition-colors">
<input type="number" name="capacity" min="1" value="2" class="appearance-none bg-transparent w-full font-headline-sm text-headline-sm text-on-surface font-semibold focus:outline-none" required />
<span class="material-symbols-outlined text-outline text-[20px] pointer-events-none absolute right-2.5">tune</span>
</div>
</div>
<!-- 4) Room Category -->
<div class="lg:col-span-2 flex flex-col gap-1.5">
<label class="font-label-sm text-label-sm uppercase tracking-wider text-outline font-semibold flex items-center gap-1">
<span class="material-symbols-outlined text-[16px] text-secondary">door_front</span>
            Hạng phòng
          </label>
<div class="relative bg-surface-container-low rounded-lg p-2.5 flex items-center justify-between cursor-pointer hover:bg-surface-container transition-colors">
<select name="categoryId" class="appearance-none bg-transparent w-full font-headline-sm text-headline-sm text-on-surface font-semibold focus:outline-none">
    <option value="">Tất cả</option>
    @if(ViewBag.RoomTypes != null) {
        foreach(var rt in ViewBag.RoomTypes) {
            <option value="@rt.Id">@rt.Name</option>
        }
    }
</select>
<span class="material-symbols-outlined text-outline text-[20px] pointer-events-none absolute right-2.5">arrow_drop_down</span>
</div>
</div>
<!-- 5) Action Button -->
<div class="lg:col-span-2 flex flex-col">
<button class="w-full h-[58px] bg-primary-container hover:bg-primary text-on-primary rounded-lg font-label-lg text-label-lg font-semibold flex items-center justify-center gap-2 shadow-[0_4px_12px_rgba(20,49,44,0.2)] transition-all" type="submit">
<span class="material-symbols-outlined text-[20px] text-secondary-fixed">search</span>
<span class="">Tìm phòng</span>
</button>
</div>
</form>
<!-- Trust Bar Perks -->
<div class="mt-space-md pt-3 flex flex-wrap items-center justify-center gap-y-2 gap-x-space-lg text-on-surface-variant font-label-sm text-label-sm">
<span class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px] text-secondary">verified</span>
          Cam kết giá tốt nhất khi đặt trực tiếp
        </span>
<span class="hidden sm:inline text-outline-variant">•</span>
<span class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px] text-secondary">free_cancellation</span>
          Miễn phí hủy phòng trước 48 giờ
        </span>
<span class="hidden sm:inline text-outline-variant">•</span>
<span class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-[16px] text-secondary">local_bar</span>
          Tặng đồ uống đặc biệt khi nhận phòng
        </span>
</div>
</div>
</div>
<!-- 3. INTRODUCTION SECTION -->
<section class="max-w-[1280px] w-full mx-auto px-margin-sm md:px-margin pt-space-xl pb-24"><div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-center">
  <!-- Left Column: Story, Philosophy & Stats (7 Cols) -->
  <div class="lg:col-span-7 flex flex-col gap-space-md">
    <!-- Eyebrow Badge -->
    <div class="inline-flex items-center gap-2">
      <span class="w-8 h-[2px] bg-secondary"></span>
      <span class="font-label-sm text-label-sm tracking-[0.25em] uppercase text-secondary font-semibold">VỀ CHÚNG TÔI • CÂU CHUYỆN AURA</span>
    </div>
    
    <!-- Main Headline -->
    <h2 class="font-headline-lg text-headline-lg md:text-[36px] md:leading-[44px] text-on-surface font-semibold tracking-tight">
      Nơi vẻ đẹp kiến trúc đương đại<br class="hidden sm:inline"> hòa quyện cùng lòng hiếu khách Việt Nam
    </h2>
    
    <!-- Body Narrative -->
    <div class="space-y-3">
      <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
        Được khởi nguồn từ niềm đam mê tôn vinh văn hóa bản địa, Aura Boutique Hotel &amp; Resort không đơn thuần là điểm dừng chân mà là một chốn đi về tĩnh tại. Mỗi góc nhỏ tại Aura đều phảng phất triết lý sống chậm, sử dụng các vật liệu tự nhiên mộc mạc như gỗ tếch, đá núi lửa và gốm thủ công kết hợp hoàn mỹ với tiện ích chuẩn mực 5 sao quốc tế.
      </p>
      <!-- Delicate Highlight Quote -->
      <div class="p-3.5 rounded-lg bg-surface-container-low border-l-2 border-secondary flex items-start gap-3">
        
        <p class="font-body-sm text-body-sm text-on-surface italic leading-relaxed">
          "Triết lý tôn vinh văn hóa bản địa qua từng chi tiết mộc mạc và chuẩn mực lưu trú quốc tế mang đến sự thư thái tuyệt đối cho tâm hồn."
        </p>
      </div>
    </div>
    
    <!-- Redesigned Cohesive Metric Strip -->
    <div class="grid grid-cols-3 gap-space-sm pt-2">
      <div class="p-3.5 rounded-xl bg-surface-container-low/80 flex flex-col justify-between shadow-[0_1px_2px_rgba(20,49,44,0.06)]">
        <span class="font-headline-lg text-headline-lg md:text-[32px] text-primary-container font-bold tracking-tight">48</span>
        <span class="font-label-sm text-label-sm text-on-surface-variant mt-1 leading-snug font-medium">Phòng &amp; Suite cao cấp</span>
      </div>
      <div class="p-3.5 rounded-xl bg-surface-container-low/80 flex flex-col justify-between shadow-[0_1px_2px_rgba(20,49,44,0.06)]">
        <span class="font-headline-lg text-headline-lg md:text-[32px] text-secondary font-bold tracking-tight">98%</span>
        <span class="font-label-sm text-label-sm text-on-surface-variant mt-1 leading-snug font-medium">Khách hài lòng tuyệt đối</span>
      </div>
      <div class="p-3.5 rounded-xl bg-surface-container-low/80 flex flex-col justify-between shadow-[0_1px_2px_rgba(20,49,44,0.06)]">
        <span class="font-headline-lg text-headline-lg md:text-[32px] text-primary-container font-bold tracking-tight">12</span>
        <span class="font-label-sm text-label-sm text-on-surface-variant mt-1 leading-snug font-medium">Giải thưởng quốc tế</span>
      </div>
    </div>
    
    <!-- CTA Action Link -->
    
  </div>
  
  <!-- Right Column: Editorial Overlapping Multi-photo Composition (5 Cols) -->
  <div class="lg:col-span-5 relative mt-space-md lg:mt-0">
    <div class="relative w-full">
      <!-- Primary Main Photo (Lobby / Architectural Space) -->
      <div class="w-full rounded-2xl overflow-hidden shadow-[0_8px_24px_rgba(20,49,44,0.08)] group h-[440px]">
        <div class="w-full h-full bg-cover bg-center group-hover:scale-105 transition-transform duration-700" data-alt="Modern serene luxury hotel lobby featuring high ceilings, warm natural wood slatted walls, stone water features, soft linen lounge seating, and subtle brass lighting fixtures" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuB5LTj-561bDrykcmgbSJrnaoYacqL1PDzW5vhF2MAT6xP5vwfCGufjsCkpnrkVrLUBqUn9veffnkns3dRdWWxi1r-SERmlC7K9NUXkZFRSIY1wZpV26asyoW336DGUIT05MtHLUIoHtI0JpUYJuToZJU7o39P44egSrst0a0JchukLaamECFTMrhYAYJtXMMjcsHELXBdZyLA5yeH7UR1zySfmzhtlB4xsDdjDrlh1xNkDpJrsFA')"></div>
      </div>
      
      <!-- Layered Inset Photo (Craftsman detail / Tea setting) -->
      
      
      <!-- Authentic Heritage Badge -->
      
    </div>
  </div>
</div></section>
<!-- 4. FEATURED ROOMS -->
<section class="w-full bg-surface-container-low py-space-xl" id="featured-rooms">
<div class="max-w-[1280px] w-full mx-auto px-margin-sm md:px-margin">
<!-- Section Header -->
<div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md mb-space-lg">
<div>
<div class="flex items-center gap-2 mb-1">
<span class="w-6 h-[2px] bg-secondary"></span>
<span class="font-label-sm text-label-sm tracking-[0.2em] uppercase text-secondary font-semibold">Khám phá phòng nghỉ</span>
</div>
<h2 class="font-headline-lg text-headline-lg text-on-surface font-semibold">Hạng phòng &amp; Không gian lưu trú</h2>
<p class="font-body-md text-body-md text-on-surface-variant mt-1">Nơi mỗi giác quan được nâng niu bằng những chất liệu tinh tuyển nhất.</p>
</div>
<a class="inline-flex items-center gap-1.5 font-label-lg text-label-lg font-semibold text-primary hover:text-secondary transition-colors" data-path="phong-nghi" href="#">
<span class="">Xem tất cả 48 phòng</span>
<span class="material-symbols-outlined text-[18px]">east</span>
</a>
</div>
<!-- 3 Prominent Room Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
@foreach(var room in (ViewBag.RoomTypes as IEnumerable<HotelManagement.Web.Models.Entities.RoomType>)?.Take(3) ?? Array.Empty<HotelManagement.Web.Models.Entities.RoomType>()) {
    <div class="group bg-surface-container-lowest rounded-xl overflow-hidden shadow-[0_2px_12px_rgba(20,49,44,0.06)] hover:shadow-[0_8px_28px_rgba(20,49,44,0.12)] transition-all flex flex-col">
    <div class="relative h-64 overflow-hidden">
    <div class="w-full h-full bg-cover bg-center group-hover:scale-105 transition-transform duration-500" style="background-image: url('@(!string.IsNullOrEmpty(room.ImageUrl) ? room.ImageUrl : "https://lh3.googleusercontent.com/aida-public/AB6AXuCO9DjhF6ltLD3HaQJCQWwn9kCybwBzVTnvWEFCyLjY4X0jcz5Ra4kZNwd5QVLiNNJ0DT6CxLDk7aOqa7hkyRWYDyfgjUmTgnF8Ugb95vLhfBqCbk-IY83WX8tDn7__OWeFJTPBem5vOPiyMoJEW0YxBmRHxbD6RQd2MQRCPWAg-Mx2XyTVzrQGQDgacJcW8mpLTor9gr8rT1cF545cwZm8IjM-D9CQf4sTN9v12w3W1Bw_dPaCOA")')"></div>
    </div>
    <div class="p-space-lg flex flex-col flex-1">
    <a href="/Portal/RoomDetails?id=@room.Id" class="group-hover:opacity-80 transition-opacity">
        <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold group-hover:text-secondary transition-colors">
                      @room.Name
        </h3>
    </a>
    <p class="font-body-sm text-body-sm text-on-surface-variant mt-1 line-clamp-2">
                  @room.Description
                </p>
    <div class="grid grid-cols-2 gap-2 my-space-md text-on-surface-variant font-label-sm text-label-sm">
    <div class="flex items-center gap-1.5">
    <span class="material-symbols-outlined text-[18px] text-secondary">king_bed</span>
    <span class="">@(room.BedType ?? "Không xác định")</span>
    </div>
    <div class="flex items-center gap-1.5">
    <span class="material-symbols-outlined text-[18px] text-secondary">group</span>
    <span class="">Tối đa @room.MaxCapacity khách</span>
    </div>
    <div class="flex items-center gap-1.5">
    <span class="material-symbols-outlined text-[18px] text-secondary">straighten</span>
    <span class="">@room.SizeSqm m²</span>
    </div>
    <div class="flex items-center gap-1.5">
    <span class="material-symbols-outlined text-[18px] text-secondary">wifi</span>
    <span class="">Wi-Fi miễn phí</span>
    </div>
    </div>
    <div class="mt-auto pt-space-sm flex items-center justify-between">
    <div>
    <span class="font-label-sm text-label-sm text-outline block">Giá chỉ từ</span>
    <span class="font-headline-sm text-headline-sm font-bold text-primary">@room.BasePricePerNight.ToString("N0")₫</span>
    <span class="font-body-sm text-body-sm text-on-surface-variant">/đêm</span>
    </div>
    <div class="flex items-center gap-2">
    <a class="px-3 py-2 rounded-lg bg-surface-container text-on-surface hover:bg-surface-container-high font-label-md text-label-md font-semibold transition-colors" href="/Portal/RoomDetails?id=@room.Id">
                      Chi tiết
                    </a>
    <a class="px-3.5 py-2 rounded-lg bg-primary-container hover:bg-primary text-on-primary font-label-md text-label-md font-semibold transition-colors shadow-sm" href="/Portal/RoomDetails?id=@room.Id">
                      Đặt ngay
                    </a>
    </div>
    </div>
    </div>
    </div>
}
</div>
</div>
</section>
<!-- 5. HOTEL AMENITIES -->
<section class="max-w-[1280px] w-full mx-auto px-margin-sm md:px-margin py-24">
<div class="text-center max-w-2xl mx-auto mb-space-xl">
<div class="inline-flex items-center gap-2 mb-2">
<span class="w-6 h-[2px] bg-secondary"></span>
<span class="font-label-sm text-label-sm tracking-[0.2em] uppercase text-secondary font-semibold">Tiện nghi &amp; Trải nghiệm</span>
<span class="w-6 h-[2px] bg-secondary"></span>
</div>
<h2 class="font-headline-lg text-headline-lg text-on-surface font-semibold">Nâng tầm kỳ nghỉ của bạn</h2>
<p class="font-body-md text-body-md text-on-surface-variant mt-2">
        Mỗi tiện ích tại Aura được kiến tạo để mang lại trải nghiệm tái tạo năng lượng thể chất và thư giãn tâm trí trọn vẹn nhất.
      </p>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
<!-- Item 1 -->
<div class="p-space-lg rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors group flex flex-col">
<div class="w-12 h-12 rounded-lg bg-surface-container-lowest flex items-center justify-center text-secondary mb-space-md shadow-sm group-hover:bg-primary-container group-hover:text-secondary-fixed transition-colors">
<span class="material-symbols-outlined text-[28px]">pool</span>
</div>
<h3 class="font-headline-sm text-headline-sm font-semibold text-on-surface mb-2">Hồ bơi chân mây</h3>
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
          Nhiệt độ nước ấm quanh năm với tầm nhìn ôm trọn bờ vịnh, kết hợp quầy sky-bar cocktail chiều hoàng hôn lãng mạn.
        </p>
</div>
<!-- Item 2 -->
<div class="p-space-lg rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors group flex flex-col">
<div class="w-12 h-12 rounded-lg bg-surface-container-lowest flex items-center justify-center text-secondary mb-space-md shadow-sm group-hover:bg-primary-container group-hover:text-secondary-fixed transition-colors">
<span class="material-symbols-outlined text-[28px]">restaurant</span>
</div>
<h3 class="font-headline-sm text-headline-sm font-semibold text-on-surface mb-2">The Brass Lantern Fine-Dining</h3>
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
          Giao thoa giữa hương vị truyền thống Việt Nam và kỹ nghệ ẩm thực Pháp hiện đại do đầu bếp sao Michelin đảm trách.
        </p>
</div>
<!-- Item 3 -->
<div class="p-space-lg rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors group flex flex-col">
<div class="w-12 h-12 rounded-lg bg-surface-container-lowest flex items-center justify-center text-secondary mb-space-md shadow-sm group-hover:bg-primary-container group-hover:text-secondary-fixed transition-colors">
<span class="material-symbols-outlined text-[28px]">spa</span>
</div>
<h3 class="font-headline-sm text-headline-sm font-semibold text-on-surface mb-2">Lotus Wellness &amp; Spa</h3>
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
          Liệu trình thảo mộc Đông y cổ truyền, phòng xông hơi đá muối Himalaya cùng không gian thiền định yên ả tuyệt đối.
        </p>
</div>
<!-- Item 4 -->
<div class="p-space-lg rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors group flex flex-col">
<div class="w-12 h-12 rounded-lg bg-surface-container-lowest flex items-center justify-center text-secondary mb-space-md shadow-sm group-hover:bg-primary-container group-hover:text-secondary-fixed transition-colors">
<span class="material-symbols-outlined text-[28px]">fitness_center</span>
</div>
<h3 class="font-headline-sm text-headline-sm font-semibold text-on-surface mb-2">Trung tâm thể thao cao cấp</h3>
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
          Trang bị hệ thống máy Technogym thế hệ mới cùng huấn luyện viên thể hình cá nhân và lớp Yoga ban mai hướng biển.
        </p>
</div>
<!-- Item 5 -->
<div class="p-space-lg rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors group flex flex-col">
<div class="w-12 h-12 rounded-lg bg-surface-container-lowest flex items-center justify-center text-secondary mb-space-md shadow-sm group-hover:bg-primary-container group-hover:text-secondary-fixed transition-colors">
<span class="material-symbols-outlined text-[28px]">laptop_mac</span>
</div>
