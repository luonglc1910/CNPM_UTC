<!-- Micro-interaction JS Script -->
<script>
    function swapGallery(element) {
      const img = element.querySelector('img');
      const mainImg = document.getElementById('mainGalleryImage');
      if (img && mainImg) {
        const tempSrc = mainImg.src;
        const tempAlt = mainImg.getAttribute('data-alt');
        mainImg.src = img.src;
        mainImg.setAttribute('data-alt', img.getAttribute('data-alt'));
        img.src = tempSrc;
        img.setAttribute('data-alt', tempAlt);
      }
    }

    function openFullGallery() {
      alert('Đang mở bộ sưu tập 12 hình ảnh độ phân giải cao của phòng Deluxe King Ocean View...');
    }

    // Dynamic Pricing Logic
    const dailyPrice = @Model.BasePricePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const hourlyFirstPrice = @Model.PriceFirstHour.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const overnightPrice = @Model.PriceOvernight.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const promotions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Promotions ?? new List<object>()));
    let appliedDiscount = 0; // percentage

    function calculatePrice(updatePromo = true) {
        if (updatePromo) {
            applyPromo(false);
        }
        const checkInEl = document.getElementById('checkInDate');
        const checkOutEl = document.getElementById('checkOutDate');
        const rentalTypeEl = document.getElementById('rentalType');
        if (!checkInEl || !checkOutEl || !rentalTypeEl) return;
        
        const rentalType = rentalTypeEl.value;
        const checkIn = new Date(checkInEl.value);
        const checkOut = new Date(checkOutEl.value);
        
        let nights = 1;
        if (checkIn && checkOut && checkOut > checkIn) {
            nights = Math.floor((checkOut - checkIn) / (1000 * 60 * 60 * 24));
        } else {
            checkOutEl.value = checkInEl.value;
            checkOutEl.stepUp();
        }
        
        const nightsCountEl = document.getElementById('nightsCount');
        if (nightsCountEl) {
            if (rentalType === 'Daily') nightsCountEl.innerText = nights;
            else if (rentalType === 'Hourly') nightsCountEl.innerText = '1 (Giờ đầu)';
            else nightsCountEl.innerText = '1 (Qua đêm)';
        }
        
        let basePrice = dailyPrice;
        if (rentalType === 'Hourly') basePrice = hourlyFirstPrice;
        else if (rentalType === 'Overnight') basePrice = overnightPrice;

        const displayMainPriceEl = document.getElementById('displayMainPrice');
        const displayMainSuffixEl = document.getElementById('displayMainSuffix');
        if (displayMainPriceEl && displayMainSuffixEl) {
            displayMainPriceEl.innerText = basePrice.toLocaleString('vi-VN') + ' ₫';
            if (rentalType === 'Daily') displayMainSuffixEl.innerText = '/ đêm';
            else if (rentalType === 'Hourly') displayMainSuffixEl.innerText = '/ giờ đầu';
            else displayMainSuffixEl.innerText = '/ đêm (Qua đêm)';
        }
        
        const guestCountEl = document.getElementById('guestCount');
        const extraBedEl = document.getElementById('extraBed');
        const guests = guestCountEl ? parseInt(guestCountEl.value) || @Model.StandardCapacity : @Model.StandardCapacity;
        const hasExtraBed = extraBedEl ? extraBedEl.checked : false;
        
        let extraGuestFee = 0;
        if (guests > @Model.StandardCapacity) {
            extraGuestFee = (guests - @Model.StandardCapacity) * @Model.ExtraGuestFeePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }
        let extraBedFee = hasExtraBed ? @Model.ExtraBedFeePerNight.ToString(System.Globalization.CultureInfo.InvariantCulture) : 0;
        
        let multiplier = rentalType === 'Daily' ? nights : 1;
        
        let total = (basePrice + extraGuestFee + extraBedFee) * multiplier;
        let originalTotal = total;
        
        if (appliedDiscount > 0) {
            total = total - (total * (appliedDiscount / 100));
        }

        const origPriceEl = document.getElementById('originalPrice');
        if (origPriceEl) {
            if (total < originalTotal) {
                origPriceEl.classList.remove('hidden');
                origPriceEl.innerText = originalTotal.toLocaleString('vi-VN') + ' ₫';
            } else {
                origPriceEl.classList.add('hidden');
            }
        }
        
        const totalPriceEl = document.getElementById('totalPrice');
        if (totalPriceEl) totalPriceEl.innerText = total.toLocaleString('vi-VN') + ' ₫';
    }

    function selectSuggestedPromo(code) {
        const input = document.getElementById('promoCode');
        if (!input) return;
        input.value = code;
        updateSuggestedPromoCardUI(code);
        applyPromo();
    }

    function clearPromoCode() {
        const input = document.getElementById('promoCode');
        if (input) input.value = '';
        updateSuggestedPromoCardUI('');
        applyPromo();
    }

    function updateSuggestedPromoCardUI(selectedCode) {
        const clearBtn = document.getElementById('clearPromoBtn');
        if (clearBtn) {
            if (selectedCode) clearBtn.classList.remove('hidden');
            else clearBtn.classList.add('hidden');
        }

        document.querySelectorAll('.suggested-promo-card').forEach(card => {
            const cardCode = card.getAttribute('data-code');
            const btn = card.querySelector('.promo-apply-btn');
            if (cardCode === selectedCode) {
                card.classList.add('border-secondary', 'bg-secondary/10', 'ring-1', 'ring-secondary');
                if (btn) {
                    btn.innerText = 'Đã chọn';
                    btn.className = 'promo-apply-btn text-[12px] font-semibold px-2.5 py-1 rounded bg-secondary text-surface-container-lowest transition-colors flex-shrink-0';
                }
            } else {
                card.classList.remove('border-secondary', 'bg-secondary/10', 'ring-1', 'ring-secondary');
                if (btn) {
                    btn.innerText = 'Dùng mã';
                    btn.className = 'promo-apply-btn text-[12px] font-semibold px-2.5 py-1 rounded bg-secondary-container hover:bg-secondary text-on-secondary-container hover:text-on-secondary transition-colors flex-shrink-0';
                }
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        const promoInput = document.getElementById('promoCode');
        if (promoInput) {
            promoInput.addEventListener('input', function() {
                const val = this.value.trim().toUpperCase();
                updateSuggestedPromoCardUI(val);
            });
        }
    });

    function applyPromo(updatePrice = true) {
        const codeInput = document.getElementById('promoCode');
        const messageEl = document.getElementById('promoMessage');
        const checkInEl = document.getElementById('checkInDate');
        if (!codeInput || !messageEl || !checkInEl) return;
        
        const code = codeInput.value.trim().toUpperCase();
        const checkIn = new Date(checkInEl.value);
        if (isNaN(checkIn.getTime())) return;
        checkIn.setHours(0, 0, 0, 0);
        
        if (!code) {
            appliedDiscount = 0;
            messageEl.innerText = "";
        } else {
            const promo = promotions ? promotions.find(p => p.PromoCode && p.PromoCode.toUpperCase() === code) : null;
            if (promo) {
                const startDate = new Date(promo.StartDate);
                startDate.setHours(0, 0, 0, 0);
                const endDate = new Date(promo.EndDate);
                endDate.setHours(23, 59, 59, 999);
                
                if (checkIn < startDate || checkIn > endDate) {
                    appliedDiscount = 0;
                    messageEl.innerText = `Mã này chỉ áp dụng từ ${startDate.toLocaleDateString('vi-VN')} đến ${endDate.toLocaleDateString('vi-VN')}!`;
                    messageEl.className = "text-sm font-medium mt-1 text-red-500";
                } else if (promo.ApplicableRoomTypeIds && !promo.ApplicableRoomTypeIds.split(',').map(x => x.trim()).includes('@Model.Id.ToString()')) {
                    appliedDiscount = 0;
                    messageEl.innerText = "Mã này không áp dụng cho loại phòng này!";
                    messageEl.className = "text-sm font-medium mt-1 text-red-500";
                } else {
                    const rentalType = document.getElementById('rentalType').value;
                    if (rentalType === 'Daily') {
                        appliedDiscount = promo.DiscountDailyPercent || 0;
                    } else if (rentalType === 'Hourly') {
                        appliedDiscount = promo.DiscountHourlyPercent || 0;
                    } else {
                        appliedDiscount = promo.DiscountOvernightPercent || 0;
                    }
                    
                    if (appliedDiscount > 0) {
                        messageEl.innerText = `Áp dụng thành công (Giảm ${appliedDiscount}%)!`;
                        messageEl.className = "text-sm font-medium mt-1 text-[#2e7d57]";
                    } else {
                        appliedDiscount = 0;
                        messageEl.innerText = "Mã này không có ưu đãi cho hình thức thuê đã chọn!";
                        messageEl.className = "text-sm font-medium mt-1 text-red-500";
                    }
                }
            } else {
                appliedDiscount = 0;
                messageEl.innerText = "Mã không hợp lệ hoặc không tồn tại!";
                messageEl.className = "text-sm font-medium mt-1 text-red-500";
            }
        }
        
        if (updatePrice) calculatePrice(false);

        // Update login banner and submit button state
        const isUserLoggedIn = @(isUserLoggedIn ? "true" : "false");
        const loginBanner = document.getElementById('loginBannerContainer');
        const submitBtn = document.getElementById('submitBookingBtn');
        
        if (!isUserLoggedIn && appliedDiscount > 0) {
            if (loginBanner) loginBanner.style.display = 'flex';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
            }
        } else {
            if (loginBanner) loginBanner.style.display = 'none';
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            }
        }
    }
  </script>
</div>