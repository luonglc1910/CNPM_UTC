<script>
    function swapGallery(element) {
      const img = element.querySelector('img');
      const mainImg = document.getElementById('mainGalleryImage');
      if (img && mainImg) {
        const tempSrc = mainImg.src;
        const tempAlt = mainImg.getAttribute('data-alt');
        mainImg.src = img.src;
        mainImg.setAttribute('data-alt', img.getAttribute('data-alt'));
        img.src = tempSrc;
        img.setAttribute('data-alt', tempAlt);
      }
    }

    function openFullGallery() {
      alert('Äang má»Ÿ bá»™ sÆ°u táº­p 12 hÃ¬nh áº£nh Ä‘á»™ phÃ¢n giáº£i cao cá»§a phÃ²ng Deluxe King Ocean View...');
    }
    
    // Dynamic Pricing Logic
    const basePrice = @Model.BasePricePerNight;
    const promotions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Promotions));
    let appliedDiscount = 0; // percentage
    let appliedPromoPrice = 0; // absolute price

    function calculatePrice() {
        const checkIn = new Date(document.getElementById('checkInDate').value);
        const checkOut = new Date(document.getElementById('checkOutDate').value);
        
        let nights = 1;
        if (checkIn && checkOut && checkOut > checkIn) {
            nights = Math.floor((checkOut - checkIn) / (1000 * 60 * 60 * 24));
        } else {
            // Invalid dates, reset checkout
            document.getElementById('checkOutDate').value = document.getElementById('checkInDate').value;
            document.getElementById('checkOutDate').stepUp();
        }
        
        document.getElementById('nightsCount').innerText = nights;
        
        let total = basePrice * nights;
        let originalTotal = total;
        
        if (appliedPromoPrice > 0) {
            total = appliedPromoPrice * nights;
        } else if (appliedDiscount > 0) {
            total = total - (total * (appliedDiscount / 100));
        }

        if (total < originalTotal) {
            document.getElementById('originalPrice').classList.remove('hidden');
            document.getElementById('originalPrice').innerText = originalTotal.toLocaleString('vi-VN') + ' â‚«';
        } else {
            document.getElementById('originalPrice').classList.add('hidden');
        }
        
        document.getElementById('totalPrice').innerText = total.toLocaleString('vi-VN') + ' â‚«';
    }

    function applyPromo() {
        const code = document.getElementById('promoCode').value.trim().toUpperCase();
        const messageEl = document.getElementById('promoMessage');
        
        if (!code) {
            appliedDiscount = 0;
            appliedPromoPrice = 0;
            messageEl.innerText = "";
            calculatePrice();
            return;
        }
        
        const promo = promotions.find(p => p.PromoCode && p.PromoCode.toUpperCase() === code);
        if (promo) {
            appliedDiscount = promo.DiscountPercentage || 0;
            appliedPromoPrice = promo.DisplayPrice || 0;
            messageEl.innerText = "Ãp dá»¥ng thÃ nh cÃ´ng!";
            messageEl.className = "text-sm font-medium mt-1 text-[#2e7d57]";
        } else {
            appliedDiscount = 0;
            appliedPromoPrice = 0;
            messageEl.innerText = "MÃ£ khÃ´ng há»£p lá»‡ hoáº·c Ä‘Ã£ háº¿t háº¡n!";
            messageEl.className = "text-sm font-medium mt-1 text-danger";
        }
        calculatePrice();
    }
  </script>
</div>