<script>
  (function () {
    // Highlight "Ưu đãi" link in shell header
    const navLinks = document.querySelectorAll('header nav a[data-path="uu-dai"]');
    navLinks.forEach((link) => {
      link.classList.remove('text-on-surface-variant');
      link.classList.add('text-primary', 'font-semibold', 'relative');
      const underline = document.createElement('div');
      underline.className = 'absolute bottom-[-4px] left-0 right-0 h-[2px] bg-secondary';
      link.appendChild(underline);
    });

    // Client-side category tab filtering interaction
    const tabButtons = document.querySelectorAll('#filter-tabs .tab-btn');
    tabButtons.forEach((btn) => {
      btn.addEventListener('click', function () {
        tabButtons.forEach((b) => {
          b.classList.remove('bg-primary-container', 'text-surface-container-lowest', 'font-semibold');
          b.classList.add('bg-surface-container-lowest', 'text-[#5e6b68]', 'font-medium');
        });
        this.classList.remove('bg-surface-container-lowest', 'text-[#5e6b68]', 'font-medium');
        this.classList.add('bg-primary-container', 'text-surface-container-lowest', 'font-semibold');
      });
    });
  })();
</script>