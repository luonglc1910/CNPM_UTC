@model SettingsViewModel
@{
    ViewData["Title"] = "Cấu hình hệ thống";

    // Nhóm vừa lưu hoặc vừa lỗi sẽ được cuộn tới; mặc định lấy từ query khi quay lại sau redirect.
    var active = Model.ActiveGroup ?? Context.Request.Query["group"].ToString();
}

@* Mỗi nhóm một form riêng: lưu nhóm này không đụng nhóm kia, và "Khôi phục mặc định"
   cũng theo từng nhóm đúng như SCR-A12 yêu cầu. *@

<div class="row g-3">

    @* ---------- 1. Thông tin khách sạn ---------- *@
    <div class="col-12" id="Hotel">
        <div class="card @(active == "Hotel" ? "border-primary" : "")">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-building"></i> 1. Thông tin khách sạn</span>
                <form method="post" asp-action="ResetGroup" asp-route-group="Hotel"
                      onsubmit="return confirm('Khôi phục nhóm Thông tin khách sạn về mặc định?');">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Khôi phục mặc định
                    </button>
                </form>
            </div>
            <div class="card-body">
                <form method="post" asp-action="SaveHotel" enctype="multipart/form-data">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Hotel.Name" class="form-label">Tên khách sạn <span class="text-danger">*</span></label>
                            <input asp-for="Hotel.Name" class="form-control" />
                            <span asp-validation-for="Hotel.Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Hotel.Address" class="form-label">Địa chỉ <span class="text-danger">*</span></label>
                            <input asp-for="Hotel.Address" class="form-control" />
                            <span asp-validation-for="Hotel.Address" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Hotel.Phone" class="form-label">Điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="Hotel.Phone" class="form-control" />
                            <span asp-validation-for="Hotel.Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Hotel.TaxCode" class="form-label"></label>
                            <input asp-for="Hotel.TaxCode" class="form-control" placeholder="VD: 0100000000" />
                            <span asp-validation-for="Hotel.TaxCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Logo (in trên hóa đơn)</label>
                            <input type="file" name="logo" class="form-control" accept="image/png,image/jpeg,image/webp" />
                            <div class="form-text">PNG / JPG / WEBP, tối đa 1 MB.</div>
                            <span asp-validation-for="Hotel.LogoPath" class="text-danger small"></span>
                            @if (ViewData.ModelState["logo"]?.Errors.Count > 0)
                            {
                                <span class="text-danger small">@ViewData.ModelState["logo"]!.Errors[0].ErrorMessage</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Hotel.LogoPath))
                        {
                            <div class="col-12 d-flex align-items-center gap-3">
                                <img src="@Model.Hotel.LogoPath" alt="Logo khách sạn" style="max-height: 64px" />
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="removeLogo" value="true" id="removeLogo" />
                                    <label class="form-check-label small" for="removeLogo">Xóa logo hiện tại</label>
                                </div>
                            </div>
                        }
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="bi bi-check-lg"></i> Lưu nhóm này
                    </button>
                </form>
            </div>
        </div>
    </div>

    @* ---------- 2. Giờ chuẩn ---------- *@
    <div class="col-lg-6" id="CheckInOut">
        <div class="card h-100 @(active == "CheckInOut" ? "border-primary" : "")">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock"></i> 2. Giờ chuẩn <small class="text-muted">(BR-01)</small></span>
                <form method="post" asp-action="ResetGroup" asp-route-group="CheckInOut"
                      onsubmit="return confirm('Khôi phục nhóm Giờ chuẩn về mặc định?');">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Mặc định
                    </button>
                </form>
            </div>
            <div class="card-body">
                <form method="post" asp-action="SaveCheckInOut">
                    <div class="row g-3">
                        <div class="col-6">
                            <label asp-for="CheckInOut.StandardCheckInTime" class="form-label"></label>
                            <input asp-for="CheckInOut.StandardCheckInTime" class="form-control" type="time" />
                            <span asp-validation-for="CheckInOut.StandardCheckInTime" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="CheckInOut.StandardCheckOutTime" class="form-label"></label>
                            <input asp-for="CheckInOut.StandardCheckOutTime" class="form-control" type="time" />
                            <span asp-validation-for="CheckInOut.StandardCheckOutTime" class="text-danger small"></span>
                        </div>

                        @* Gói qua đêm (BR-13) đứng cùng nhóm giờ chuẩn vì nó cũng là một cặp mốc giờ
                           cố định của khách sạn, chỉ khác là vắt qua nửa đêm. *@
                        <div class="col-12"><hr class="my-1" /></div>
                        <div class="col-6">
                            <label asp-for="CheckInOut.OvernightStartHour" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="CheckInOut.OvernightStartHour" class="form-control" type="number" min="0" max="23" step="1" />
                                <span class="input-group-text">giờ</span>
                            </div>
                            <span asp-validation-for="CheckInOut.OvernightStartHour" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="CheckInOut.OvernightEndHour" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="CheckInOut.OvernightEndHour" class="form-control" type="number" min="0" max="23" step="1" />
                                <span class="input-group-text">giờ</span>
                            </div>
                            <div class="form-text">
                                Gói chạy @Model.CheckInOut.OvernightStartHour:00 hôm nay → @Model.CheckInOut.OvernightEndHour:00 hôm sau.
                            </div>
                            <span asp-validation-for="CheckInOut.OvernightEndHour" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-info small mt-3 mb-0">
                        <i class="bi bi-info-circle"></i>
                        Đổi giờ chuẩn <strong>chỉ áp cho lượt lưu trú mới</strong>. Các lượt đang mở giữ nguyên
                        tham số đã chốt lúc check-in, để không đổi tiền của khách giữa chừng.
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="bi bi-check-lg"></i> Lưu nhóm này
                    </button>
                </form>
            </div>
        </div>
    </div>

    @* ---------- 3. Thuế &amp; làm tròn ---------- *@
    <div class="col-lg-6" id="Tax">
        <div class="card h-100 @(active == "Tax" ? "border-primary" : "")">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-percent"></i> 3. Thuế &amp; làm tròn <small class="text-muted">(BR-04)</small></span>
                <form method="post" asp-action="ResetGroup" asp-route-group="Tax"
                      onsubmit="return confirm('Khôi phục nhóm Thuế &amp; làm tròn về mặc định?');">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Mặc định
                    </button>
                </form>
            </div>
            <div class="card-body">
                <form method="post" asp-action="SaveTax">
                    <div class="row g-3">
                        <div class="col-6">
                            <label asp-for="Tax.VatPercent" class="form-label"></label>
                            <input asp-for="Tax.VatPercent" class="form-control" type="number" step="0.1" min="0" max="100" />
                            <div class="form-text">Áp trên tiền phòng + dịch vụ + phụ thu − giảm giá.</div>
                            <span asp-validation-for="Tax.VatPercent" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Tax.RoundingUnit" class="form-label"></label>
                            <input asp-for="Tax.RoundingUnit" class="form-control" type="number" step="1000" min="1" />
                            <div class="form-text">Làm tròn ở dòng tổng cuối cùng.</div>
                            <span asp-validation-for="Tax.RoundingUnit" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="bi bi-check-lg"></i> Lưu nhóm này
                    </button>
                </form>
            </div>
        </div>
    </div>

    @* ---------- 4. Phụ thu ---------- *@
    <div class="col-12" id="Surcharge">
        <div class="card @(active == "Surcharge" ? "border-primary" : "")">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-cash-stack"></i> 4. Phụ thu <small class="text-muted">(BR-03)</small></span>
                <form method="post" asp-action="ResetGroup" asp-route-group="Surcharge"
                      onsubmit="return confirm('Khôi phục nhóm Phụ thu về mặc định?');">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Khôi phục mặc định
                    </button>
                </form>
            </div>
            <div class="card-body">
                <form method="post" asp-action="SaveSurcharge">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 25%">Loại phụ thu</th>
                                    <th style="width: 35%">Điều kiện</th>
                                    <th>Cách tính</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Nhận phòng sớm</td>
                                    <td>
                                        Check-in <strong>trước</strong>
                                        <input asp-for="Surcharge.EarlyCheckInBoundaryHour" class="form-control d-inline-block"
                                               type="number" min="0" max="23" style="width: 5rem" />
                                        giờ
                                        <span asp-validation-for="Surcharge.EarlyCheckInBoundaryHour" class="text-danger small d-block"></span>
                                    </td>
                                    <td>
                                        <div class="input-group" style="max-width: 12rem">
                                            <input asp-for="Surcharge.EarlyCheckInBeforeBoundaryPercent" class="form-control"
                                                   type="number" step="1" min="0" max="100" />
                                            <span class="input-group-text">% giá đêm</span>
                                        </div>
                                        <span asp-validation-for="Surcharge.EarlyCheckInBeforeBoundaryPercent" class="text-danger small"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Nhận phòng sớm</td>
                                    <td>Check-in từ mốc trên tới giờ nhận phòng chuẩn (@Model.CheckInOut.StandardCheckInTime)</td>
                                    <td>
                                        <div class="input-group" style="max-width: 12rem">
                                            <input asp-for="Surcharge.EarlyCheckInToStandardPercent" class="form-control"
                                                   type="number" step="1" min="0" max="100" />
                                            <span class="input-group-text">% giá đêm</span>
                                        </div>
                                        <span asp-validation-for="Surcharge.EarlyCheckInToStandardPercent" class="text-danger small"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Trả phòng trễ</td>
                                    <td>
                                        Trả từ giờ chuẩn (@Model.CheckInOut.StandardCheckOutTime) tới
                                        <input asp-for="Surcharge.LateCheckOutTier1EndHour" class="form-control d-inline-block"
                                               type="number" min="0" max="23" style="width: 5rem" />
                                        giờ
                                        <span asp-validation-for="Surcharge.LateCheckOutTier1EndHour" class="text-danger small d-block"></span>
                                    </td>
                                    <td>
                                        <div class="input-group" style="max-width: 12rem">
                                            <input asp-for="Surcharge.LateCheckOutTier1Percent" class="form-control"
                                                   type="number" step="1" min="0" max="100" />
                                            <span class="input-group-text">% giá đêm</span>
                                        </div>
                                        <span asp-validation-for="Surcharge.LateCheckOutTier1Percent" class="text-danger small"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Trả phòng trễ</td>
                                    <td>
                                        Trả từ mốc trên tới
                                        <input asp-for="Surcharge.LateCheckOutFullNightHour" class="form-control d-inline-block"
                                               type="number" min="0" max="23" style="width: 5rem" />
                                        giờ
                                        <span asp-validation-for="Surcharge.LateCheckOutFullNightHour" class="text-danger small d-block"></span>
                                    </td>
                                    <td>
                                        <div class="input-group" style="max-width: 12rem">
                                            <input asp-for="Surcharge.LateCheckOutTier2Percent" class="form-control"
                                                   type="number" step="1" min="0" max="100" />
                                            <span class="input-group-text">% giá đêm</span>
                                        </div>
                                        <span asp-validation-for="Surcharge.LateCheckOutTier2Percent" class="text-danger small"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Trả phòng trễ</td>
                                    <td>Trả sau mốc trên</td>
                                    <td><span class="badge text-bg-warning">Tính thêm 1 đêm</span></td>
                                </tr>
                                @* Quy tắc làm tròn giờ dùng chung cho thuê theo giờ và phụ thu quá gói
                                   qua đêm (BR-13) — đặt trong bảng phụ thu để sửa một chỗ là xong cả hai. *@
                                <tr>
                                    <td>Làm tròn giờ</td>
                                    <td>Phần lẻ quá mức này mới tính thêm một giờ</td>
                                    <td>
                                        <div class="input-group" style="max-width: 12rem">
                                            <input asp-for="Surcharge.HourlyGraceMinutes" class="form-control"
                                                   type="number" step="1" min="0" max="59" />
                                            <span class="input-group-text">phút</span>
                                        </div>
                                        <span asp-validation-for="Surcharge.HourlyGraceMinutes" class="text-danger small"></span>
                                    </td>
                                </tr>
                                @* Hai dòng cuối của bảng BR-03 là phí theo từng loại phòng, không phải tham số
                                   toàn hệ thống — chỉ dẫn sang đúng chỗ sửa thay vì nhân đôi dữ liệu. *@
                                <tr class="text-muted">
                                    <td>Thêm người</td>
                                    <td>Vượt sức chứa chuẩn của loại phòng</td>
                                    <td>
                                        Phí / người / đêm khai báo theo
                                        <a asp-controller="RoomTypes" asp-action="Index">từng loại phòng</a>
                                    </td>
                                </tr>
                                <tr class="text-muted">
                                    <td>Thêm giường phụ</td>
                                    <td>Theo yêu cầu của khách</td>
                                    <td>
                                        Phí cố định / đêm khai báo theo
                                        <a asp-controller="RoomTypes" asp-action="Index">từng loại phòng</a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-info small mt-3 mb-0">
                        <i class="bi bi-info-circle"></i>
                        Đổi mức phụ thu <strong>chỉ áp cho lượt lưu trú mới</strong>; lượt đang mở giữ tham số
                        đã chốt lúc check-in.
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="bi bi-check-lg"></i> Lưu nhóm này
                    </button>
                </form>
            </div>
        </div>
    </div>

    @* ---------- 5. Chính sách cọc & hủy ---------- *@
    <div class="col-lg-6" id="Cancellation">
        <div class="card h-100 @(active == "Cancellation" ? "border-primary" : "")">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-shield-check"></i> 5. Cọc &amp; hủy <small class="text-muted">(BR-05)</small></span>
                <form method="post" asp-action="ResetGroup" asp-route-group="Cancellation"
                      onsubmit="return confirm('Khôi phục nhóm Chính sách cọc &amp; hủy về mặc định?');">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Mặc định
                    </button>
                </form>
            </div>
            <div class="card-body">
                <form method="post" asp-action="SaveCancellation">
                    <div class="row g-3">
                        <div class="col-6">
                            <label asp-for="Cancellation.DepositNights" class="form-label"></label>
                            <input asp-for="Cancellation.DepositNights" class="form-control" type="number" min="0" max="30" />
                            <span asp-validation-for="Cancellation.DepositNights" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Cancellation.HoldUntilHour" class="form-label"></label>
                            <input asp-for="Cancellation.HoldUntilHour" class="form-control" type="number" min="0" max="23" />
                            <div class="form-text">Giờ trong ngày đến; quá hạn thì được đánh dấu No-show.</div>
                            <span asp-validation-for="Cancellation.HoldUntilHour" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Cancellation.Over48hPercent" class="form-label"></label>
                            <input asp-for="Cancellation.Over48hPercent" class="form-control" type="number" step="1" min="0" max="100" />
                            <span asp-validation-for="Cancellation.Over48hPercent" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Cancellation.Between24And48hPercent" class="form-label"></label>
                            <input asp-for="Cancellation.Between24And48hPercent" class="form-control" type="number" step="1" min="0" max="100" />
                            <span asp-validation-for="Cancellation.Between24And48hPercent" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Cancellation.Under24hPercent" class="form-label"></label>
                            <input asp-for="Cancellation.Under24hPercent" class="form-control" type="number" step="1" min="0" max="100" />
                            <span asp-validation-for="Cancellation.Under24hPercent" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="bi bi-check-lg"></i> Lưu nhóm này
                    </button>
                </form>
            </div>
        </div>
    </div>

    @* ---------- 6. Hạn mức nghiệp vụ ---------- *@
    <div class="col-lg-6" id="Limit">
        <div class="card h-100 @(active == "Limit" ? "border-primary" : "")">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-sliders"></i> 6. Hạn mức nghiệp vụ</span>
                <form method="post" asp-action="ResetGroup" asp-route-group="Limit"
                      onsubmit="return confirm('Khôi phục nhóm Hạn mức nghiệp vụ về mặc định?');">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Mặc định
                    </button>
                </form>
            </div>
            <div class="card-body">
                <form method="post" asp-action="SaveLimit">
                    <div class="row g-3">
                        <div class="col-6">
                            <label asp-for="Limit.ReceptionistMaxDiscountAmount" class="form-label"></label>
                            <input asp-for="Limit.ReceptionistMaxDiscountAmount" class="form-control" type="number" step="any" min="0" />
                            <span asp-validation-for="Limit.ReceptionistMaxDiscountAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Limit.ReceptionistMaxDiscountPercent" class="form-label"></label>
                            <input asp-for="Limit.ReceptionistMaxDiscountPercent" class="form-control" type="number" step="1" min="0" max="100" />
                            <div class="form-text">Lễ tân bị chặn khi vượt <strong>một trong hai</strong> hạn mức.</div>
                            <span asp-validation-for="Limit.ReceptionistMaxDiscountPercent" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Limit.AllowSellWhenOutOfStock" class="form-check-input" />
                                <label asp-for="Limit.AllowSellWhenOutOfStock" class="form-check-label"></label>
                            </div>
                            <div class="form-text">
                                Công tắc tổng (BR-12). Một dịch vụ chỉ bán được khi hết tồn nếu bật cả ô này
                                lẫn cờ riêng của dịch vụ đó ở màn hình
                                <a asp-controller="HotelServices" asp-action="Index">Dịch vụ</a>.
                            </div>
                        </div>
                        <div class="col-6">
                            <label asp-for="Limit.LoyalGuestStayThreshold" class="form-label"></label>
                            <input asp-for="Limit.LoyalGuestStayThreshold" class="form-control" type="number" min="1" max="100" />
                            <span asp-validation-for="Limit.LoyalGuestStayThreshold" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Limit.ChildAgeLimit" class="form-label"></label>
                            <input asp-for="Limit.ChildAgeLimit" class="form-control" type="number" min="0" max="18" />
                            <span asp-validation-for="Limit.ChildAgeLimit" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="bi bi-check-lg"></i> Lưu nhóm này
                    </button>
                </form>
            </div>
        </div>
    </div>

    @* ---------- 7. Thanh toán VietQR & Email tự động ---------- *@
    <div class="col-12" id="Payment">
        <div class="card @(active == "Payment" ? "border-primary" : "")">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-qr-code-scan"></i> 7. Thanh toán VietQR &amp; Email tự động</span>
                <form method="post" asp-action="ResetGroup" asp-route-group="Payment"
                      onsubmit="return confirm('Khôi phục nhóm Thanh toán VietQR &amp; Email về mặc định?');">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Khôi phục mặc định
                    </button>
                </form>
            </div>
            <div class="card-body">
                <form method="post" asp-action="SavePayment">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="Payment.BankBin" class="form-label">Ngân hàng thụ hưởng (VietQR / Napas)</label>
                            <select asp-for="Payment.BankBin" class="form-select">
                                <option value="970419">Ngân hàng NCB (970419)</option>
                                <option value="970422">MB Bank (970422)</option>
                                <option value="970436">Vietcombank (970436)</option>
                                <option value="970415">VietinBank (970415)</option>
                                <option value="970418">BIDV (970418)</option>
                                <option value="970407">Techcombank (970407)</option>
                                <option value="970416">ACB (970416)</option>
                                <option value="970432">VPBank (970432)</option>
                                <option value="970423">TPBank (970423)</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Payment.BankName" class="form-label">Tên hiển thị ngân hàng</label>
                            <input asp-for="Payment.BankName" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Payment.BankAccountNo" class="form-label">Số thẻ / Số tài khoản</label>
                            <input asp-for="Payment.BankAccountNo" class="form-control" />
                            <div class="form-text">Thẻ NCB mẫu: <code>9704198526191432198</code></div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Payment.BankAccountName" class="form-label">Tên chủ thẻ / tài khoản (Không dấu)</label>
                            <input asp-for="Payment.BankAccountName" class="form-control text-uppercase" />
                            <div class="form-text">Ngày phát hành: <code>07/15</code> · OTP: <code>123456</code></div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>

                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input asp-for="Payment.EmailEnabled" class="form-check-input" />
                                <label asp-for="Payment.EmailEnabled" class="form-check-label fw-semibold"></label>
                            </div>
                            <div class="form-text">Khi bật, hệ thống tự động gửi Email xác nhận đặt phòng &amp; hóa đơn (kèm lưu bản xem trước HTML tại máy chủ).</div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Payment.EmailSenderName" class="form-label"></label>
                            <input asp-for="Payment.EmailSenderName" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Payment.EmailSenderAddress" class="form-label"></label>
                            <input asp-for="Payment.EmailSenderAddress" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Payment.EmailSmtpHost" class="form-label"></label>
                            <input asp-for="Payment.EmailSmtpHost" class="form-control" placeholder="smtp.gmail.com" />
                        </div>
                        <div class="col-md-1">
                            <label asp-for="Payment.EmailSmtpPort" class="form-label"></label>
                            <input asp-for="Payment.EmailSmtpPort" type="number" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Payment.EmailSmtpUser" class="form-label"></label>
                            <input asp-for="Payment.EmailSmtpUser" class="form-control" placeholder="tenkhachsan@gmail.com" autocomplete="username" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Payment.EmailSmtpPass" class="form-label"></label>
                            <input asp-for="Payment.EmailSmtpPass" class="form-control" value="" placeholder="@(Model.Payment.EmailSmtpPasswordConfigured ? "Đã cấu hình — để trống để giữ nguyên" : "Nhập mật khẩu ứng dụng")" autocomplete="new-password" />
                            <div class="form-text">
                                Gmail phải dùng <strong>Mật khẩu ứng dụng 16 ký tự</strong>, không dùng mật khẩu đăng nhập.
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">
                        <i class="bi bi-check-lg"></i> Lưu cấu hình VietQR &amp; Email
                    </button>
                </form>
            </div>
        </div>
    </div>

    @* ---------- 8. Bảng giá linh hoạt theo Mùa / Cuối tuần / Ngày lễ ---------- *@
    <div class="col-12" id="DynamicPricing">
        <div class="card @(active == "DynamicPricing" ? "border-primary" : "")">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-calendar-range"></i> 8. Bảng giá linh hoạt theo Mùa / Cuối tuần / Ngày lễ (Dynamic Pricing)</span>
                <form method="post" asp-action="ResetGroup" asp-route-group="DynamicPricing"
                      onsubmit="return confirm('Khôi phục Bảng giá linh hoạt về mặc định?');">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i> Khôi phục mặc định
                    </button>
                </form>
            </div>
            <div class="card-body">
                <form method="post" asp-action="SaveDynamicPricing" class="mb-4">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="DynamicPricing.Enabled" class="form-check-input" />
                                <label asp-for="DynamicPricing.Enabled" class="form-check-label fw-semibold"></label>
                            </div>
                            <div class="form-text">Tự động áp dụng giá cuối tuần và mùa lễ khi tạo đơn / đặt phòng trên Portal.</div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="DynamicPricing.WeekendSurchargePercent" class="form-label">Phụ thu đêm cuối tuần (%)</label>
                            <div class="input-group">
                                <span class="input-group-text">+</span>
                                <input asp-for="DynamicPricing.WeekendSurchargePercent" type="number" step="1" class="form-control" />
                                <span class="input-group-text">%</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="DynamicPricing.WeekendDays" class="form-label">Các đêm tính cuối tuần</label>
                            <select asp-for="DynamicPricing.WeekendDays" class="form-select">
                                <option value="Friday,Saturday">Đêm Thứ 6 &amp; Thứ 7</option>
                                <option value="Friday,Saturday,Sunday">Đêm Thứ 6, Thứ 7 &amp; Chủ Nhật</option>
                                <option value="Saturday,Sunday">Đêm Thứ 7 &amp; Chủ Nhật</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-check-lg"></i> Lưu cấu hình
                            </button>
                        </div>
                    </div>
                </form>

                <hr />
                <h6 class="fw-semibold mb-2"><i class="bi bi-stars text-warning"></i> Danh sách đợt Giá Mùa Vụ / Lễ Tết</h6>
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tên đợt / Sự kiện</th>
                                <th>Từ ngày</th>
                                <th>Đến ngày</th>
                                <th class="text-center">Điều chỉnh giá</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.DynamicPricing.Rules.OrderBy(x => x.StartDate))
                            {
                                <tr>
                                    <td class="fw-medium">@r.Name</td>
                                    <td>@r.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@r.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        @if (r.PercentChange >= 0)
                                        {
                                            <span class="badge text-bg-warning">+@r.PercentChange.ToString("0.#")%</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-success">@r.PercentChange.ToString("0.#")%</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (r.IsActive)
                                        {
                                            <span class="badge text-bg-success">Đang bật</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Đang tắt</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form method="post" asp-action="ToggleSeasonalRule" class="d-inline">
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                @(r.IsActive ? "Tắt" : "Bật")
                                            </button>
                                        </form>
                                        <form method="post" asp-action="DeleteSeasonalRule" class="d-inline"
                                              onsubmit="return confirm('Xóa đợt giá mùa vụ này?');">
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (Model.DynamicPricing.Rules.Count == 0)
                            {
                                <tr><td colspan="6" class="text-center text-muted py-3">Chưa có quy tắc giá mùa vụ nào.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <form method="post" asp-action="AddSeasonalRule" class="row g-2 align-items-end bg-light p-3 rounded border">
                    <div class="col-md-4">
                        <label class="form-label small mb-1">Tên đợt lễ / mùa cao điểm <span class="text-danger">*</span></label>
                        <input type="text" name="Name" required class="form-control form-control-sm" placeholder="VD: Tết Nguyên Đán / Lễ 30/4" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Từ ngày</label>
                        <input type="date" name="StartDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Đến ngày</label>
                        <input type="date" name="EndDate" value="@DateTime.Today.AddDays(5).ToString("yyyy-MM-dd")" required class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">% Tăng / Giảm</label>
                        <div class="input-group input-group-sm">
                            <input type="number" name="PercentChange" value="25" step="1" required class="form-control" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-sm btn-success w-100">
                            <i class="bi bi-plus-circle"></i> Thêm đợt giá
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<p class="text-muted small mt-3">
    <i class="bi bi-journal-text"></i>
    Mọi thay đổi cấu hình đều được ghi vào nhật ký thao tác kèm giá trị cũ → mới (BR-11).
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (!string.IsNullOrEmpty(active))
    {
        <script>
            // Sau khi lưu hoặc gặp lỗi, đưa người dùng về đúng thẻ vừa thao tác thay vì đầu trang.
            document.getElementById(@Json.Serialize(active))?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        </script>
    }
}
