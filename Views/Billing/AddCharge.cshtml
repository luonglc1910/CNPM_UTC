@model AddChargeViewModel
@{
    ViewData["Title"] = $"Thêm chi phí — Phòng {Model.RoomNumber}";
}

<div class="row"><div class="col-lg-6">
    <div class="card"><div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <form method="post" asp-action="AddCharge">
            <input type="hidden" asp-for="StayId" />
            <div class="mb-2">
                <label asp-for="ItemType" class="form-label">Loại chi phí</label>
                <select asp-for="ItemType" class="form-select" id="itemType">
                    <option value="@((int)FolioItemType.Service)">Dịch vụ</option>
                    <option value="@((int)FolioItemType.Surcharge)">Phụ thu thủ công</option>
                </select>
            </div>
            <div class="mb-2" id="serviceBlock">
                <label asp-for="HotelServiceId" class="form-label">Dịch vụ</label>
                <select asp-for="HotelServiceId" asp-items="Model.ServiceOptions" class="form-select">
                    <option value="">— Chọn dịch vụ —</option>
                </select>
                <div class="form-text">Đơn giá lấy từ danh mục; dịch vụ có kho sẽ trừ tồn.</div>
            </div>
            <div class="mb-2" id="descBlock">
                <label asp-for="Description" class="form-label">Nội dung phụ thu</label>
                <input asp-for="Description" class="form-control" placeholder="VD: Bồi thường khăn tắm" />
            </div>
            <div class="row g-2">
                <div class="col-6">
                    <label asp-for="Quantity" class="form-label">Số lượng</label>
                    <input asp-for="Quantity" type="number" min="1" class="form-control" />
                </div>
                <div class="col-6" id="priceBlock">
                    <label asp-for="UnitPrice" class="form-label">Đơn giá (phụ thu)</label>
                    <input asp-for="UnitPrice" type="number" min="0" step="any" class="form-control" />
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Thêm vào folio</button>
                <a class="btn btn-outline-secondary" asp-action="Folio" asp-route-stayId="@Model.StayId">Hủy</a>
            </div>
        </form>
    </div></div>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const type = document.getElementById('itemType');
            const svc = document.getElementById('serviceBlock');
            const desc = document.getElementById('descBlock');
            const price = document.getElementById('priceBlock');
            function toggle() {
                const isService = type.value === '@((int)FolioItemType.Service)';
                svc.style.display = isService ? '' : 'none';
                desc.style.display = isService ? 'none' : '';
                price.style.display = isService ? 'none' : '';
            }
            type.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
