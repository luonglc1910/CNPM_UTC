@model PaymentViewModel
@{
    ViewData["Title"] = $"Thanh toán — Phòng {Model.RoomNumber}";
    var s = Model.Summary;
}

<div class="row"><div class="col-lg-7">
    @if (!Model.HasOpenShift)
    {
        <div class="alert alert-warning">Bạn chưa mở ca — không thu tiền được (BR-10). <a class="btn btn-sm btn-primary ms-2" asp-controller="Shifts" asp-action="Index">Mở ca làm việc</a></div>
    }
    else if (!Model.IsInspected)
    {
        <div class="alert alert-warning">Chưa kiểm phòng &amp; minibar (BR-08). <a class="btn btn-sm btn-warning ms-2" asp-action="Minibar" asp-route-stayId="@Model.StayId">Kiểm phòng</a></div>
    }
    else if (!Model.IsLocked)
    {
        <div class="alert alert-warning">Folio chưa khóa. Vào <a asp-action="Folio" asp-route-stayId="@Model.StayId">folio</a> để khóa, hoặc dùng luồng check-out.</div>
    }

    <div class="card mb-3">
        <div class="card-header">Cần thu</div>
        <div class="card-body">
            <table class="table table-sm mb-0">
                <tbody>
                    <tr><td>Tổng hóa đơn</td><td class="text-end">@s.Total.ToString("N0") ₫</td></tr>
                    <tr><td>Đã cọc</td><td class="text-end">-@s.DepositApplied.ToString("N0") ₫</td></tr>
                    <tr class="table-light fw-semibold">
                        <td>@(Model.IsRefund ? "HOÀN LẠI KHÁCH" : "SỐ DƯ PHẢI THU")</td>
                        <td class="text-end">@Math.Abs(s.BalanceDue).ToString("N0") ₫</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.HasOpenShift && Model.IsInspected && Model.IsLocked)
    {
        <form method="post" asp-action="Payment">
            <input type="hidden" asp-for="StayId" />
            <input type="hidden" id="balanceDue" value="@s.BalanceDue" />
            <div class="card">
                <div class="card-header">@(Model.IsRefund ? "Hoàn tiền" : "Nhận tiền")</div>
                <div class="card-body">
                    <div class="mb-2">
                        <label asp-for="Method" class="form-label">Phương thức</label>
                        <select asp-for="Method" class="form-select">
                            @foreach (var m in Enum.GetValues<PaymentMethod>())
                            {
                                <option value="@((int)m)" selected="@(Model.Method == m)">@m.ToDisplayName()</option>
                            }
                        </select>
                    </div>
                    @if (!Model.IsRefund)
                    {
                        <div class="mb-2">
                            <label asp-for="AmountTendered" class="form-label">Số tiền khách đưa</label>
                            <input asp-for="AmountTendered" id="tendered" type="number" min="0" step="1000" class="form-control" />
                            <div class="form-text">Tiền thối lại: <strong id="change">0 ₫</strong></div>
                        </div>
                    }
                    <div class="mb-2">
                        <label asp-for="TransactionRef" class="form-label">Mã giao dịch (CK/Thẻ)</label>
                        <input asp-for="TransactionRef" class="form-control" />
                    </div>
                    @if (Model.IsAdmin && !Model.IsRefund)
                    {
                        <div class="form-check">
                            <input asp-for="RecordAsDebt" class="form-check-input" />
                            <label asp-for="RecordAsDebt" class="form-check-label">Ghi nhận công nợ (khách trả thiếu) — số tiền đưa = phần đã trả</label>
                        </div>
                    }
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> Hoàn tất &amp; xuất hóa đơn</button>
                    <a class="btn btn-outline-secondary" asp-action="Folio" asp-route-stayId="@Model.StayId">Quay lại</a>
                </div>
            </div>
        </form>
    }
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var due = Number(document.getElementById('balanceDue').value) || 0;
            var t = document.getElementById('tendered');
            var out = document.getElementById('change');
            if (!t) return;
            function upd() {
                var c = (Number(t.value) || 0) - due;
                out.textContent = (c > 0 ? c : 0).toLocaleString('vi-VN') + ' ₫';
            }
            t.addEventListener('input', upd); upd();
        })();
    </script>
}
