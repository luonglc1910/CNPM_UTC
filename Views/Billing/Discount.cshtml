@model DiscountViewModel
@{
    ViewData["Title"] = $"Giảm giá — Phòng {Model.RoomNumber}";
}

<div class="row"><div class="col-lg-6">
    <div class="card"><div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="alert alert-secondary small">
            Tạm tính hiện tại (trước giảm): <strong>@Model.CurrentSubTotal.ToString("N0") ₫</strong>.
            @if (!Model.IsAdmin)
            {
                <text>Hạn mức lễ tân: @Model.ReceptionistMaxAmount.ToString("N0") ₫ hoặc 10% — lấy giá trị nhỏ hơn.</text>
            }
        </div>
        <form method="post" asp-action="Discount">
            <input type="hidden" asp-for="StayId" />
            <div class="mb-2">
                <label class="form-label d-block">Hình thức</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="IsPercent" value="false" checked />
                    <label class="form-check-label">Số tiền cố định</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="IsPercent" value="true" />
                    <label class="form-check-label">Phần trăm (%)</label>
                </div>
            </div>
            <div class="mb-2">
                <label asp-for="Value" class="form-label">Giá trị <span class="text-danger">*</span></label>
                <input asp-for="Value" type="number" min="0" step="1000" class="form-control" />
                <span asp-validation-for="Value" class="text-danger small"></span>
            </div>
            <div class="mb-2">
                <label asp-for="Reason" class="form-label">Lý do <span class="text-danger">*</span></label>
                <input asp-for="Reason" class="form-control" placeholder="Khách quen / khiếu nại / khuyến mại..." />
                <span asp-validation-for="Reason" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Áp dụng giảm giá</button>
                <a class="btn btn-outline-secondary" asp-action="Folio" asp-route-stayId="@Model.StayId">Hủy</a>
            </div>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
