@{
    Layout = null;
    var room = ViewBag.Room as HotelManagement.Web.Models.Entities.Room;
    var activeStay = ViewBag.ActiveStay as HotelManagement.Web.Models.Entities.Stay;
    var folio = ViewBag.FolioSummary as HotelManagement.Web.Models.ViewModels.BillingFolioSummary;
    var services = ViewBag.Services as List<HotelManagement.Web.Models.Entities.HotelService> ?? new();
    var recentRequests = ViewBag.RecentRequests as List<HotelManagement.Web.Models.Entities.ServiceRequest> ?? new();
    string hotelName = ViewBag.HotelName as string ?? "AURA Boutique Hotel & Resort";
    string hotelPhone = ViewBag.HotelPhone as string ?? "0240 123 4567";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dịch vụ tại phòng @room?.RoomNumber — @hotelName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            background: #f3f5f4;
            color: #1c2824;
            padding-bottom: 40px;
        }
        .inroom-shell {
            max-width: 560px;
            margin: 0 auto;
        }
        .inroom-hero {
            background: linear-gradient(135deg, #13382c 0%, #1f5442 100%);
            color: #ffffff;
            border-bottom-left-radius: 24px;
            border-bottom-right-radius: 24px;
            padding: 24px 20px 28px;
            box-shadow: 0 8px 24px rgba(19, 56, 44, 0.18);
        }
        .quick-btn {
            border-radius: 14px;
            border: 1px solid #dce5e1;
            background: #ffffff;
            padding: 14px 12px;
            text-align: center;
            transition: transform 0.15s, box-shadow 0.15s;
            cursor: pointer;
            width: 100%;
        }
        .quick-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0,0,0,0.08);
            border-color: #1f5442;
        }
        .service-card {
            background: #ffffff;
            border-radius: 16px;
            border: 1px solid #e4ece9;
            padding: 14px 16px;
            margin-bottom: 10px;
        }
        .nav-pills .nav-link {
            border-radius: 999px;
            font-weight: 600;
            font-size: 0.85rem;
            color: #365047;
        }
        .nav-pills .nav-link.active {
            background-color: #13382c;
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="inroom-shell">
        <div class="inroom-hero">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-warning text-dark"><i class="bi bi-qr-code me-1"></i> QR In-Room Concierge</span>
                <a href="tel:@hotelPhone" class="text-white text-decoration-none small"><i class="bi bi-telephone-fill me-1"></i> Lễ tân: @hotelPhone</a>
            </div>
            <h1 class="h4 fw-bold mb-1">Phòng @room?.RoomNumber — @room?.RoomType.Name</h1>
            @if (activeStay != null)
            {
                <p class="small mb-2 opacity-90">
                    Xin chào quý khách <strong>@activeStay.PrimaryGuest.FullName</strong> · Trả phòng dự kiến: @activeStay.ExpectedCheckOut.ToString("dd/MM/yyyy HH:mm")
                </p>
            }
            else
            {
                <p class="small mb-2 opacity-75">
                    Chào mừng quý khách đến với @hotelName · Dịch vụ gọi món &amp; hỗ trợ tại phòng 24/7
                </p>
            }
            <div class="d-flex gap-2 flex-wrap mt-2 pt-2 border-top border-light border-opacity-25 small">
                <span><i class="bi bi-wifi me-1"></i> Wifi: <strong>AURA_VIP_@room?.Floor</strong> (Pass: <code>aurahotel88</code>)</span>
            </div>
        </div>

        <div class="px-3 mt-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success rounded-4 shadow-sm d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div class="small fw-medium">@TempData["Success"]</div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger rounded-4 shadow-sm d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div class="small fw-medium">@TempData["Error"]</div>
                </div>
            }

            <ul class="nav nav-pills nav-fill bg-white p-1 rounded-pill shadow-sm mb-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-food" type="button">
                        <i class="bi bi-cup-hot me-1"></i> Gọi đồ &amp; Dịch vụ
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-housekeeping" type="button">
                        <i class="bi bi-stars me-1"></i> Dọn phòng / Hỗ trợ
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-folio" type="button">
                        <i class="bi bi-receipt me-1"></i> Chi phí &amp; Trạng thái
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                @* TAB 1: GỌI ĐỒ ĂN / MINIBAR / GIẶT ỦI *@
                <div class="tab-pane fade show active" id="tab-food" role="tabpanel">
                    @foreach (var group in services.GroupBy(s => s.Category))
                    {
                        <h6 class="text-uppercase small fw-bold text-secondary mt-3 mb-2 ps-1">
                            @group.Key.ToDisplayName()
                        </h6>
                        @foreach (var s in group)
                        {
                            <div class="service-card shadow-sm">
                                <form method="post" asp-action="OrderService" class="row g-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="roomId" value="@room?.Id" />
                                    <input type="hidden" name="serviceId" value="@s.Id" />
                                    <div class="col-7">
                                        <div class="fw-semibold">@s.Name</div>
                                        <div class="text-success fw-bold small">@s.UnitPrice.ToString("N0") ₫ <span class="text-muted fw-normal">/ @s.Unit</span></div>
                                        <input type="text" name="note" class="form-control form-control-sm mt-1" placeholder="Ghi chú (ít đá, làm kỹ...)" />
                                    </div>
                                    <div class="col-5 text-end">
                                        <div class="input-group input-group-sm mb-1">
                                            <span class="input-group-text">SL</span>
                                            <input type="number" name="quantity" value="1" min="1" max="20" class="form-control text-center" />
                                        </div>
                                        <button type="submit" class="btn btn-sm btn-dark w-100 rounded-3">
                                            <i class="bi bi-Send-fill me-1"></i> Gọi ngay
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }
                    }
                </div>

                @* TAB 2: YÊU CẦU BUỒNG PHÒNG & BẢO TRÌ 1 CHẠM *@
                <div class="tab-pane fade" id="tab-housekeeping" role="tabpanel">
                    <div class="card border-0 rounded-4 shadow-sm mb-3">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3"><i class="bi bi-hand-index-thumb text-primary me-1"></i> Yêu cầu nhanh 1 chạm (Miễn phí)</h6>
                            <div class="row g-2">
                                @{
                                    var quickItems = new (string Title, string Icon, HotelManagement.Web.Models.RequestType Type, HotelManagement.Web.Models.RequestPriority Prio)[]
                                    {
                                        ("Yêu cầu dọn phòng ngay", "stars", HotelManagement.Web.Models.RequestType.GuestService, HotelManagement.Web.Models.RequestPriority.Medium),
                                        ("Thêm khăn tắm & đồ vệ sinh cá nhân", "droplet-half", HotelManagement.Web.Models.RequestType.GuestService, HotelManagement.Web.Models.RequestPriority.Low),
                                        ("Thêm gối ngủ & chăn ấm", "cloud-moon", HotelManagement.Web.Models.RequestType.GuestService, HotelManagement.Web.Models.RequestPriority.Low),
                                        ("Hỗ trợ mang hành lý / Gọi Taxi", "luggage", HotelManagement.Web.Models.RequestType.GuestService, HotelManagement.Web.Models.RequestPriority.Medium),
                                        ("Báo sự cố Điều hòa / Điện / Nước", "tools", HotelManagement.Web.Models.RequestType.Maintenance, HotelManagement.Web.Models.RequestPriority.Urgent),
                                        ("Báo sự cố Tivi / Wifi trong phòng", "router", HotelManagement.Web.Models.RequestType.Maintenance, HotelManagement.Web.Models.RequestPriority.Medium)
                                    };
                                }
                                @foreach (var q in quickItems)
                                {
                                    <div class="col-6">
                                        <form method="post" asp-action="QuickRequest">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="roomId" value="@room?.Id" />
                                            <input type="hidden" name="type" value="@((int)q.Type)" />
                                            <input type="hidden" name="priority" value="@((int)q.Prio)" />
                                            <input type="hidden" name="presetTitle" value="@q.Title" />
                                            <button type="submit" class="quick-btn">
                                                <i class="bi bi-@q.Icon fs-4 @(q.Type == HotelManagement.Web.Models.RequestType.Maintenance ? "text-danger" : "text-success") d-block mb-1"></i>
                                                <span class="small fw-semibold d-block">@q.Title</span>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>

                            <hr class="my-3" />
                            <h6 class="fw-bold mb-2">Hoặc gửi yêu cầu tùy chỉnh</h6>
                            <form method="post" asp-action="QuickRequest">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="roomId" value="@room?.Id" />
                                <div class="mb-2">
                                    <select name="type" class="form-select form-select-sm">
                                        <option value="@((int)HotelManagement.Web.Models.RequestType.GuestService)">Phục vụ buồng phòng</option>
                                        <option value="@((int)HotelManagement.Web.Models.RequestType.Maintenance)">Báo hỏng / Kỹ thuật</option>
                                    </select>
                                </div>
                                <input type="hidden" name="priority" value="@((int)HotelManagement.Web.Models.RequestPriority.Medium)" />
                                <input type="hidden" name="presetTitle" value="Yêu cầu từ khách tại phòng" />
                                <div class="mb-2">
                                    <textarea name="extraNote" rows="2" required class="form-control form-control-sm" placeholder="Nhập nội dung cần lễ tân hỗ trợ..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm w-100 rounded-3">
                                    <i class="bi bi-send me-1"></i> Gửi tới quầy Lễ tân
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                @* TAB 3: XEM TẠM TÍNH FOLIO & TRẠNG THÁI YÊU CẦU *@
                <div class="tab-pane fade" id="tab-folio" role="tabpanel">
                    @if (folio != null)
                    {
                        <div class="card border-0 rounded-4 shadow-sm mb-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold mb-0"><i class="bi bi-receipt-cutoff text-primary me-1"></i> Tạm tính chi phí phòng</h6>
                                    <span class="badge bg-light text-dark border">@folio.FolioCode</span>
                                </div>
                                <table class="table table-sm mb-0 small">
                                    <tbody>
                                        <tr><td>Tiền phòng</td><td class="text-end">@folio.RoomCharge.ToString("N0") ₫</td></tr>
                                        <tr><td>Dịch vụ &amp; Ẩm thực</td><td class="text-end">@folio.ServiceCharge.ToString("N0") ₫</td></tr>
                                        <tr><td>Phụ thu</td><td class="text-end">@folio.SurchargeAmount.ToString("N0") ₫</td></tr>
                                        @if (folio.DiscountAmount > 0)
                                        {
                                            <tr class="text-success"><td>Giảm giá</td><td class="text-end">-@folio.DiscountAmount.ToString("N0") ₫</td></tr>
                                        }
                                        <tr><td>VAT (@((folio.TaxRate * 100).ToString("0.#"))%)</td><td class="text-end">@folio.TaxAmount.ToString("N0") ₫</td></tr>
                                        @if (folio.DepositApplied > 0)
                                        {
                                            <tr class="text-success"><td>Đã đặt cọc / Trả trước</td><td class="text-end">-@folio.DepositApplied.ToString("N0") ₫</td></tr>
                                        }
                                        <tr class="fw-bold table-light fs-6">
                                            <td>Còn phải thanh toán</td>
                                            <td class="text-end text-danger">@folio.BalanceDue.ToString("N0") ₫</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <div class="card border-0 rounded-4 shadow-sm">
                        <div class="card-body">
                            <h6 class="fw-bold mb-2"><i class="bi bi-clock-history text-secondary me-1"></i> Lịch sử yêu cầu của phòng @room?.RoomNumber</h6>
                            @if (recentRequests.Count == 0)
                            {
                                <div class="text-muted small text-center py-3">Chưa có yêu cầu phục vụ nào.</div>
                            }
                            else
                            {
                                <div class="list-group list-group-flush small">
                                    @foreach (var req in recentRequests)
                                    {
                                        <div class="list-group-item px-0">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <code>@req.Code</code>
                                                <span class="badge @(req.Status == HotelManagement.Web.Models.RequestStatus.Completed ? "bg-success" : req.Status == HotelManagement.Web.Models.RequestStatus.InProgress ? "bg-warning text-dark" : "bg-primary")">
                                                    @req.Status.ToDisplayName()
                                                </span>
                                            </div>
                                            <div>@req.Description</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">@req.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

