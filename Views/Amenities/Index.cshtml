@model AmenityIndexViewModel
@{
    ViewData["Title"] = "Tiện nghi";
}

<div class="ops-page">
<section class="ops-hero"><div><span class="ops-hero-kicker">Cấu hình phòng</span><h2>Tiện nghi phòng</h2><p>Quản lý danh mục tiện nghi dùng trong nội dung và cấu hình loại phòng.</p></div><div class="ops-hero-actions"><a asp-action="Create" class="btn btn-light"><i class="bi bi-plus-lg"></i> Thêm tiện nghi</a></div></section>
<div class="d-flex justify-content-between align-items-center mb-0">
    <h1 class="h3 mb-0 text-gray-800">Tiện nghi</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Thêm tiện nghi mới
    </a>
</div>

@if (Model.Results.TotalItems == 0)
{
    <div class="card"><div class="card-body text-center text-muted py-5">
        <p class="mb-0">Chưa có tiện nghi nào.</p>
    </div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px" class="text-center">Icon</th>
                        <th>Tên tiện nghi</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Results.Items)
                {
                    <tr>
                        <td class="text-center">
                            <div class="fs-4">@Html.Raw(item.IconSvg)</div>
                        </td>
                        <td class="fw-semibold">
                            @item.Name
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id" title="Sửa"><i class="bi bi-pencil"></i></a>
                            <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('Xóa tiện nghi này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pager" model="@((Model.Results.Page, Model.Results.TotalPages, Model.Results.TotalItems))" />
}
</div>
