@model AmenityFormViewModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Thêm Tiện nghi" : "Sửa Tiện nghi";
}

<div class="ops-page">
<section class="ops-hero"><div><span class="ops-hero-kicker">Cấu hình phòng</span><h2>@(isNew ? "Thêm tiện nghi" : "Chỉnh sửa tiện nghi")</h2><p>Tên và biểu tượng sẽ hiển thị trên thông tin loại phòng.</p></div><div class="ops-hero-actions"><a class="btn btn-outline-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Danh sách</a></div></section>
<div class="card" style="max-width: 720px">
    <div class="card-body">
        <form method="post">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                
                <div class="col-12">
                    <label asp-for="IconSvg" class="form-label"></label>
                    <input asp-for="IconSvg" class="form-control text-monospace" placeholder="<i class='bi bi-wifi'></i>" />
                    <div class="form-text">Mã HTML/SVG để hiển thị icon (Khuyên dùng Bootstrap Icons).</div>
                </div>
            </div>

            <hr class="my-4" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Lưu thay đổi</button>
        </form>
    </div>
</div>
</div>
