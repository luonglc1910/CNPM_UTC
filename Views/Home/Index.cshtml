@model DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
    var today = DateTime.Today;
    var todayQuery = today.ToString("yyyy-MM-dd");
    var financeController = Model.RevenueIsWholeHotel ? "Reports" : "Shifts";
    var financeScope = Model.RevenueIsWholeHotel ? "Toàn khách sạn" : "Ca làm việc của bạn";
}

<div class="dashboard-page">
    <section class="dashboard-welcome">
        <div>
            <div class="dashboard-eyebrow">@today.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</div>
            <h2>Trung tâm điều hành khách sạn</h2>
            <p>Theo dõi phòng, dòng tiền và công việc cần xử lý trong một màn hình.</p>
        </div>
        <div class="dashboard-welcome-actions">
            <a class="btn btn-light" asp-controller="Reservations" asp-action="Create">
                <i class="bi bi-plus-lg"></i> Tạo đơn đặt phòng
            </a>
            <a class="btn btn-outline-light" asp-controller="Reservations" asp-action="RoomChart">
                <i class="bi bi-calendar3-range"></i> Xem sơ đồ phòng
            </a>
        </div>
    </section>

    <section class="dashboard-section">
        <div class="dashboard-section-head">
            <div>
                <span class="dashboard-section-kicker">Trạng thái hiện tại</span>
                <h3>Tổng quan các phòng</h3>
            </div>
            <div class="occupancy-summary">
                <div class="d-flex justify-content-between gap-4">
                    <span>Công suất phòng</span>
                    <strong>@Model.OccupancyRate.ToString("P0")</strong>
                </div>
                <div class="progress" role="progressbar" aria-label="Công suất phòng" aria-valuenow="@(Model.OccupancyRate * 100)" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: @Model.OccupancyRate.ToString("P0", System.Globalization.CultureInfo.InvariantCulture)"></div>
                </div>
                <small>@(Model.OccupiedRooms + Model.PendingCheckInRooms) / @Model.UsableRooms phòng đã có khách hoặc chờ nhận</small>
            </div>
        </div>

        <div class="dashboard-room-grid">
            <a class="dashboard-room-card room-available" asp-controller="Rooms" asp-action="Index" asp-route-status="@RoomStatus.Available">
                <span class="dashboard-card-icon"><i class="bi bi-door-open"></i></span>
                <span class="dashboard-card-copy"><span>Phòng trống</span><small>Sẵn sàng bán</small></span>
                <strong>@Model.AvailableRooms</strong>
                <i class="bi bi-arrow-up-right dashboard-card-arrow"></i>
            </a>
            <a class="dashboard-room-card room-reserved" asp-controller="FrontDesk" asp-action="Index" asp-route-panel="pending">
                <span class="dashboard-card-icon"><i class="bi bi-calendar2-check"></i></span>
                <span class="dashboard-card-copy"><span>Chờ check-in</span><small>Đã giữ phòng cho khách</small></span>
                <strong>@Model.PendingCheckInRooms</strong>
                <i class="bi bi-arrow-up-right dashboard-card-arrow"></i>
            </a>
            <a class="dashboard-room-card room-occupied" asp-controller="Rooms" asp-action="Index" asp-route-status="@RoomStatus.Occupied">
                <span class="dashboard-card-icon"><i class="bi bi-person-fill"></i></span>
                <span class="dashboard-card-copy"><span>Đang có khách</span><small>Phòng đang lưu trú</small></span>
                <strong>@Model.OccupiedRooms</strong>
                <i class="bi bi-arrow-up-right dashboard-card-arrow"></i>
            </a>
            <a class="dashboard-room-card room-dirty" asp-controller="Rooms" asp-action="Index" asp-route-status="@RoomStatus.Dirty">
                <span class="dashboard-card-icon"><i class="bi bi-stars"></i></span>
                <span class="dashboard-card-copy"><span>Chờ dọn</span><small>Cần buồng phòng xử lý</small></span>
                <strong>@Model.DirtyRooms</strong>
                <i class="bi bi-arrow-up-right dashboard-card-arrow"></i>
            </a>
            <a class="dashboard-room-card room-maintenance" asp-controller="Rooms" asp-action="Index" asp-route-status="@RoomStatus.Maintenance">
                <span class="dashboard-card-icon"><i class="bi bi-tools"></i></span>
                <span class="dashboard-card-copy"><span>Bảo trì</span><small>Tạm ngưng khai thác</small></span>
                <strong>@Model.MaintenanceRooms</strong>
                <i class="bi bi-arrow-up-right dashboard-card-arrow"></i>
            </a>
        </div>
    </section>

    <div class="row g-4 dashboard-main-row">
        <div class="col-xl-7">
            <section class="dashboard-section h-100">
                <div class="dashboard-section-head align-items-end">
                    <div>
                        <span class="dashboard-section-kicker">Dòng tiền · @financeScope</span>
                        <h3>Số tiền thu – chi hôm nay</h3>
                    </div>
                    <a class="dashboard-detail-link" asp-controller="@financeController" asp-action="Index"
                       asp-route-From="@(Model.RevenueIsWholeHotel ? todayQuery : null)"
                       asp-route-To="@(Model.RevenueIsWholeHotel ? todayQuery : null)">
                        Xem chi tiết <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                @if (!Model.RevenueIsWholeHotel && !Model.HasOpenShift)
                {
                    <a class="dashboard-shift-warning" asp-controller="Shifts" asp-action="Index">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span><strong>Chưa mở ca làm việc.</strong> Mở ca để ghi nhận giao dịch thu – chi.</span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                }

                <div class="dashboard-finance-grid">
                    <a class="dashboard-finance-card finance-in" asp-controller="@financeController" asp-action="Index"
                       asp-route-From="@(Model.RevenueIsWholeHotel ? todayQuery : null)"
                       asp-route-To="@(Model.RevenueIsWholeHotel ? todayQuery : null)">
                        <span class="finance-icon"><i class="bi bi-arrow-down-left"></i></span>
                        <span class="finance-label">Tổng thu</span>
                        <strong>@Model.CashInToday.ToString("N0") <small>₫</small></strong>
                        <span class="finance-note">Các giao dịch thu tiền dương</span>
                    </a>
                    <a class="dashboard-finance-card finance-out" asp-controller="@financeController" asp-action="Index"
                       asp-route-From="@(Model.RevenueIsWholeHotel ? todayQuery : null)"
                       asp-route-To="@(Model.RevenueIsWholeHotel ? todayQuery : null)">
                        <span class="finance-icon"><i class="bi bi-arrow-up-right"></i></span>
                        <span class="finance-label">Tổng chi / hoàn</span>
                        <strong>@Model.CashOutToday.ToString("N0") <small>₫</small></strong>
                        <span class="finance-note">Hoàn cọc và điều chỉnh giảm</span>
                    </a>
                    <a class="dashboard-finance-card finance-net" asp-controller="@financeController" asp-action="Index"
                       asp-route-From="@(Model.RevenueIsWholeHotel ? todayQuery : null)"
                       asp-route-To="@(Model.RevenueIsWholeHotel ? todayQuery : null)">
                        <span class="finance-icon"><i class="bi bi-wallet2"></i></span>
                        <span class="finance-label">Thu ròng</span>
                        <strong>@Model.NetCashFlowToday.ToString("N0") <small>₫</small></strong>
                        <span class="finance-note">@Model.PaymentCountToday giao dịch hôm nay</span>
                    </a>
                </div>
            </section>
        </div>

        <div class="col-xl-5">
            <section class="dashboard-section h-100">
                <div class="dashboard-section-head">
                    <div>
                        <span class="dashboard-section-kicker">Lễ tân</span>
                        <h3>Hoạt động hôm nay</h3>
                    </div>
                    <a class="dashboard-detail-link" asp-controller="FrontDesk" asp-action="Index">Mở bảng điều khiển <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="dashboard-activity-list">
                    <a asp-controller="FrontDesk" asp-action="Index" asp-route-panel="arrivals">
                        <span class="activity-icon activity-in"><i class="bi bi-box-arrow-in-right"></i></span>
                        <span><strong>Đã check-in</strong><small>Lượt nhận phòng trong ngày</small></span>
                        <b>@Model.ArrivalsToday</b><i class="bi bi-chevron-right"></i>
                    </a>
                    <a asp-controller="FrontDesk" asp-action="Index" asp-route-panel="departures">
                        <span class="activity-icon activity-out"><i class="bi bi-box-arrow-right"></i></span>
                        <span><strong>Đã check-out</strong><small>Lượt trả phòng trong ngày</small></span>
                        <b>@Model.DeparturesToday</b><i class="bi bi-chevron-right"></i>
                    </a>
                    <a asp-controller="FrontDesk" asp-action="Index" asp-route-panel="pending">
                        <span class="activity-icon activity-pending"><i class="bi bi-hourglass-split"></i></span>
                        <span><strong>Chờ check-in</strong><small>Mở danh sách khách sắp đến</small></span>
                        <i class="bi bi-arrow-right ms-auto"></i>
                    </a>
                </div>
            </section>
        </div>
    </div>

    <section class="dashboard-section">
        <div class="dashboard-section-head">
            <div>
                <span class="dashboard-section-kicker">Điều hướng nhanh</span>
                <h3>Lối tắt nghiệp vụ</h3>
            </div>
        </div>
        <div class="dashboard-shortcuts">
            <a asp-controller="Reservations" asp-action="Create"><i class="bi bi-journal-plus"></i><span><strong>Tạo đơn mới</strong><small>Đặt phòng cho khách</small></span></a>
            <a asp-controller="Reservations" asp-action="RoomChart"><i class="bi bi-calendar3-range"></i><span><strong>Tình trạng phòng</strong><small>Xem lịch theo ngày</small></span></a>
            <a asp-controller="FrontDesk" asp-action="Index" asp-route-panel="pending"><i class="bi bi-person-check"></i><span><strong>Khách chờ nhận phòng</strong><small>Thực hiện check-in</small></span></a>
            <a asp-controller="Billing" asp-action="Index"><i class="bi bi-receipt"></i><span><strong>Thu ngân</strong><small>Folio và thanh toán</small></span></a>
            <a asp-controller="Housekeeping" asp-action="Index"><i class="bi bi-stars"></i><span><strong>Buồng phòng</strong><small>Dọn phòng, báo hỏng</small></span></a>
            @if (Model.RevenueIsWholeHotel)
            {
                <a asp-controller="Reports" asp-action="Index"><i class="bi bi-graph-up-arrow"></i><span><strong>Báo cáo</strong><small>Doanh thu và công suất</small></span></a>
            }
            else
            {
                <a asp-controller="Shifts" asp-action="Index"><i class="bi bi-cash-stack"></i><span><strong>Ca làm việc</strong><small>Thu chi trong ca</small></span></a>
            }
        </div>
    </section>

    <section class="dashboard-section dashboard-pending-section">
        <div class="dashboard-section-head">
            <div>
                <span class="dashboard-section-kicker">Ưu tiên trong ca</span>
                <h3>Việc cần xử lý</h3>
            </div>
            @if (Model.TotalPending == 0)
            {
                <span class="badge rounded-pill text-bg-success">Không còn việc tồn</span>
            }
            else
            {
                <span class="badge rounded-pill text-bg-warning">@Model.TotalPending việc</span>
            }
        </div>
        <div class="dashboard-pending-grid">
            @foreach (var w in Model.PendingWork)
            {
                <a asp-controller="@w.Controller" asp-action="@w.Action" asp-all-route-data="w.RouteValues" class="@(w.Count > 0 ? "has-work" : "")">
                    <span class="pending-icon"><i class="bi bi-@w.Icon"></i></span>
                    <span><strong>@w.Label</strong><small>@(w.Hint ?? "Không có việc tồn.")</small></span>
                    <b>@w.Count</b><i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    </section>
</div>
