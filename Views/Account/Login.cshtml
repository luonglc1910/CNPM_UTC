@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Cổng Nhân viên - Aura Hotel";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var isExpired = Context.Request.Query.ContainsKey("expired");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans"', '-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'Roboto', 'Helvetica', 'Arial', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            DEFAULT: '#0194f3', // Traveloka-like blue
                            hover: '#007ce8',
                        },
                        dark: '#1c2024',
                        gray: {
                            100: '#f7f9fa',
                            200: '#e5e9ed',
                            400: '#96a0ab',
                            500: '#687176',
                        }
                    },
                    boxShadow: {
                        'card': '0 4px 12px 0 rgba(0,0,0,0.05), 0 1px 2px 0 rgba(0,0,0,0.08)',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #f7f9fa;
        }
        .input-field {
            border: 1px solid #cdd0d1;
            transition: border-color 0.2s;
        }
        .input-field:focus {
            outline: none;
            border-color: #0194f3;
        }
    </style>
</head>
<body class="font-sans antialiased text-dark">
    <div class="min-h-screen flex flex-col items-center justify-center p-4">
        
        <div class="w-full max-w-[440px]">
            <!-- Logo -->
            <div class="text-center mb-8">
                <a href="/Portal/Index" class="inline-block">
                    <div class="text-3xl font-bold tracking-tight text-primary">AURA</div>
                    <div class="text-[11px] font-semibold text-gray-400 tracking-[0.2em] uppercase mt-1">Boutique Hotel & Resort</div>
                </a>
            </div>

            <!-- Form Card -->
            <div class="bg-white rounded-2xl shadow-card p-8">
                
                <div class="mb-6">
                    <span class="inline-block px-3 py-1 bg-gray-100 text-gray-500 rounded-full text-[11px] font-bold uppercase tracking-wider mb-4">Cổng Nhân viên</span>
                    <h1 class="text-2xl font-bold">Đăng nhập hệ thống</h1>
                    <p class="text-sm text-gray-500 mt-2">Dành riêng cho ban quản lý và nhân viên</p>
                </div>

                @if (isExpired)
                {
                    <div class="mb-5 p-3.5 bg-[#fff8e1] border border-[#ffe082] rounded-lg text-[#f57f17] text-sm flex gap-2 items-start">
                        <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                        <span>Phiên làm việc đã hết hạn. Vui lòng đăng nhập lại.</span>
                    </div>
                }

                @if (TempData["Info"] is string info)
                {
                    <div class="mb-5 p-3.5 bg-[#e1f5fe] border border-[#81d4fa] rounded-lg text-[#0277bd] text-sm flex gap-2 items-start">
                        <svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>@info</span>
                    </div>
                }

                @if (TempData["Error"] is string errMsg)
                {
                    <div class="mb-5 p-3.5 bg-[#ffebee] border border-[#ef9a9a] rounded-lg text-[#c62828] text-sm font-medium">
                        @errMsg
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-5 p-3.5 bg-[#ffebee] border border-[#ef9a9a] rounded-lg">
                        <div asp-validation-summary="All" class="text-[#c62828] text-sm"></div>
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" method="post" id="login-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <!-- Tên đăng nhập -->
                    <div class="mb-4">
                        <label asp-for="UserName" class="block text-sm font-semibold mb-2"></label>
                        <input asp-for="UserName" type="text" autocomplete="username" autofocus
                               placeholder="VD: admin_01" 
                               class="input-field w-full px-4 py-3 rounded-xl text-sm" />
                        <span asp-validation-for="UserName" class="text-[#c62828] text-xs mt-1 block"></span>
                    </div>

                    <!-- Mật khẩu -->
                    <div class="mb-5 relative">
                        <label asp-for="Password" class="block text-sm font-semibold mb-2"></label>
                        <input asp-for="Password" type="password" id="pw" autocomplete="current-password"
                               placeholder="Mật khẩu của bạn" 
                               class="input-field w-full px-4 py-3 rounded-xl text-sm pr-12" />
                        <button type="button" id="toggle-pw" tabindex="-1" class="absolute right-3 top-[34px] p-1.5 text-gray-400 hover:text-dark">
                            <svg id="eye-s" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                            <svg id="eye-h" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg>
                        </button>
                        <span asp-validation-for="Password" class="text-[#c62828] text-xs mt-1 block"></span>
                    </div>

                    <!-- Ghi nhớ -->
                    <div class="flex items-center gap-2 mb-6">
                        <input asp-for="RememberMe" type="checkbox" id="rm" class="w-4 h-4 rounded border-gray-300 text-primary focus:ring-primary cursor-pointer" />
                        <label for="rm" class="text-sm cursor-pointer select-none">Duy trì đăng nhập</label>
                    </div>

                    <button type="submit" id="btn-submit" class="w-full bg-primary hover:bg-primary-hover text-white font-semibold py-3.5 rounded-xl transition-colors text-sm flex justify-center items-center gap-2">
                        <span>Đăng nhập</span>
                    </button>
                </form>
            </div>

            <!-- Footer links -->
            <div class="mt-8 text-center text-sm text-gray-500 space-y-3">
                <p>Khách hàng đặt phòng? <a href="/ClientAuth/Login" class="text-primary font-semibold hover:underline">Vào cổng Khách hàng</a></p>
                <p><a href="/Portal/Index" class="hover:text-dark transition-colors">Về trang chủ</a></p>
            </div>

        </div>
    </div>

    <script>
    (function(){
        const pw = document.getElementById('pw');
        const eyeS = document.getElementById('eye-s');
        const eyeH = document.getElementById('eye-h');
        document.getElementById('toggle-pw')?.addEventListener('click', () => {
            const hidden = pw.type === 'password';
            pw.type = hidden ? 'text' : 'password';
            eyeS.classList.toggle('hidden', hidden);
            eyeH.classList.toggle('hidden', !hidden);
        });

        document.getElementById('login-form')?.addEventListener('submit', function() {
            const btn = document.getElementById('btn-submit');
            btn.disabled = true;
            btn.classList.add('opacity-75');
            btn.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> <span>Đang xác thực...</span>';
        });
    })();
    </script>
</body>
</html>
