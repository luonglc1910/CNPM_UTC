@inject HotelManagement.Web.Security.IScreenAccess Screens
@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var action = ViewContext.RouteData.Values["action"] as string;


    // Khai báo menu theo nhóm. Không có điều kiện quyền nào viết tay ở đây:
    // mỗi mục tự hỏi IScreenAccess, vốn đọc thẳng [Authorize] trên controller/action.
    // Thêm màn hình mới chỉ cần thêm một dòng; đổi quyền chỉ cần sửa controller.
    var menu = new (string? Section, string Label, string Icon, string Controller, string Action)[]
    {
        (null,                    "Tổng quan",            "speedometer2",       "Home",          "Index"),

        ("Danh mục & Cấu hình",   "Loại phòng",           "tags",               "RoomTypes",     "Index"),
        (null,                    "Phòng",                "door-closed",        "Rooms",         "Index"),
        (null,                    "Dịch vụ",              "cup-hot",            "HotelServices", "Index"),
        (null,                    "Tồn kho",              "box-seam",           "Inventory",     "Index"),
        (null,                    "Nhân viên",            "people",             "Employees",     "Index"),
        (null,                    "Cấu hình hệ thống",    "sliders",            "Settings",      "Index"),

        ("Đặt phòng",             "Đơn đặt phòng",        "journal-bookmark",   "Reservations",  "Index"),
        (null,                    "Tra cứu phòng trống",  "calendar-check",     "Reservations",  "Availability"),

        ("Lễ tân",                "Khách đang lưu trú",   "person-lines-fill",  "FrontDesk",     "Index"),
        (null,                    "Check-in",             "box-arrow-in-right", "FrontDesk",     "CheckIn"),
        (null,                    "Khách vãng lai",       "person-walking",     "FrontDesk",     "WalkIn"),

        ("Buồng phòng",           "Trạng thái dọn phòng", "stars",              "Housekeeping",  "Index"),
        (null,                    "Yêu cầu phục vụ",      "bell",               "Housekeeping",  "Requests"),

        ("Thu ngân & Báo cáo",    "Hóa đơn",              "receipt",            "Billing",       "Index"),
        (null,                    "Doanh thu",            "graph-up",           "Reports",       "Revenue"),
        (null,                    "Công suất phòng",      "pie-chart",          "Reports",       "Occupancy")
    };

    // Lọc trước những mục không có quyền, rồi mới quyết định tiêu đề nhóm nào còn mục để hiện.
    var visible = new List<(string? Section, string Label, string Icon, string Controller, string Action)>();
    string? currentSection = null;

    foreach (var item in menu)
    {
        if (item.Section is not null)
        {
            currentSection = item.Section;
        }

        if (await Screens.CanAccessAsync(item.Controller, item.Action))
        {
            visible.Add((currentSection, item.Label, item.Icon, item.Controller, item.Action));
        }
    }

    // Controller chỉ có một mục trong menu thì mục đó sáng ở mọi trang con của controller
    // (đang ở /Rooms/Create thì "Phòng" vẫn sáng). Controller có nhiều mục thì phải khớp
    // cả action, nếu không ba mục của Lễ tân sẽ cùng sáng một lúc.
    var singleEntryControllers = visible
        .GroupBy(x => x.Controller, StringComparer.OrdinalIgnoreCase)
        .Where(g => g.Count() == 1)
        .Select(g => g.Key)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    string Active(string c, string a) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase)
        && (singleEntryControllers.Contains(c)
            || string.Equals(action, a, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";
}

<nav class="sidebar-nav">
    @{
        string? renderedSection = null;
    }
    @foreach (var item in visible)
    {
        @* Tiêu đề nhóm chỉ hiện khi nhóm đó thực sự còn mục nào đi qua được bộ lọc quyền. *@
        if (item.Section != renderedSection)
        {
            renderedSection = item.Section;
            if (item.Section is not null)
            {
                <div class="nav-section">@item.Section</div>
            }
        }

        <a class="nav-link @Active(item.Controller, item.Action)"
           asp-controller="@item.Controller" asp-action="@item.Action">
            <i class="bi bi-@item.Icon"></i> @item.Label
        </a>
    }
</nav>
