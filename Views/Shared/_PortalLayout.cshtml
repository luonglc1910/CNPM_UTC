@using Microsoft.AspNetCore.Authentication
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="web_standard" name="shell-type">
    <title>Aura Boutique Hotel &amp; Resort</title>
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancyapps-ui/5.0.36/fancybox/fancybox.min.css"/>
    <style>@@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">tailwind.config={"darkMode":"class","theme":{"extend":{"colors":{"on-error":"#ffffff","outline":"#727976","outline-variant":"#c1c8c5","on-primary-fixed":"#02201b","surface-container-low":"#eaf6f3","surface-dim":"#d0ddd9","surface-container-high":"#deebe7","on-secondary":"#ffffff","inverse-primary":"#aecdc5","tertiary-fixed":"#a4f4c5","secondary":"#765a21","on-secondary-fixed-variant":"#5c430a","tertiary-fixed-dim":"#88d7aa","surface-variant":"#d9e5e2","on-tertiary-fixed":"#002112","error":"#ba1a1a","primary-fixed-dim":"#aecdc5","primary-container":"#14312c","secondary-fixed-dim":"#e6c17e","on-error-container":"#93000a","tertiary":"#001d0f","surface-container":"#e4f1ed","on-tertiary-fixed-variant":"#005233","tertiary-container":"#00341f","on-primary-container":"#7b9a93","background":"#f0fcf8","primary-fixed":"#c9e9e1","on-secondary-container":"#785c24","error-container":"#ffdad6","on-tertiary":"#ffffff","on-tertiary-container":"#56a37a","on-secondary-fixed":"#271900","on-background":"#131e1c","surface-bright":"#f0fcf8","secondary-fixed":"#ffdea5","surface":"#f0fcf8","inverse-surface":"#273330","on-surface":"#131e1c","on-surface-variant":"#414846","surface-tint":"#47645e","surface-container-highest":"#d9e5e2","on-primary":"#ffffff","primary":"#001c18","secondary-container":"#fed892","inverse-on-surface":"#e7f3f0","surface-container-lowest":"#ffffff","on-primary-fixed-variant":"#304c46"},"borderRadius":{"DEFAULT":"0.125rem","lg":"0.25rem","xl":"0.5rem","full":"0.75rem"},"spacing":{"gutter":"1.5rem","margin-sm":"1rem","space-xs":"0.25rem","gutter-lg":"2rem","gutter-sm":"1rem","space-lg":"1.5rem","space-xl":"2.5rem","margin-lg":"3rem","space-sm":"0.5rem","space-md":"1rem","margin":"2rem"},"fontFamily":{"headline-md":["Be Vietnam Pro"],"headline-sm":["Be Vietnam Pro"],"label-lg":["Be Vietnam Pro"],"body-lg":["Be Vietnam Pro"],"body-md":["Be Vietnam Pro"],"body-sm":["Be Vietnam Pro"],"display-lg-mobile":["Be Vietnam Pro"],"label-md":["Be Vietnam Pro"],"display-lg":["Be Vietnam Pro"],"headline-lg":["Be Vietnam Pro"],"label-sm":["Be Vietnam Pro"],"numeric-table":["Be Vietnam Pro"]},"fontSize":{"headline-md":["22px",{"lineHeight":"30px","letterSpacing":"-0.01em","fontWeight":"500"}],"headline-sm":["18px",{"lineHeight":"26px","letterSpacing":"-0.005em","fontWeight":"600"}],"label-lg":["14px",{"lineHeight":"20px","letterSpacing":"0.01em","fontWeight":"500"}],"body-lg":["16px",{"lineHeight":"26px","fontWeight":"400"}],"body-md":["14px",{"lineHeight":"22px","fontWeight":"400"}],"body-sm":["13px",{"lineHeight":"18px","fontWeight":"400"}],"display-lg-mobile":["32px",{"lineHeight":"40px","letterSpacing":"-0.01em","fontWeight":"600"}],"label-md":["12px",{"lineHeight":"16px","letterSpacing":"0.02em","fontWeight":"500"}],"display-lg":["44px",{"lineHeight":"52px","letterSpacing":"-0.02em","fontWeight":"600"}],"headline-lg":["28px",{"lineHeight":"36px","letterSpacing":"-0.015em","fontWeight":"600"}],"label-sm":["11px",{"lineHeight":"14px","letterSpacing":"0.04em","fontWeight":"600"}],"numeric-table":["13px",{"lineHeight":"18px","letterSpacing":"-0.01em","fontWeight":"500"}]}}}};</script>
    @RenderSection("Styles", required: false)
</head>
<body class="bg-surface font-body-md text-on-surface antialiased selection:bg-secondary-container selection:text-on-secondary-container">
    <header class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-md shadow-[0_1px_8px_rgba(20,49,44,0.05)] transition-all duration-300">
        <div class="h-20 max-w-[1280px] mx-auto px-margin-sm md:px-margin flex items-center justify-between gap-space-md">
            <div class="flex items-center gap-space-lg">
                <a class="flex items-center" data-path="trang-chu" href="/Portal/Index">
                    <img src="~/images/logo.png" alt="AURA Logo" class="h-[76px] w-auto object-contain scale-125 origin-left" />
                </a>
            </div>
            <nav class="hidden xl:flex items-center gap-space-lg" data-active-classes="text-primary font-semibold relative after:absolute after:bottom-[-4px] after:left-0 after:right-0 after:h-[2px] after:bg-secondary">
                <a class="font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface transition-colors py-1" data-path="trang-chu" href="/Portal/Index">Trang chủ</a>
                <a class="font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface transition-colors py-1" data-path="uu-dai" href="/Portal/Offers">Ưu đãi</a>
                <a class="font-label-lg text-label-lg text-on-surface-variant hover:text-on-surface transition-colors py-1" data-path="lien-he" href="/Portal/Contact">Liên hệ</a>
            </nav>
            <div class="flex items-center gap-space-md">
                <a class="hidden lg:flex items-center gap-1.5 text-on-surface-variant hover:text-primary transition-colors pr-2" href="tel:0332112302">
                    <i class="fa-solid fa-phone text-[20px] text-secondary"></i>
                    <span class="font-label-sm text-label-sm tracking-wide font-medium">033 2112 302</span>
                </a>
@{
    var clientAuth = await Context.AuthenticateAsync(HotelManagement.Web.Security.AppSchemes.Client);
    var staffAuth = await Context.AuthenticateAsync(HotelManagement.Web.Security.AppSchemes.Staff);
    bool isStaff = staffAuth.Succeeded;
    bool isClient = clientAuth.Succeeded;
    bool isLogged = isStaff || isClient;
    string name = isStaff ? (staffAuth.Principal?.Identity?.Name ?? "Nhân viên") : (isClient ? (clientAuth.Principal?.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "Khách") : "");
}
@if(!isLogged) {
    <a href="/ClientAuth/Login" class="h-8 pl-3 pr-4 rounded-full bg-primary flex items-center justify-center gap-1.5 flex-shrink-0 ml-1 hover:opacity-80 transition-opacity">
        <i class="fa-solid fa-user text-on-primary text-[18px]"></i>
        <span class="font-label-md text-on-primary font-medium tracking-wide">Đăng nhập</span>
    </a>
} else {
    <div class="relative group ml-1">
        <button class="h-8 pl-3.5 pr-1.5 rounded-full bg-primary flex items-center justify-center gap-1 flex-shrink-0 hover:opacity-80 transition-opacity focus:outline-none">
            <span class="font-label-md text-on-primary font-medium max-w-[120px] truncate">@name</span>
            <i class="fa-solid fa-caret-down text-on-primary text-[18px]"></i>
        </button>
        <div class="absolute right-0 top-full mt-2 w-48 bg-surface rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] border border-surface-variant opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 py-2">
            <div class="px-4 py-2 border-b border-surface-variant mb-2">
                <p class="text-[11px] text-on-surface-variant uppercase tracking-wider">Xin chào,</p>
                <p class="text-sm font-semibold text-on-surface truncate">@name</p>
            </div>
            
            @if(isClient) {
                <a href="/Profile/Index" class="block px-4 py-2 text-sm text-on-surface hover:bg-surface-container-high transition-colors">Quản lý hồ sơ</a>
            }

            @if(isStaff) {
                <a href="/Home/Index" class="block px-4 py-2 text-sm text-on-surface hover:bg-surface-container-high transition-colors">Vào trang Quản trị</a>
            }
            <form action="/ClientAuth/Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full text-left px-4 py-2 text-sm text-error hover:bg-error/10 transition-colors">Đăng xuất</button>
            </form>
        </div>
    </div>
}
            </div>
        </div>
    </header>
    <main class="w-full pt-20 bg-surface">
        @RenderBody()
    </main>
    <footer class="w-full bg-primary-container text-surface-variant relative overflow-hidden">
        <div class="max-w-[1280px] mx-auto px-margin-sm md:px-margin pt-space-xl pb-space-lg">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-gutter-lg pb-space-xl">
                <div class="lg:col-span-4 flex flex-col gap-space-md">
                    <div class="flex">
                        <img src="~/images/logo.png" alt="AURA Logo" class="h-[80px] w-auto object-contain brightness-0 invert opacity-90 scale-110 origin-left" />
                    </div>
                    <p class="font-body-sm text-body-sm text-on-primary-container max-w-sm leading-relaxed">Không gian nghỉ dưỡng kiến trúc tĩnh tại, giao hòa tinh hoa văn hóa bản địa cùng chuẩn mực khách sạn 5 sao cao cấp.</p>
                    <div class="flex flex-col gap-space-sm mt-space-xs">
                        <div class="flex items-start gap-2.5 text-on-primary-container">
                            <i class="fa-solid fa-location-dot text-[18px] text-secondary-fixed mt-0.5"></i>
                            <span class="font-body-sm text-body-sm"><strong class="text-surface-container-lowest font-medium">Hà Nội:</strong> 22 Phố Nhà Thờ, Hoàn Kiếm</span>
                        </div>
                        <div class="flex items-start gap-2.5 text-on-primary-container">
                            <i class="fa-solid fa-location-dot text-[18px] text-secondary-fixed mt-0.5"></i>
                            <span class="font-body-sm text-body-sm"><strong class="text-surface-container-lowest font-medium">Đà Nẵng:</strong> 108 Võ Nguyên Giáp, Sơn Trà</span>
                        </div>
                        <div class="flex items-center gap-2.5 text-on-primary-container">
                            <i class="fa-solid fa-envelope text-[18px] text-secondary-fixed"></i>
                            <span class="font-body-sm text-body-sm">concierge@auraboutique.com</span>
                        </div>
                    </div>
                </div>
                <div class="lg:col-span-2 flex flex-col gap-space-sm">
                    <span class="font-label-lg text-label-lg font-semibold tracking-wider uppercase text-secondary-fixed mb-1">Khám phá</span>
                    <a class="font-body-sm text-body-sm text-on-primary-container hover:text-surface-container-lowest transition-colors" data-path="phong-nghi" href="#">Hạng phòng &amp; Suites</a>
                    <a class="font-body-sm text-body-sm text-on-primary-container hover:text-surface-container-lowest transition-colors" data-path="tien-nghi" href="#">Spa &amp; Trị liệu</a>
                    <a class="font-body-sm text-body-sm text-on-primary-container hover:text-surface-container-lowest transition-colors" data-path="tien-nghi" href="#">Ẩm thực Aura Fine Dining</a>
                    <a class="font-body-sm text-body-sm text-on-primary-container hover:text-surface-container-lowest transition-colors" data-path="dich-vu" href="#">Hội nghị &amp; Yến tiệc</a>
                    <a class="font-body-sm text-body-sm text-on-primary-container hover:text-surface-container-lowest transition-colors" data-path="uu-dai" href="/Portal/Offers">Gói nghỉ dưỡng độc quyền</a>
                </div>
                <div class="lg:col-span-2 flex flex-col gap-space-sm">
                    <span class="font-label-lg text-label-lg font-semibold tracking-wider uppercase text-secondary-fixed mb-1">Thông tin</span>
                    <a class="font-body-sm text-body-sm text-on-primary-container hover:text-surface-container-lowest transition-colors" data-path="cau-chuyen-aura" href="#">Câu chuyện Aura</a>
                    <a class="font-body-sm text-body-sm text-on-primary-container hover:text-surface-container-lowest transition-colors" data-path="chinh-sach-dat-phong" href="#">Chính sách đặt phòng</a>
                    <a class="font-body-sm text-body-sm text-on-primary-container hover:text-surface-container-lowest transition-colors" data-path="dieu-khoan-va-bao-mat" href="#">Quy định &amp; Bảo mật</a>
                    <a class="font-body-sm text-body-sm text-on-primary-container hover:text-surface-container-lowest transition-colors" data-path="lien-he" href="#">Hỗ trợ &amp; Trợ giúp</a>
                    <a class="font-body-sm text-body-sm text-on-primary-container hover:text-surface-container-lowest transition-colors" data-path="tuyen-dung" href="#">Cơ hội nghề nghiệp</a>
                </div>
                <div class="lg:col-span-4 flex flex-col gap-space-md">
                    <span class="font-label-lg text-label-lg font-semibold tracking-wider uppercase text-secondary-fixed">Bản tin Aura Privilege</span>
                    <p class="font-body-sm text-body-sm text-on-primary-container">Đăng ký nhận thông tin ưu đãi theo mùa và đặc quyền hội viên dành riêng cho khách hàng thân thiết.</p>
                    <form class="flex flex-col sm:flex-row gap-2 mt-1">
                        <input class="flex-1 px-3 py-2 bg-surface-container-lowest/10 rounded-lg text-surface-container-lowest placeholder:text-on-primary-container/70 font-body-sm text-body-sm focus:outline-none focus:ring-1 focus:ring-secondary-fixed transition-all" placeholder="Địa chỉ email của quý khách..." type="email">
                        <button class="px-space-md py-2 bg-secondary text-on-secondary rounded-lg font-label-md text-label-md hover:bg-secondary-container hover:text-on-secondary-container transition-colors font-medium whitespace-nowrap" type="button">Đăng ký</button>
                    </form>
                    <div class="flex items-center gap-space-md pt-space-xs text-secondary-fixed"></div>
                </div>
            </div>
            <div class="pt-space-lg flex flex-col sm:flex-row items-center justify-between gap-space-sm text-on-primary-container font-label-sm text-label-sm">
                <p class="">© 2025 Aura Boutique Hotel &amp; Resort. Bản quyền thuộc về Aura Hospitality Group.</p>
                <div class="flex items-center gap-space-lg">
                    <a class="hover:text-surface-container-lowest transition-colors" data-path="dieu-khoan-va-bao-mat" href="#">Điều khoản sử dụng</a>
                    <a class="hover:text-surface-container-lowest transition-colors" data-path="chinh-sach-dat-phong" href="#">Bảo mật thông tin</a>
                    <a class="hover:text-surface-container-lowest transition-colors" data-path="so-do-trang" href="#">Sơ đồ trang</a>
                </div>
            </div>
        </div>
    </footer>
    <partial name="_Notification" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fancyapps-ui/5.0.36/fancybox/fancybox.umd.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            if (typeof Fancybox !== "undefined") {
                Fancybox.bind("[data-fancybox]", {
                    // Custom options for Fancybox if needed
                });
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>