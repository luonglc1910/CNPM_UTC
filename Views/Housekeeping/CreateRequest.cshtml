@model CreateRequestViewModel
@{
    ViewData["Title"] = "Tạo yêu cầu (báo hỏng / phục vụ)";
}

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form method="post" asp-action="CreateRequest">
                    <div class="mb-3">
                        <label asp-for="Type" class="form-label">Loại yêu cầu <span class="text-danger">*</span></label>
                        <select asp-for="Type" class="form-select">
                            @foreach (var t in Enum.GetValues<RequestType>())
                            {
                                <option value="@((int)t)" selected="@(Model.Type == t)">@t.ToDisplayName()</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RoomId" class="form-label">Phòng <span class="text-danger">*</span></label>
                        <select asp-for="RoomId" asp-items="Model.RoomOptions" class="form-select">
                            <option value="">— Chọn phòng —</option>
                        </select>
                        <span asp-validation-for="RoomId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Mô tả <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả sự cố / yêu cầu (ít nhất 10 ký tự)"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Priority" class="form-label">Mức độ <span class="text-danger">*</span></label>
                        <select asp-for="Priority" class="form-select">
                            @foreach (var p in Enum.GetValues<RequestPriority>())
                            {
                                <option value="@((int)p)" selected="@(Model.Priority == p)">@p.ToDisplayName()</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AssignedTo" class="form-label">Người xử lý</label>
                        <select asp-for="AssignedTo" asp-items="Model.EmployeeOptions" class="form-select">
                            <option value="">— Chưa phân công —</option>
                        </select>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="MakeRoomMaintenance" class="form-check-input" />
                        <label asp-for="MakeRoomMaintenance" class="form-check-label">
                            Chuyển phòng sang Bảo trì (chỉ áp dụng với báo hỏng, phòng không có khách)
                        </label>
                    </div>

                    <div class="alert alert-secondary small">
                        <i class="bi bi-info-circle"></i>
                        Báo hỏng cho phòng trống sẽ ngừng bán phòng ngay. Phòng đang có khách thì không đổi
                        trạng thái — hệ thống nhắc cân nhắc đổi phòng (SCR-D06).
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Tạo yêu cầu</button>
                        <a class="btn btn-outline-secondary" asp-action="Requests">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
