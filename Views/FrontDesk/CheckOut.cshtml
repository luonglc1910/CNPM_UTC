@model CheckOutViewModel
@{
    ViewData["Title"] = $"Check-out — Phòng {Model.RoomNumber}";
    var s = Model.Summary;
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header">Điều kiện check-out (BR-08)</div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Đã kiểm phòng &amp; minibar
                    @if (Model.IsInspected)
                    {
                        <span class="badge text-bg-success">Đã kiểm</span>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-warning" asp-controller="Billing" asp-action="Minibar" asp-route-stayId="@Model.StayId">Kiểm phòng ngay</a>
                    }
                </li>
            </ul>
        </div>

        <form method="post" asp-action="CheckOut">
            <input type="hidden" asp-for="StayId" />
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Chốt giờ trả &amp; phụ thu (BR-01, BR-03, BR-13)</span>
                    <span class="badge @Model.RentalType.BadgeClass()">
                        <i class="bi bi-@Model.RentalType.IconName()"></i> @Model.RentalType.DisplayName()
                    </span>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">
                            @if (Model.RentalType == RentalType.Hourly)
                            {
                                @* Thuê theo giờ không có giờ trả dự kiến — giờ nhập ở ô dưới chính là giờ chốt tiền. *@
                                @:Nhận lúc @Model.ActualCheckIn.ToString("HH:mm dd/MM") · giờ trả quyết định số tiền
                            }
                            else if (Model.RentalType == RentalType.Overnight)
                            {
                                @:Gói qua đêm kết thúc @Model.ExpectedCheckOut.ToString("HH:mm dd/MM")
                            }
                            else
                            {
                                @:Giờ trả phòng chuẩn: 12:00 · dự kiến @Model.ExpectedCheckOut.ToString("dd/MM/yyyy")
                            }
                        </label>
                        <input asp-for="ActualCheckOut" type="datetime-local" class="form-control" />
                    </div>

                    @*
                        Thuê theo giờ là hình thức duy nhất mà tiền phòng đổi theo giờ bấm nút, nên
                        phải nói rõ ngay tại đây sẽ tính mấy giờ và vì sao — khách hỏi thì lễ tân
                        đọc thẳng câu này, không phải tự nhẩm lại quy tắc làm tròn.
                    *@
                    @if (Model.RentalType == RentalType.Hourly)
                    {
                        <div class="alert alert-info py-2 small mb-2">
                            <div class="fw-semibold">
                                Tính @Model.BilledHours giờ — tiền phòng @Model.RecalculatedRoomCharge.ToString("N0") ₫
                            </div>
                            @if (Model.HourRoundingNote is not null)
                            {
                                <div>@Model.HourRoundingNote</div>
                            }
                            <div class="text-muted">Đổi giờ trả ở trên rồi bấm tiếp tục, hệ thống tính lại theo giờ vừa nhập.</div>
                        </div>
                    }

                    @if (Model.LateSurchargeAmount > 0 || Model.ExtraNightsFromLate > 0)
                    {
                        <div class="alert alert-warning py-2 small mb-2">
                            @Model.LateSurchargeDescription — dự kiến @Model.LateSurchargeAmount.ToString("N0") ₫
                            @(Model.ExtraNightsFromLate > 0 ? "(tính thêm 1 đêm)" : "")
                        </div>
                    }

                    @if (Model.RentalType == RentalType.Daily)
                    {
                        <div class="form-text mb-2">
                            Trả sớm hơn ngày đã đặt vẫn tính đủ @Model.PlannedNights đêm (BR-13).
                        </div>
                    }

                    @if (Model.IsAdmin)
                    {
                        <div class="form-check">
                            <input asp-for="WaiveLateSurcharge" class="form-check-input" />
                            <label asp-for="WaiveLateSurcharge" class="form-check-label">
                                @(Model.RentalType == RentalType.Overnight ? "Miễn phụ thu quá gói" : "Miễn phụ thu trễ giờ")
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" disabled="@(!Model.CanProceed)">
                    <i class="bi bi-arrow-right-circle"></i> Tiếp tục thanh toán
                </button>
                <a class="btn btn-outline-secondary" asp-action="Stay" asp-route-id="@Model.StayId">Quay lại</a>
            </div>
            @if (!Model.CanProceed)
            {
                <div class="form-text text-danger mt-1">Chưa kiểm phòng nên chưa thanh toán được.</div>
            }
        </form>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">Tạm tính hiện tại</div>
            <div class="card-body">
                <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td>Tiền phòng</td><td class="text-end">@s.RoomCharge.ToString("N0") ₫</td></tr>
                        <tr><td>Dịch vụ</td><td class="text-end">@s.ServiceCharge.ToString("N0") ₫</td></tr>
                        <tr>
                            <td>
                                Phụ thu
                                @if (s.SurchargeLines.Count > 0)
                                {
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 text-muted"
                                            data-bs-toggle="collapse" data-bs-target="#surchargeDetail"
                                            aria-expanded="false">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                }
                            </td>
                            <td class="text-end">@s.SurchargeAmount.ToString("N0") ₫</td>
                        </tr>
                        @if (s.SurchargeLines.Count > 0)
                        {
                            <tr>
                                <td colspan="2" class="p-0">
                                    <div class="collapse show" id="surchargeDetail">
                                        <table class="table table-sm mb-0 table-borderless">
                                            <tbody>
                                                @foreach (var line in s.SurchargeLines)
                                                {
                                                    <tr class="text-muted small">
                                                        <td class="ps-3">
                                                            <i class="bi bi-arrow-return-right me-1"></i>@line.Description
                                                            @if (line.IsPending)
                                                            {
                                                                <span class="badge text-bg-warning ms-1" title="Chưa ghi vào folio, sẽ áp dụng khi bấm Tiếp tục thanh toán">Dự kiến</span>
                                                            }
                                                        </td>
                                                        <td class="text-end">@line.Amount.ToString("N0") ₫</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }

                        <tr><td>Giảm giá</td><td class="text-end">-@s.DiscountAmount.ToString("N0") ₫</td></tr>
                        <tr><td>VAT</td><td class="text-end">@s.TaxAmount.ToString("N0") ₫</td></tr>
                        <tr class="fw-semibold"><td>Tổng</td><td class="text-end">@s.Total.ToString("N0") ₫</td></tr>
                        <tr class="table-light fw-semibold"><td>Số dư phải thu</td><td class="text-end">@s.BalanceDue.ToString("N0") ₫</td></tr>
                    </tbody>
                </table>
                </div>


            </div>
        </div>
    </div>
</div>
