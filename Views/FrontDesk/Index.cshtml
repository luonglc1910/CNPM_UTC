@model FrontDeskDashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển lễ tân";
}

<style>
    .panel-badge-active {
        outline: 3px solid #fff;
        outline-offset: 2px;
        transform: scale(1.18);
        box-shadow: 0 2px 8px rgba(0,0,0,.35);
        position: relative;
        z-index: 1;
    }
    #badge-bar .badge {
        min-width: 100px;
        text-align: center;
        padding: .45em .6em;
        transition: transform .15s, box-shadow .15s;
        font-size: .85rem;
    }
</style>

@* Badge hàng trên — bấm để đổi view *@
<div class="d-flex flex-wrap gap-3 mb-3" id="badge-bar">
    @*
        Việc cần làm ngay đứng trước các con số trạng thái: khách đã tới quầy mà lễ tân phải đi
        tìm đơn ở màn khác mới check-in được thì bảng điều khiển không làm đúng việc của nó.
    *@
    <span class="badge @(Model.Arrivals.Count > 0 ? "text-bg-danger" : "text-bg-light text-dark")"
          style="cursor:pointer"
          data-panel="pending"
          onclick="showPanel('pending')"
          title="Đơn đã xác nhận, đến hôm nay, chưa check-in">
        Chờ check-in: @Model.Arrivals.Count
    </span>
    <span class="badge text-bg-success"
          style="cursor:pointer"
          data-panel="available"
          onclick="showPanel('available')"
          title="Phòng trống">
        Trống: @Model.AvailableCount
    </span>
    <span class="badge text-bg-warning fw-semibold"
          style="cursor:pointer"
          data-panel="inhouse"
          onclick="showPanel('inhouse')"
          title="Đang có khách">
        Đang ở: @Model.OccupiedCount
    </span>
    <span class="badge text-bg-secondary"
          style="cursor:pointer"
          data-panel="dirty"
          onclick="showPanel('dirty')"
          title="Chờ dọn phòng">
        Chờ dọn: @Model.DirtyCount
    </span>
    <span class="badge text-bg-danger"
          style="cursor:pointer"
          data-panel="maintenance"
          onclick="showPanel('maintenance')"
          title="Bảo trì">
        Bảo trì: @Model.MaintenanceCount
    </span>
    <span class="badge text-bg-primary"
          style="cursor:pointer"
          data-panel="arrivals"
          onclick="showPanel('arrivals')"
          title="Đã check-in hôm nay">
        Đến: @Model.CheckedInToday.Count
    </span>
    <span class="badge text-bg-info"
          style="cursor:pointer"
          data-panel="departures"
          onclick="showPanel('departures')"
          title="Đã check-out hôm nay">
        Đi: @Model.CheckedOutToday.Count
    </span>
</div>

@* Panel: Chờ check-in — đơn đến hôm nay chưa nhận phòng *@
<div id="panel-pending" class="panel-section d-none">
    <div class="card">
        <div class="card-header fw-semibold">Chờ check-in (@Model.Arrivals.Count đơn)</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Mã đơn</th><th>Khách</th><th>Điện thoại</th><th>Loại phòng</th><th class="text-center">Khách</th><th class="text-end">Thao tác</th></tr>
                </thead>
                <tbody>
                @foreach (var a in Model.Arrivals)
                {
                    <tr>
                        <td><code>@a.Code</code></td>
                        <td>@a.GuestName</td>
                        <td>@a.PhoneNumber</td>
                        <td>@a.RoomTypeSummary</td>
                        <td class="text-center">@a.Guests</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Reservations" asp-action="Details" asp-route-id="@a.ReservationId">Chi tiết</a>
                            <a class="btn btn-sm btn-primary" asp-action="CheckIn" asp-route-reservationId="@a.ReservationId">
                                <i class="bi bi-box-arrow-in-right"></i> Check-in
                            </a>
                        </td>
                    </tr>
                }
                @if (Model.Arrivals.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Không còn đơn nào chờ nhận phòng.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Panel: Đang ở (mặc định) *@
<div id="panel-inhouse" class="panel-section">
    <div class="card">
        <div class="card-header fw-semibold">Đang lưu trú</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Phòng</th><th>Khách</th><th>Vào</th><th>Đi dự kiến</th><th class="text-end">Thao tác</th></tr>
                </thead>
                <tbody>
                @foreach (var h in Model.InHouse)
                {
                    <tr>
                        <td><strong>@h.RoomNumber</strong></td>
                        <td>@h.GuestName</td>
                        <td>@h.ActualCheckIn.ToString("dd/MM HH:mm")</td>
                        <td>@h.ExpectedCheckOut.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Stay" asp-route-id="@h.StayId">Chi tiết</a>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Billing" asp-action="AddCharge" asp-route-stayId="@h.StayId">Ghi dịch vụ</a>
                        </td>
                    </tr>
                }
                @if (Model.InHouse.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có khách lưu trú.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Panel: Đến hôm nay — đã check-in *@
<div id="panel-arrivals" class="panel-section d-none">
    <div class="card">
        <div class="card-header fw-semibold">Đã check-in hôm nay (@Model.CheckedInToday.Count lượt)</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Phòng</th><th>Khách</th><th>Giờ vào</th><th>Trả dự kiến</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var a in Model.CheckedInToday)
                {
                    <tr>
                        <td><strong>@a.RoomNumber</strong></td>
                        <td>@a.GuestName</td>
                        <td>@a.ActualCheckIn.ToString("HH:mm")</td>
                        <td>@a.ExpectedCheckOut.ToString("dd/MM/yyyy")</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Stay" asp-route-id="@a.StayId">Chi tiết</a></td>
                    </tr>
                }
                @if (Model.CheckedInToday.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có lượt check-in nào hôm nay.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Panel: Đi hôm nay — đã check-out *@
<div id="panel-departures" class="panel-section d-none">
    <div class="card">
        <div class="card-header fw-semibold">Đã check-out hôm nay (@Model.CheckedOutToday.Count lượt)</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Phòng</th><th>Khách</th><th>Vào</th><th>Giờ ra</th><th class="text-center">Đêm</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var d in Model.CheckedOutToday)
                {
                    <tr>
                        <td><strong>@d.RoomNumber</strong></td>
                        <td>@d.GuestName</td>
                        <td>@d.ActualCheckIn.ToString("dd/MM")</td>
                        <td>@d.ActualCheckOut.ToString("HH:mm")</td>
                        <td class="text-center">@d.Nights</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Stay" asp-route-id="@d.StayId">Chi tiết</a></td>
                    </tr>
                }
                @if (Model.CheckedOutToday.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có lượt check-out nào hôm nay.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Panel placeholder cho Trống / Chờ dọn / Bảo trì (chỉ thông báo, dữ liệu ở sơ đồ phòng) *@
<div id="panel-available" class="panel-section d-none">
    <div class="alert alert-success d-flex align-items-center gap-2 mb-0">
        <i class="bi bi-door-open fs-5"></i>
        <span><strong>@Model.AvailableCount phòng trống</strong> — xem chi tiết tại <a asp-action="RoomChart" asp-controller="Reservations">Tình trạng phòng</a>.</span>
    </div>
</div>
<div id="panel-dirty" class="panel-section d-none">
    <div class="alert alert-secondary d-flex align-items-center gap-2 mb-0">
        <i class="bi bi-stars fs-5"></i>
        <span><strong>@Model.DirtyCount phòng chờ dọn</strong> — xem tại <a asp-controller="Housekeeping" asp-action="Index">Trạng thái dọn phòng</a>.</span>
    </div>
</div>
<div id="panel-maintenance" class="panel-section d-none">
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-0">
        <i class="bi bi-tools fs-5"></i>
        <span><strong>@Model.MaintenanceCount phòng bảo trì</strong> — xem tại <a asp-controller="Rooms" asp-action="Index">Quản lý phòng</a>.</span>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var panels = document.querySelectorAll('.panel-section');
    var badges = document.querySelectorAll('#badge-bar .badge');

    function showPanel(id) {
        // Ẩn hết panel
        panels.forEach(function (p) { p.classList.add('d-none'); });
        var el = document.getElementById('panel-' + id);
        if (el) el.classList.remove('d-none');

        // Reset tất cả badge
        badges.forEach(function (b) { b.classList.remove('panel-badge-active'); });
        // Đánh dấu badge đang active
        var active = document.querySelector('#badge-bar .badge[data-panel="' + id + '"]');
        if (active) active.classList.add('panel-badge-active');
    }

    window.showPanel = showPanel;

    // Đọc ?panel= từ URL. Không chỉ định thì mở thẳng việc đang chờ: còn đơn chưa nhận phòng
    // thì đó mới là thứ lễ tân cần thấy đầu tiên, hết việc rồi mới xem danh sách đang ở.
    var params = new URLSearchParams(window.location.search);
    var pendingCount = @Model.Arrivals.Count;
    var initial = params.get('panel') || (pendingCount > 0 ? 'pending' : 'inhouse');
    showPanel(initial);
})();
</script>
}
