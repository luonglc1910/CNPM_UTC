@model FrontDeskDashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển lễ tân";
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <span class="badge text-bg-success">Trống: @Model.AvailableCount</span>
    <span class="badge text-bg-warning">Đang ở: @Model.OccupiedCount</span>
    <span class="badge text-bg-secondary">Chờ dọn: @Model.DirtyCount</span>
    <span class="badge text-bg-danger">Bảo trì: @Model.MaintenanceCount</span>
    <span class="badge text-bg-primary">Đến: @Model.Arrivals.Count</span>
    <span class="badge text-bg-info">Đi: @Model.Departures.Count</span>
</div>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-arr" type="button">Đến hôm nay (@Model.Arrivals.Count)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-dep" type="button">Đi hôm nay (@Model.Departures.Count)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-inh" type="button">Đang lưu trú (@Model.InHouse.Count)</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-arr">
        <div class="card"><div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Mã đơn</th><th>Khách</th><th>Loại phòng</th><th class="text-center">Khách</th><th class="text-end">Đã cọc</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var a in Model.Arrivals)
                {
                    <tr>
                        <td><code>@a.Code</code></td>
                        <td>@a.GuestName<br /><span class="text-muted small">@a.PhoneNumber</span></td>
                        <td>@a.RoomTypeSummary</td>
                        <td class="text-center">@a.Guests</td>
                        <td class="text-end">@a.DepositPaid.ToString("N0") ₫</td>
                        <td class="text-end"><a class="btn btn-sm btn-primary" asp-action="CheckIn" asp-route-reservationId="@a.ReservationId"><i class="bi bi-box-arrow-in-right"></i> Check-in</a></td>
                    </tr>
                }
                @if (Model.Arrivals.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Không có khách dự kiến đến.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>

    <div class="tab-pane fade" id="tab-dep">
        <div class="card"><div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Phòng</th><th>Khách</th><th>Giờ trả dự kiến</th><th class="text-end">Số dư</th><th class="text-center">Kiểm phòng</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var d in Model.Departures)
                {
                    <tr class="@(d.OverdueNoon ? "table-warning" : "")">
                        <td><strong>@d.RoomNumber</strong></td>
                        <td>@d.GuestName</td>
                        <td>@d.ExpectedCheckOut.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">@d.BalanceDue.ToString("N0") ₫</td>
                        <td class="text-center">@(d.IsInspected ? Html.Raw("<i class='bi bi-check-circle text-success'></i>") : Html.Raw("<i class='bi bi-x-circle text-danger'></i>"))</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Stay" asp-route-id="@d.StayId">Chi tiết</a>
                            <a class="btn btn-sm btn-primary" asp-action="CheckOut" asp-route-stayId="@d.StayId"><i class="bi bi-box-arrow-left"></i> Check-out</a>
                        </td>
                    </tr>
                }
                @if (Model.Departures.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Không có khách dự kiến đi.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>

    <div class="tab-pane fade" id="tab-inh">
        <div class="card"><div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Phòng</th><th>Khách</th><th>Vào</th><th>Đi dự kiến</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var h in Model.InHouse)
                {
                    <tr>
                        <td><strong>@h.RoomNumber</strong></td>
                        <td>@h.GuestName</td>
                        <td>@h.ActualCheckIn.ToString("dd/MM HH:mm")</td>
                        <td>@h.ExpectedCheckOut.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Stay" asp-route-id="@h.StayId">Chi tiết</a>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Billing" asp-action="AddCharge" asp-route-stayId="@h.StayId">Ghi dịch vụ</a>
                        </td>
                    </tr>
                }
                @if (Model.InHouse.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có khách lưu trú.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>

</div>
