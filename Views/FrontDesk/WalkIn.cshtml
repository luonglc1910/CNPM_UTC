@model WalkInViewModel
@{
    ViewData["Title"] = "Check-in khách vãng lai";
}

<form method="post" asp-action="WalkIn">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Khách</div>
                <div class="card-body">
                    <div class="mb-2">
                        <label asp-for="ExistingGuestId" class="form-label">Khách cũ (nếu có)</label>
                        <select asp-for="ExistingGuestId" asp-items="Model.GuestOptions" class="form-select"
                                id="walkInGuestSelect" data-blacklisted="@System.Text.Json.JsonSerializer.Serialize(Model.BlacklistedGuestIds)">
                            <option value="">— Khách mới, nhập bên dưới —</option>
                        </select>
                    </div>

                    @* SCR-B05: khách trong danh sách hạn chế phải được cảnh báo ở cả SCR-D03.
                       Cảnh báo không chặn nút Check-in — quyết định nhận hay từ chối là của con người,
                       nhưng vẫn tiếp tục thì hệ thống ghi nhật ký việc bỏ qua. *@
                    <div id="walkInBlacklistWarning" class="alert alert-danger d-none py-2 mb-2" role="alert">
                        <i class="bi bi-shield-exclamation"></i>
                        Khách này nằm trong <strong>danh sách hạn chế</strong> — cần quản lý duyệt.
                        Vẫn tiếp tục thì thao tác sẽ được ghi vào nhật ký.
                    </div>
                    <hr />
                    <div class="row g-2">
                        <div class="col-12">
                            <label asp-for="FullName" class="form-label">Họ tên</label>
                            <input asp-for="FullName" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label asp-for="IdType" class="form-label">Loại giấy tờ</label>
                            <select asp-for="IdType" class="form-select">
                                @foreach (var t in Enum.GetValues<GuestIdType>())
                                {
                                    <option value="@((int)t)" selected="@(Model.IdType == t)">@t.ToDisplayName()</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label asp-for="IdNumber" class="form-label">Số giấy tờ</label>
                            <input asp-for="IdNumber" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label asp-for="PhoneNumber" class="form-label">SĐT</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label asp-for="Nationality" class="form-label">Quốc tịch</label>
                            <input asp-for="Nationality" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">Phòng &amp; thời gian</div>
                <div class="card-body row g-2">
                    <div class="col-12">
                        <label asp-for="RoomId" class="form-label">Phòng <span class="text-danger">*</span></label>
                        <select asp-for="RoomId" asp-items="Model.RoomOptions" class="form-select">
                            <option value="">— Chọn phòng trống —</option>
                        </select>
                        <span asp-validation-for="RoomId" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="ExpectedCheckOut" class="form-label">Ngày đi dự kiến</label>
                        <input asp-for="ExpectedCheckOut" type="date" class="form-control" />
                    </div>
                    <div class="col-3">
                        <label asp-for="Adults" class="form-label">Người lớn</label>
                        <input asp-for="Adults" type="number" min="1" class="form-control" />
                    </div>
                    <div class="col-3">
                        <label asp-for="Children" class="form-label">Trẻ em</label>
                        <input asp-for="Children" type="number" min="0" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header">Đặt cọc (tùy chọn)</div>
                <div class="card-body">
                    @if (!Model.HasOpenShift)
                    {
                        <div class="alert alert-warning py-2 small">Chưa mở ca — không thu cọc được. Vẫn check-in được, bỏ trống tiền cọc. <a asp-controller="Shifts" asp-action="Index">Mở ca</a></div>
                    }
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label asp-for="DepositAmount" class="form-label">Tiền cọc</label>
                            <input asp-for="DepositAmount" type="number" min="0" step="1000" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DepositMethod" class="form-label">Phương thức</label>
                            <select asp-for="DepositMethod" class="form-select">
                                @foreach (var m in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@((int)m)" selected="@(Model.DepositMethod == m)">@m.ToDisplayName()</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="TransactionRef" class="form-label">Mã giao dịch (CK/Thẻ)</label>
                            <input asp-for="TransactionRef" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary"><i class="bi bi-box-arrow-in-right"></i> Check-in</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var select = document.getElementById('walkInGuestSelect');
            var warning = document.getElementById('walkInBlacklistWarning');
            if (!select || !warning) { return; }

            var blocked = [];
            try { blocked = JSON.parse(select.dataset.blacklisted || '[]'); } catch (e) { blocked = []; }

            function sync() {
                var id = parseInt(select.value, 10);
                warning.classList.toggle('d-none', !(id && blocked.indexOf(id) !== -1));
            }

            select.addEventListener('change', sync);
            sync();
        })();
    </script>
}
