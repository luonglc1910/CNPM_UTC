@model ChangeRoomViewModel
@{
    ViewData["Title"] = $"Đổi phòng — {Model.CurrentRoomNumber}";
}

<div class="row"><div class="col-lg-7">
    <div class="card"><div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="alert alert-secondary small">
            Phòng hiện tại: <strong>@Model.CurrentRoomNumber</strong> (@Model.CurrentRoomType, @Model.CurrentPricePerNight.ToString("N0") ₫/đêm).
            Chi phí phòng cũ đến thời điểm đổi giữ nguyên trên folio; các đêm còn lại tính giá phòng mới (BR-09).
        </div>
        <form method="post" asp-action="ChangeRoom">
            <input type="hidden" asp-for="StayId" />
            <div class="mb-2">
                <label asp-for="NewRoomId" class="form-label">Phòng mới <span class="text-danger">*</span></label>
                <select asp-for="NewRoomId" asp-items="Model.AvailableRooms" class="form-select">
                    <option value="">— Chọn phòng trống —</option>
                </select>
                <span asp-validation-for="NewRoomId" class="text-danger small"></span>
            </div>
            <div class="mb-2">
                <label asp-for="Reason" class="form-label">Lý do đổi phòng <span class="text-danger">*</span></label>
                <input asp-for="Reason" class="form-control" placeholder="Khách yêu cầu / phòng hỏng / nâng hạng..." />
                <span asp-validation-for="Reason" class="text-danger small"></span>
            </div>
            @if (Model.IsAdmin)
            {
                <div class="form-check mb-2">
                    <input asp-for="WaivePriceDifference" class="form-check-input" />
                    <label asp-for="WaivePriceDifference" class="form-check-label">Miễn chênh lệch giá (đổi do lỗi khách sạn)</label>
                </div>
            }
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Đổi phòng</button>
                <a class="btn btn-outline-secondary" asp-action="Stay" asp-route-id="@Model.StayId">Hủy</a>
            </div>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
