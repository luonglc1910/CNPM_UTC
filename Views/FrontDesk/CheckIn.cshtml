@model CheckInViewModel
@{
    ViewData["Title"] = $"Check-in đơn {Model.Code}";
}

<form method="post" asp-action="CheckIn">
    <input type="hidden" asp-for="ReservationId" />

    <div class="card mb-3">
        <div class="card-header">Bước 1 — Đối chiếu đơn &amp; giấy tờ</div>
        <div class="card-body">
            <dl class="row mb-2">
                <dt class="col-sm-3">Khách đứng tên</dt>
                <dd class="col-sm-9">
                    @Model.GuestName — <code>@Model.IdNumber</code>
                    @if (Model.GuestBlacklisted)
                    {
                        <span class="badge text-bg-danger ms-1">Danh sách hạn chế</span>
                    }
                </dd>
                <dt class="col-sm-3">Thời gian</dt>
                <dd class="col-sm-9">@Model.CheckInDate.ToString("dd/MM/yyyy") → @Model.CheckOutDate.ToString("dd/MM/yyyy") (@Model.Nights đêm)</dd>
            </dl>
            <div class="form-check">
                <input asp-for="IdVerified" class="form-check-input" />
                <label asp-for="IdVerified" class="form-check-label">Đã đối chiếu giấy tờ tùy thân <span class="text-danger">*</span></label>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Bước 2 — Gán phòng</div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>Loại phòng</th><th>Phòng</th><th class="text-center">Khách</th><th class="text-end">Giá/đêm</th></tr></thead>
                <tbody>
                @for (var i = 0; i < Model.Rooms.Count; i++)
                {
                    var line = Model.Rooms[i];
                    <tr>
                        <td>
                            @line.RoomTypeName
                            <input type="hidden" name="Rooms[@i].ReservationRoomId" value="@line.ReservationRoomId" />
                            <input type="hidden" name="Rooms[@i].RoomTypeId" value="@line.RoomTypeId" />
                            <input type="hidden" name="Rooms[@i].Adults" value="@line.Adults" />
                            <input type="hidden" name="Rooms[@i].Children" value="@line.Children" />
                            <input type="hidden" name="Rooms[@i].PricePerNight" value="@line.PricePerNight" />
                        </td>
                        <td style="min-width: 220px">
                            <select name="Rooms[@i].SelectedRoomId" class="form-select form-select-sm" asp-items="line.AvailableRooms">
                                <option value="">— Chọn phòng —</option>
                            </select>
                        </td>
                        <td class="text-center">@line.Adults NL @(line.Children > 0 ? $"+ {line.Children} TE" : "")</td>
                        <td class="text-end">@line.PricePerNight.ToString("N0") ₫</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer small text-muted">Chỉ hiện phòng cùng loại, đang trống trong khoảng ngày đơn. Thêm khách ở ghép làm sau ở màn chi tiết lưu trú.</div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Bước 3 — Xác nhận</div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-sm-4">
                    <label asp-for="ActualCheckIn" class="form-label">
                        @(Model.RentalType == RentalType.Hourly ? "Giờ bắt đầu tính tiền" : "Giờ nhận phòng thực tế")
                    </label>
                    <input asp-for="ActualCheckIn" type="datetime-local" class="form-control" />
                </div>
                <div class="col-sm-8">
                    @*
                        Thuê theo giờ (BR-13): ô trên không chỉ là mốc ghi nhận, nó là mốc bắt đầu
                        tính tiền. Phải nói rõ, vì lễ tân sửa nhầm một tiếng là hóa đơn lệch một giờ.
                    *@
                    @if (Model.RentalType == RentalType.Hourly)
                    {
                        <div class="alert alert-warning small mb-0">
                            <i class="bi bi-stopwatch"></i>
                            Đồng hồ bắt đầu chạy từ giờ này đến lúc khách trả phòng. Không có phụ thu
                            nhận sớm hay trả trễ.
                        </div>
                    }
                    else if (Model.RentalType == RentalType.Overnight)
                    {
                        <div class="alert alert-secondary small mb-0">
                            Gói qua đêm tính trọn gói @Model.CheckInDate.ToString("HH:mm dd/MM")
                            → @Model.CheckOutDate.ToString("HH:mm dd/MM"); ở quá thì thu thêm theo giờ.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary small mb-0">Nhận trước 14:00 sẽ tự tính phụ thu nhận sớm; vượt sức chứa chuẩn tự tính phụ thu thêm người (BR-03).</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-box-arrow-in-right"></i> Xác nhận check-in</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
    </div>
</form>
