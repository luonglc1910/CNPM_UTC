@model AddGuestViewModel
@{
    ViewData["Title"] = $"Thêm khách — Phòng {Model.RoomNumber}";
}

<div class="row"><div class="col-lg-6">
    <div class="card"><div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="alert alert-secondary small">
            Đang có @Model.CurrentGuestCount khách · sức chứa chuẩn @Model.StandardCapacity, tối đa @Model.MaxCapacity.
            Vượt sức chứa chuẩn sẽ phụ thu @Model.ExtraGuestFee.ToString("N0") ₫/người × @Model.RemainingNights đêm còn lại (BR-03).
        </div>
        <form method="post" asp-action="AddGuest">
            <input type="hidden" asp-for="StayId" />
            <div class="mb-2">
                <label asp-for="FullName" class="form-label">Họ tên <span class="text-danger">*</span></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="row g-2">
                <div class="col-6">
                    <label asp-for="IdType" class="form-label">Loại giấy tờ</label>
                    <select asp-for="IdType" class="form-select">
                        @foreach (var t in Enum.GetValues<GuestIdType>())
                        {
                            <option value="@((int)t)" selected="@(Model.IdType == t)">@t.ToDisplayName()</option>
                        }
                    </select>
                </div>
                <div class="col-6">
                    <label asp-for="IdNumber" class="form-label">Số giấy tờ</label>
                    <input asp-for="IdNumber" class="form-control" />
                </div>
                <div class="col-6">
                    <label asp-for="Nationality" class="form-label">Quốc tịch</label>
                    <input asp-for="Nationality" class="form-control" />
                </div>
                <div class="col-6 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsChild" class="form-check-input" />
                        <label asp-for="IsChild" class="form-check-label">Là trẻ em (không tính phụ thu)</label>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">Thêm khách</button>
                <a class="btn btn-outline-secondary" asp-action="Stay" asp-route-id="@Model.StayId">Hủy</a>
            </div>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
