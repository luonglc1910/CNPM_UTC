@model ReservationDetailsViewModel
@{
    ViewData["Title"] = $"Đơn {Model.Reservation.Code}";
    var r = Model.Reservation;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h5 class="mb-0"><code>@r.Code</code> <span class="badge @r.Status.ToBadgeClass()">@r.Status.ToDisplayName()</span></h5>
        <span class="text-muted small">Tạo bởi @Model.CreatedByName · @r.CreatedAt.ToString("dd/MM/yyyy HH:mm") · Nguồn: @r.Source.ToDisplayName()</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.CanEdit)
        {
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@r.Id"><i class="bi bi-pencil"></i> Sửa</a>
        }
        @if (Model.CanTakeDeposit)
        {
            <a class="btn btn-outline-success" asp-action="Deposit" asp-route-id="@r.Id"><i class="bi bi-qr-code-scan"></i> Thu cọc / VietQR</a>
        }
        @if (Model.CanEdit || r.Status == ReservationStatus.CheckedIn)
        {
            <a class="btn btn-outline-primary" asp-action="ChangeRoom" asp-route-reservationId="@r.Id"><i class="bi bi-arrow-left-right"></i> Đổi phòng</a>
        }
        <form method="post" asp-action="SendConfirmationEmail" asp-route-id="@r.Id" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-info">
                <i class="bi bi-envelope-check"></i> Gửi Email xác nhận
            </button>
        </form>

        @if (Model.CanCheckIn)
        {
            <a class="btn btn-primary" asp-controller="FrontDesk" asp-action="CheckIn" asp-route-reservationId="@r.Id"><i class="bi bi-box-arrow-in-right"></i> Check-in</a>
        }
        @if (Model.CanCancel)
        {
            <a class="btn btn-outline-danger" asp-action="Cancel" asp-route-id="@r.Id"><i class="bi bi-x-circle"></i> Hủy</a>
        }
        @if (Model.CanMarkNoShow)
        {
            <form method="post" asp-action="MarkNoShow" asp-route-id="@r.Id" class="d-inline"
                  onsubmit="return confirm('Đánh dấu No-show đơn @r.Code? Thu 100% tiền cọc.');">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-person-x"></i> No-show</button>
            </form>
        }
        <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
    </div>
</div>

@if (Model.GuestBlacklisted)
{
    <div class="alert alert-danger py-2"><i class="bi bi-exclamation-octagon"></i> Khách đứng tên đang trong danh sách hạn chế.</div>
}

@if (TempData["EmailPreviewUrl"] is string previewUrl && !string.IsNullOrWhiteSpace(previewUrl))
{
    <div class="alert alert-info d-flex justify-content-between align-items-center py-2">
        <span><i class="bi bi-envelope-check me-2"></i>Bản HTML của email xác nhận đã được tạo.</span>
        <a href="@previewUrl" target="_blank" class="btn btn-sm btn-primary"><i class="bi bi-box-arrow-up-right"></i> Xem Email HTML</a>
    </div>
}


<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">Phòng đã đặt</div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr><th>Loại</th><th>Phòng</th><th class="text-center">Khách</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var line in Model.Rooms)
                    {
                        <tr>
                            <td>@line.RoomTypeName</td>
                            <td>@(line.RoomNumber ?? "— xếp sau —")</td>
                            <td class="text-center">@line.Adults NL@(line.Children > 0 ? $" + {line.Children} TE" : "")</td>
                            @* Cột đơn giá phải nói theo hình thức thuê của đơn, không phải lúc nào cũng là giá đêm. *@
                            <td class="text-end text-nowrap">@line.UnitText</td>
                            <td class="text-end">@line.LineTotal.ToString("N0") ₫</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>


    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">Thông tin</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Khách đứng tên</dt>
                    <dd class="col-7">
                        @Model.GuestName
                        @if (Model.GuestHasAccount)
                        {
                            <a class="btn btn-sm btn-outline-primary ms-2 py-0 px-2" asp-controller="Guests" asp-action="Details" asp-route-id="@Model.GuestId"
                               title="Khách có tài khoản — xem thông tin cá nhân" aria-label="Xem thông tin cá nhân của khách">
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                    </dd>
                    <dt class="col-5">Liên hệ</dt><dd class="col-7">@Model.PhoneNumber</dd>
                    <dt class="col-5">Giấy tờ</dt><dd class="col-7">@(string.IsNullOrEmpty(Model.IdNumber) ? "—" : Model.IdNumber)</dd>
                    <dt class="col-5">Hình thức</dt>
                    <dd class="col-7">
                        <span class="badge @r.RentalType.BadgeClass()">
                            <i class="bi bi-@r.RentalType.IconName()"></i> @r.RentalType.DisplayName()
                        </span>
                    </dd>
                    <dt class="col-5">Nhận / Trả</dt>
                    <dd class="col-7">@r.RentalType.SpanText(r.CheckInDate, r.CheckOutDate, r.Nights, r.Hours)</dd>
                    @if (!string.IsNullOrWhiteSpace(r.SpecialRequests))
                    {
                        <dt class="col-5">Yêu cầu</dt><dd class="col-7">@r.SpecialRequests</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">Tiền &amp; Đặt cọc</div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td>Tổng dự kiến</td><td class="text-end">@r.EstimatedTotal.ToString("N0") ₫</td></tr>
                        @if (Model.DepositPaid > 0)
                        {
                            <tr class="text-success"><td>Đã thanh toán / Đặt cọc</td><td class="text-end">-@Model.DepositPaid.ToString("N0") ₫</td></tr>
                            <tr class="table-light fw-semibold"><td>Còn lại dự kiến</td><td class="text-end">@Model.EstimatedRemaining.ToString("N0") ₫</td></tr>
                        }
                    </tbody>
                </table>
                @if (Model.Deposits.Count > 0)
                {
                    <hr class="my-2" />
                    <div class="small text-muted mb-1">Lịch sử cọc / thanh toán trước:</div>
                    <ul class="list-unstyled small mb-0">
                        @foreach (var d in Model.Deposits)
                        {
                            var depLabel = d.Status switch
                            {
                                DepositStatus.Held => "Đang giữ",
                                DepositStatus.Applied => "Đã đối trừ HĐ",
                                DepositStatus.Refunded => "Đã hoàn",
                                _ => "Thu phí"
                            };
                            <li class="d-flex justify-content-between">
                                <span>@d.ReceivedAt.ToString("dd/MM/yyyy HH:mm") (@depLabel)</span>
                                <strong>@d.Amount.ToString("N0") ₫</strong>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
