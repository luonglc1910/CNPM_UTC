@model DepositFormViewModel
@{
    ViewData["Title"] = $"Thu cọc — {Model.ReservationCode}";
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Thu tiền cọc — đơn <code>@Model.ReservationCode</code> (@Model.GuestName)</div>
            <div class="card-body">
                <div class="table-responsive">
                <table class="table table-sm">
                    <tbody>
                        <tr><td>Tổng dự kiến</td><td class="text-end">@Model.EstimatedTotal.ToString("N0") ₫</td></tr>
                        <tr><td>Đã cọc</td><td class="text-end">@Model.AlreadyPaid.ToString("N0") ₫</td></tr>
                        <tr class="fw-semibold"><td>Mức đề xuất</td><td class="text-end">@Model.SuggestedAmount.ToString("N0") ₫</td></tr>
                    </tbody>
                </table>
                </div>

                @if (!Model.HasOpenShift)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> Bạn chưa mở ca làm việc — không thu tiền được (BR-10).
                        <a class="btn btn-sm btn-primary ms-2" asp-controller="Shifts" asp-action="Index">Mở ca làm việc</a>
                    </div>
                }
                else
                {
                    <form method="post" asp-action="Deposit" id="depositForm">
                        <input type="hidden" asp-for="ReservationId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label">Số tiền cọc <span class="text-danger">*</span></label>
                            <input asp-for="Amount" id="depositAmountInput" type="number" min="1" step="any" class="form-control" autofocus />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Method" class="form-label">Phương thức <span class="text-danger">*</span></label>
                            <select asp-for="Method" id="depositMethodSelect" class="form-select">
                                @foreach (var m in Enum.GetValues<PaymentMethod>())
                                {
                                    <option value="@((int)m)" selected="@(Model.Method == m)">@m.ToDisplayName()</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TransactionRef" class="form-label">Mã giao dịch <span class="text-muted small">(bắt buộc với CK/Thẻ/VietQR)</span></label>
                            <input asp-for="TransactionRef" id="depositTxRef" class="form-control" />
                            <span asp-validation-for="TransactionRef" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">Ghi chú</label>
                            <input asp-for="Notes" class="form-control" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-cash-coin"></i> Thu cọc</button>
                            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.ReservationId">Hủy</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    @if (Model.VietQr is not null)
    {
        <div class="col-lg-6">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-qr-code-scan me-1"></i> Quét VietQR đặt cọc</span>
                    <span class="badge bg-light text-primary">@Model.VietQr.BankName</span>
                </div>
                <div class="card-body text-center">
                    <img src="@Model.VietQr.QrImageUrl" alt="VietQR Đặt cọc" class="img-fluid rounded border p-2 mb-3" style="max-width: 240px;" />
                    <div class="small text-start bg-light rounded p-2 mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Ngân hàng:</span>
                            <strong>@Model.VietQr.BankName</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Tên chủ thẻ:</span>
                            <strong>@Model.VietQr.AccountName</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Số thẻ / Số TK:</span>
                            <code>@Model.VietQr.AccountNo</code>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Ngày phát hành / OTP:</span>
                            <span><code>@Model.VietQr.IssueDate</code> · OTP: <code>@Model.VietQr.DefaultOtp</code></span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Tiền cọc đề xuất:</span>
                            <strong class="text-danger">@Model.VietQr.Amount.ToString("N0") ₫</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Nội dung CK:</span>
                            <code>@Model.VietQr.TransferMemo</code>
                        </div>
                    </div>
                    @if (Model.HasOpenShift)
                    {
                        <button type="button" class="btn btn-success w-100" onclick="confirmDepositVietQr()">
                            <i class="bi bi-lightning-charge-fill"></i> Đã nhận VietQR — Ghi nhận tiền cọc ngay
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function confirmDepositVietQr() {
            var sel = document.getElementById('depositMethodSelect');
            var tx = document.getElementById('depositTxRef');
            if (sel) sel.value = '@((int)PaymentMethod.BankTransfer)';
            if (tx && !tx.value) tx.value = 'VQR-DEP-' + Date.now();
            document.getElementById('depositForm')?.submit();
        }
    </script>
}
