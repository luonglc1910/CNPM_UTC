@model RoomChartViewModel
@{
    ViewData["Title"] = "Tình trạng phòng";

    // Nhóm phòng theo tầng để vẽ lưới
    var byFloor = Model.Rows
        .GroupBy(r => r.Floor)
        .OrderBy(g => g.Key)
        .ToList();

    // Trạng thái hôm nay dựa vào segment đầu tiên (ngày đầu của range = hôm nay)
    static (string cssClass, string icon, string label) CardStyle(RoomChartCellKind kind, RoomStatus status) => kind switch
    {
        RoomChartCellKind.Occupied  => ("room-card-occupied",  "bi-person-fill",      "Đang ở"),
        RoomChartCellKind.Reserved  => ("room-card-reserved",  "bi-calendar-check",   "Đã đặt"),
        RoomChartCellKind.Blocked   => ("room-card-blocked",   "bi-slash-circle",     "Không KT"),
        RoomChartCellKind.Hourly    => ("room-card-hourly",    "bi-clock",            "Theo giờ"),
        _                           => ("room-card-free",      "bi-door-open",        "Trống"),
    };

    string CellClass(RoomChartCellKind kind) => kind switch
    {
        RoomChartCellKind.Occupied => "chart-occupied",
        RoomChartCellKind.Reserved => "chart-reserved",
        RoomChartCellKind.Blocked  => "chart-blocked",
        RoomChartCellKind.Hourly   => "chart-hourly",
        _ => "chart-free"
    };

    // Tính stats tóm tắt hôm nay — dùng trong cả phần lưới card và thanh stat bar
    var todaySegs   = Model.Rows.Select(r => r.Segments.FirstOrDefault()).ToList();
    int cntFree     = todaySegs.Count(s => s?.Kind == RoomChartCellKind.Free || s is null);
    int cntReserved = todaySegs.Count(s => s?.Kind == RoomChartCellKind.Reserved);
    int cntOccupied = todaySegs.Count(s => s?.Kind == RoomChartCellKind.Occupied);
    int cntHourly   = todaySegs.Count(s => s?.Kind == RoomChartCellKind.Hourly);
    int cntBlocked  = todaySegs.Count(s => s?.Kind == RoomChartCellKind.Blocked);
}

<style>
    /* ── Lưới card ─────────────────────────────────────────────── */
    .floor-section { margin-bottom: 1.75rem; }
    .floor-label {
        font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
        color: var(--bs-secondary); margin-bottom: .5rem; padding-left: .25rem;
    }
    .room-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: .5rem;
    }
    .room-card {
        border-radius: .625rem;
        padding: .65rem .75rem;
        cursor: pointer;
        transition: transform .12s, box-shadow .12s;
        border: 1.5px solid transparent;
        text-decoration: none;
        display: flex; flex-direction: column; gap: .15rem;
    }
    .room-card:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.13); }

    .room-card-free     { background: #f0fdf4; border-color: #86efac; color: #166534; }
    .room-card-reserved { background: #eff6ff; border-color: #93c5fd; color: #1d4ed8; }
    .room-card-occupied { background: #fef3c7; border-color: #fcd34d; color: #92400e; }
    .room-card-hourly   { background: #fdf4ff; border-color: #d8b4fe; color: #6b21a8; }
    .room-card-blocked  { background: #f3f4f6; border-color: #9ca3af; color: #374151; }

    .room-card .room-no    { font-size: 1rem; font-weight: 700; line-height: 1; }
    .room-card .room-type  { font-size: .68rem; opacity: .7; line-height: 1.2; }
    .room-card .room-badge {
        margin-top: .35rem;
        display: inline-flex; align-items: center; gap: .25rem;
        font-size: .7rem; font-weight: 600;
    }
    .room-card .room-guest { font-size: .72rem; margin-top: .15rem; opacity: .85; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* Stats bar */
    .stat-bar { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; font-size: .82rem; }
    .stat-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; flex-shrink: 0; }

    /* ── Gantt (Tương tác kéo-thả & chọn dải ngày) ─────────────────────────── */
    .interactive-free-cell {
        cursor: crosshair;
        user-select: none;
        position: relative;
        transition: background-color 0.1s;
    }
    .interactive-free-cell:hover {
        background-color: #dcfce7 !important;
    }
    .interactive-free-cell.drag-selected {
        background-color: #86efac !important;
        box-shadow: inset 0 0 0 2px #16a34a;
    }
    .draggable-band-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 4px;
        width: 100%;
        cursor: grab;
    }
    .draggable-band-wrapper:active {
        cursor: grabbing;
    }
    .gantt-row-drop-hover th,
    .gantt-row-drop-hover td {
        background-color: #e0f2fe !important;
        outline: 1px dashed #0284c7;
    }
    /* Nút +1đ: cùng chiều cao, cỡ chữ và bo góc với dải tên khách (.room-chart-band) cho cân đối. */
    .btn-quick-extend {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 1.8rem;
        margin: 0.3rem 2px;
        padding: 0 0.75rem;
        font-size: 0.75rem;
        line-height: 1;
        border-radius: 4px;
        background: rgba(255,255,255,0.85);
        border: 1px solid rgba(0,0,0,0.2);
        color: #1e293b;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .btn-quick-extend:hover {
        background: #fff;
        color: #0f172a;
    }

    .room-chart-split {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
    }
    .room-chart-pane {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 34rem;
        height: calc(100vh - 20rem);
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--rule);
        border-radius: 12px;
    }
    .room-chart-pane-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: .75rem;
        padding: .85rem 1rem;
        background: #f7f9f8;
        border-bottom: 1px solid var(--rule);
    }
    .room-chart-pane-head h3 { margin: 0; font-size: .9rem; color: var(--ink); }
    .room-chart-pane-head p { margin: .18rem 0 0; color: var(--fg-muted); font-size: .65rem; }
    .room-map-scroll {
        flex: 1;
        min-height: 0;
        padding: 1rem;
        overflow: auto;
    }
    .room-map-scroll .floor-section:last-child { margin-bottom: 0; }
    .room-gantt-body {
        flex: 1;
        min-height: 0;
        overflow: auto;
    }
    .room-gantt-help {
        display: grid;
        gap: .25rem;
        padding: .65rem .85rem;
        color: var(--fg-muted);
        background: #fff;
        border-bottom: 1px solid var(--rule);
        font-size: .62rem;
    }
    .room-chart-split .card { border: 0; border-radius: 0; }
    @@media (max-width: 1199.98px) {
        .room-chart-split { grid-template-columns: 1fr; }
        .room-chart-pane { height: auto; min-height: 0; }
        .room-map-scroll, .room-gantt-body { max-height: none; }
    }
</style>

<div class="ops-page">
<section class="ops-hero"><div><span class="ops-hero-kicker">Điều phối phòng</span><h2>Sơ đồ phòng tương tác</h2><p>Xem lịch theo phòng, quét chọn ngày trống, kéo-thả đổi phòng và gia hạn nhanh.</p></div><div class="ops-hero-actions"><a class="btn btn-outline-light" asp-action="Availability"><i class="bi bi-search"></i> Tra cứu trống</a><a class="btn btn-light" asp-action="Create"><i class="bi bi-plus-lg"></i> Tạo đơn</a></div></section>

@* ── Bộ lọc ───────────────────────────────────────────── *@
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label asp-for="From" class="form-label small mb-1">Từ ngày</label>
                <input asp-for="From" type="date" name="from" class="form-control" />
            </div>
            <div class="col-6 col-md-2">
                <label asp-for="Days" class="form-label small mb-1">Số ngày hiển thị</label>
                <select asp-for="Days" name="days" class="form-select">
                    @foreach (var d in new[] { 7, 14, 30, 60 })
                    {
                        <option value="@d" selected="@(Model.Days == d)">@d ngày</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-auto d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary text-nowrap"><i class="bi bi-arrow-clockwise"></i> Cập nhật</button>
                <a class="btn btn-outline-secondary text-nowrap" asp-action="Availability">
                    <i class="bi bi-calendar-check"></i> Tra cứu theo loại phòng
                </a>
            </div>
        </form>

    </div>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="card"><div class="card-body text-center text-muted py-5">Chưa có phòng nào đang khai thác.</div></div>
}
else
{
    @* ── Thanh tóm tắt ─────────────────────────────────────── *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="stat-bar">
            <span class="d-flex align-items-center gap-1"><span class="stat-dot" style="background:#86efac"></span> Trống <strong>@cntFree</strong></span>
            <span class="d-flex align-items-center gap-1"><span class="stat-dot" style="background:#93c5fd"></span> Đã đặt <strong>@cntReserved</strong></span>
            <span class="d-flex align-items-center gap-1"><span class="stat-dot" style="background:#fcd34d"></span> Đang ở <strong>@cntOccupied</strong></span>
            @if (cntHourly > 0)
            {
                <span class="d-flex align-items-center gap-1"><span class="stat-dot" style="background:#d8b4fe"></span> Theo giờ <strong>@cntHourly</strong></span>
            }
            @if (cntBlocked > 0)
            {
                <span class="d-flex align-items-center gap-1"><span class="stat-dot" style="background:#9ca3af"></span> Không KT <strong>@cntBlocked</strong></span>
            }
        </div>
        <span class="text-muted small">
            @Model.Rows.Count phòng · còn trống <strong>@Model.FreeNights</strong>/@Model.TotalNights đêm (@Model.Days ngày tới)
        </span>
    </div>

    @* ── Lưới card theo tầng ──────────────────────────────── *@
    <div class="room-chart-split">
    <section class="room-chart-pane" aria-labelledby="roomMapTitle">
        <div class="room-chart-pane-head">
            <div><h3 id="roomMapTitle"><i class="bi bi-grid-3x3-gap me-1"></i> Sơ đồ phòng</h3><p>Trạng thái hiện tại theo từng tầng</p></div>
            <span class="badge text-bg-light border">@Model.Rows.Count phòng</span>
        </div>
        <div class="room-map-scroll">
    @foreach (var floor in byFloor)
    {
        <div class="floor-section">
            <div class="floor-label">Tầng @floor.Key</div>
            <div class="room-grid">
                @foreach (var row in floor.OrderBy(r => r.RoomNumber))
                {
                    var seg = row.Segments.FirstOrDefault();
                    var kind = seg?.Kind ?? RoomChartCellKind.Free;
                    var (css, icon, label) = CardStyle(kind, row.CurrentStatus);

                    @* Card trống → link tạo đơn; card khác → link xem đơn *@
                    @if (kind == RoomChartCellKind.Free)
                    {
                        <a class="room-card @css"
                           asp-controller="Reservations" asp-action="Create"
                           asp-route-roomId="@row.RoomId"
                           asp-route-checkIn="@Model.From.ToString("yyyy-MM-dd")"
                           title="Tạo đơn phòng @row.RoomNumber">
                            <div class="room-no">@row.RoomNumber</div>
                            <div class="room-type">@row.RoomTypeName</div>
                            <div class="room-badge"><i class="bi @icon"></i> @label</div>
                        </a>
                    }
                    else if (kind == RoomChartCellKind.Occupied && (seg?.StayId is not null || seg?.ReservationId is not null))
                    {
                        var stayUrl = seg?.StayId is int sid
                            ? Url.Action("Stay", "FrontDesk", new { id = sid })
                            : Url.Action("Details", "Reservations", new { id = seg!.ReservationId });
                        <a class="room-card @css"
                           href="@stayUrl"
                           title="@seg?.Tooltip">
                            <div class="room-no">@row.RoomNumber</div>
                            <div class="room-type">@row.RoomTypeName</div>
                            <div class="room-badge"><i class="bi @icon"></i> @label</div>
                            @if (seg?.GuestName is { Length: > 0 } guestName)
                            {
                                <div class="room-guest">@guestName</div>
                            }
                        </a>
                    }
                    else if (kind == RoomChartCellKind.Reserved && seg?.ReservationId is int reservedId)
                    {
                        <a class="room-card @css"
                           asp-controller="Reservations" asp-action="Details"
                           asp-route-id="@reservedId"
                           title="@seg?.Tooltip">
                            <div class="room-no">@row.RoomNumber</div>
                            <div class="room-type">@row.RoomTypeName</div>
                            <div class="room-badge"><i class="bi @icon"></i> @label</div>
                            @if (seg?.GuestName is { Length: > 0 } g)
                            {
                                <div class="room-guest">@g</div>
                            }
                        </a>
                    }
                    else
                    {
                        <div class="room-card @css" title="@seg?.Tooltip">
                            <div class="room-no">@row.RoomNumber</div>
                            <div class="room-type">@row.RoomTypeName</div>
                            <div class="room-badge"><i class="bi @icon"></i> @label</div>
                            @if (seg?.HourlyCount > 0)
                            {
                                <div class="room-guest">@seg.HourlyCount lượt</div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }

        </div>
    </section>

    @* ── Bảng Gantt Tương tác (Kéo-thả đổi phòng, Quét chọn ngày đặt phòng, Gia hạn nhanh) ── *@
    <section class="room-chart-pane" aria-labelledby="ganttTitle">
        <div class="room-chart-pane-head">
            <div><h3 id="ganttTitle"><i class="bi bi-calendar3-range me-1"></i> Sơ đồ Gantt tương tác</h3><p>Lịch đặt và lưu trú trong @Model.Days ngày</p></div>
            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#ganttPanel" aria-expanded="true" title="Thu gọn / mở Gantt"><i class="bi bi-chevron-expand"></i></button>
        </div>
        <div class="room-gantt-help">
            <span><i class="bi bi-mouse text-success"></i> Kéo qua ô trống để chọn ngày</span>
            <span><i class="bi bi-arrows-move text-primary"></i> Kéo thanh khách sang hàng khác để đổi phòng</span>
            <span><i class="bi bi-plus-square text-warning"></i> Bấm +1đ để gia hạn thêm một đêm</span>
        </div>

        <div class="collapse show room-gantt-body" id="ganttPanel">
            @if (Model.Truncated)
            {
                <div class="alert alert-info alert-sm mb-2">
                    Khoảng yêu cầu vượt @RoomChartViewModel.MaxDays ngày nên đã rút gọn.
                </div>
            }
            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table room-chart mb-0" id="interactiveGanttTable">
                        <thead>
                            <tr>
                                <th class="room-chart-head">Phòng</th>
                                @foreach (var d in Model.Dates)
                                {
                                    var weekend = d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                                    <th class="room-chart-day @(weekend ? "is-weekend" : "")">
                                        <div class="room-chart-dow">@d.ToString("ddd", new System.Globalization.CultureInfo("vi-VN"))</div>
                                        <div>@d.ToString("dd/MM")</div>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                <tr class="gantt-room-row"
                                    data-target-room-id="@row.RoomId"
                                    data-target-room-no="@row.RoomNumber"
                                    data-target-room-type="@row.RoomTypeName">
                                    <th class="room-chart-head">
                                        <div class="fw-semibold">@row.RoomNumber</div>
                                        <div class="text-muted small">@row.RoomTypeName</div>
                                    </th>
                                    @foreach (var seg in row.Segments)
                                    {
                                        @if (seg.Kind == RoomChartCellKind.Free)
                                        {
                                            @for (var offset = 0; offset < seg.Span; offset++)
                                            {
                                                var cellDate = seg.Date.AddDays(offset);
                                                var nextDate = cellDate.AddDays(1);
                                                <td class="room-chart-cell chart-free interactive-free-cell"
                                                    data-room-id="@row.RoomId"
                                                    data-room-type-id="@row.RoomTypeId"
                                                    data-room-no="@row.RoomNumber"
                                                    data-date="@cellDate.ToString("yyyy-MM-dd")"
                                                    title="Kéo chuột chọn ngày hoặc nhấp để đặt P.@row.RoomNumber ngày @cellDate.ToString("dd/MM")">
                                                    <a class="room-chart-link"
                                                       asp-action="Create"
                                                       asp-route-roomId="@row.RoomId"
                                                       asp-route-roomTypeId="@row.RoomTypeId"
                                                       asp-route-checkIn="@cellDate.ToString("yyyy-MM-dd")"
                                                       asp-route-checkOut="@nextDate.ToString("yyyy-MM-dd")">
                                                        <span class="visually-hidden">Đặt phòng</span>
                                                    </a>
                                                </td>
                                            }
                                        }
                                        else
                                        {
                                            var isDraggable = seg.Kind is RoomChartCellKind.Reserved or RoomChartCellKind.Occupied
                                                && (seg.ReservationId.HasValue || seg.StayId.HasValue);

                                            <td class="room-chart-cell @CellClass(seg.Kind)" colspan="@seg.Span" title="@seg.Tooltip">
                                                @if (seg.Kind == RoomChartCellKind.Hourly)
                                                {
                                                    <a class="room-chart-band"
                                                       asp-action="Index"
                                                       asp-route-CustomFilter="true"
                                                       asp-route-CheckInFrom="@seg.Date.ToString("yyyy-MM-dd")"
                                                       asp-route-CheckInTo="@seg.Date.ToString("yyyy-MM-dd")">
                                                        @seg.HourlyCount lượt giờ
                                                    </a>
                                                }
                                                else if (isDraggable)
                                                {
                                                    var detailUrl = seg.Kind == RoomChartCellKind.Occupied && seg.StayId.HasValue
                                                        ? Url.Action("Stay", "FrontDesk", new { id = seg.StayId })
                                                        : Url.Action("Details", "Reservations", new { id = seg.ReservationId });

                                                    <div class="draggable-band-wrapper"
                                                         draggable="true"
                                                         data-reservation-id="@seg.ReservationId"
                                                         data-stay-id="@seg.StayId"
                                                         data-from-room-id="@row.RoomId"
                                                         data-from-room-no="@row.RoomNumber"
                                                         data-guest="@seg.GuestName"
                                                         data-code="@(seg.ReservationCode ?? "Lưu trú")">
                                                        <a class="room-chart-band text-truncate" href="@detailUrl">
                                                            <i class="bi bi-grip-vertical opacity-50 me-1"></i>@seg.GuestName
                                                        </a>
                                                        <button type="button" class="btn-quick-extend"
                                                                title="Gia hạn thêm 1 đêm cho @seg.GuestName (P.@row.RoomNumber)"
                                                                onclick="submitQuickExtend(event, '@seg.ReservationId', '@seg.StayId', '@row.RoomNumber', '@Html.Raw((seg.GuestName ?? "").Replace("'", "\\'"))')">
                                                            +1đ
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="room-chart-band">@seg.StatusLabel</span>
                                                }
                                            </td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
    </div>

    @* Form ẩn gia hạn nhanh +1 đêm *@
    <form method="post" asp-action="QuickExtend" id="quickExtendForm" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="reservationId" id="extReservationId" />
        <input type="hidden" name="stayId" id="extStayId" />
        <input type="hidden" name="addNights" value="1" />
        <input type="hidden" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="days" value="@Model.Days" />
    </form>

    @* Modal xác nhận kéo-thả đổi phòng nhanh *@
    <div class="modal fade" id="quickMoveModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-action="QuickMoveRoom">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="reservationId" id="moveReservationId" />
                    <input type="hidden" name="stayId" id="moveStayId" />
                    <input type="hidden" name="fromRoomId" id="moveFromRoomId" />
                    <input type="hidden" name="toRoomId" id="moveToRoomId" />
                    <input type="hidden" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="days" value="@Model.Days" />
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-arrows-move text-primary me-1"></i> Xác nhận Đổi phòng nhanh</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-info mb-3" id="moveSummaryText"></div>
                        <div class="mb-2">
                            <label class="form-label">Lý do đổi phòng <span class="text-danger">*</span></label>
                            <input type="text" name="reason" class="form-control" value="Đổi phòng theo yêu cầu khách trên sơ đồ" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> Xác nhận chuyển phòng</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        function submitQuickExtend(e, resId, stayId, roomNo, guestName) {
            e.preventDefault();
            e.stopPropagation();
            if (!confirm('Gia hạn thêm 1 đêm cho khách ' + guestName + ' (Phòng ' + roomNo + ')?')) return;
            document.getElementById('extReservationId').value = resId || '';
            document.getElementById('extStayId').value = stayId || '';
            document.getElementById('quickExtendForm').submit();
        }

        (function () {
            // 1. Kéo chuột qua các ô trống cùng phòng để chọn khoảng ngày tạo đơn
            var isSelecting = false;
            var selectRoomId = null;
            var selectRoomTypeId = null;
            var startDate = null;
            var endDate = null;

            function clearSelection() {
                document.querySelectorAll('.interactive-free-cell.drag-selected').forEach(function (el) {
                    el.classList.remove('drag-selected');
                });
            }

            function highlightRange(roomId, d1, d2) {
                clearSelection();
                var minD = d1 < d2 ? d1 : d2;
                var maxD = d1 < d2 ? d2 : d1;
                document.querySelectorAll('.interactive-free-cell[data-room-id="' + roomId + '"]').forEach(function (cell) {
                    var cd = cell.getAttribute('data-date');
                    if (cd >= minD && cd <= maxD) {
                        cell.classList.add('drag-selected');
                    }
                });
            }

            document.querySelectorAll('.interactive-free-cell').forEach(function (cell) {
                cell.addEventListener('mousedown', function (e) {
                    if (e.button !== 0) return;
                    isSelecting = true;
                    selectRoomId = cell.getAttribute('data-room-id');
                    selectRoomTypeId = cell.getAttribute('data-room-type-id');
                    startDate = cell.getAttribute('data-date');
                    endDate = startDate;
                    highlightRange(selectRoomId, startDate, endDate);
                });

                cell.addEventListener('mouseenter', function () {
                    if (!isSelecting) return;
                    if (cell.getAttribute('data-room-id') !== selectRoomId) return;
                    endDate = cell.getAttribute('data-date');
                    highlightRange(selectRoomId, startDate, endDate);
                });
            });

            document.addEventListener('mouseup', function () {
                if (!isSelecting) return;
                isSelecting = false;
                if (selectRoomId && startDate && endDate && startDate !== endDate) {
                    var minD = startDate < endDate ? startDate : endDate;
                    var maxD = startDate < endDate ? endDate : startDate;
                    var checkOutObj = new Date(maxD + 'T00:00:00');
                    checkOutObj.setDate(checkOutObj.getDate() + 1);
                    var checkOutStr = checkOutObj.toISOString().slice(0, 10);
                    clearSelection();
                    window.location.href = '/Reservations/Create?roomId=' + encodeURIComponent(selectRoomId)
                        + '&roomTypeId=' + encodeURIComponent(selectRoomTypeId || '')
                        + '&checkIn=' + encodeURIComponent(minD)
                        + '&checkOut=' + encodeURIComponent(checkOutStr);
                } else {
                    clearSelection();
                }
            });

            // 2. Kéo-thả thanh Đặt phòng / Lưu trú sang hàng phòng khác để đổi phòng nhanh
            var draggedData = null;

            document.querySelectorAll('.draggable-band-wrapper').forEach(function (band) {
                band.addEventListener('dragstart', function (e) {
                    draggedData = {
                        reservationId: band.getAttribute('data-reservation-id') || '',
                        stayId: band.getAttribute('data-stay-id') || '',
                        fromRoomId: band.getAttribute('data-from-room-id') || '',
                        fromRoomNo: band.getAttribute('data-from-room-no') || '',
                        guest: band.getAttribute('data-guest') || '',
                        code: band.getAttribute('data-code') || ''
                    };
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', draggedData.fromRoomId);
                });

                band.addEventListener('dragend', function () {
                    document.querySelectorAll('.gantt-row-drop-hover').forEach(function (r) {
                        r.classList.remove('gantt-row-drop-hover');
                    });
                });
            });

            document.querySelectorAll('.gantt-room-row').forEach(function (row) {
                row.addEventListener('dragover', function (e) {
                    if (!draggedData) return;
                    var targetRoomId = row.getAttribute('data-target-room-id');
                    if (targetRoomId && targetRoomId !== draggedData.fromRoomId) {
                        e.preventDefault();
                        e.dataTransfer.dropEffect = 'move';
                        row.classList.add('gantt-row-drop-hover');
                    }
                });

                row.addEventListener('dragleave', function () {
                    row.classList.remove('gantt-row-drop-hover');
                });

                row.addEventListener('drop', function (e) {
                    row.classList.remove('gantt-row-drop-hover');
                    if (!draggedData) return;
                    var targetRoomId = row.getAttribute('data-target-room-id');
                    var targetRoomNo = row.getAttribute('data-target-room-no');
                    var targetRoomType = row.getAttribute('data-target-room-type');
                    if (!targetRoomId || targetRoomId === draggedData.fromRoomId) return;
                    e.preventDefault();

                    document.getElementById('moveReservationId').value = draggedData.reservationId;
                    document.getElementById('moveStayId').value = draggedData.stayId;
                    document.getElementById('moveFromRoomId').value = draggedData.fromRoomId;
                    document.getElementById('moveToRoomId').value = targetRoomId;
                    document.getElementById('moveSummaryText').innerHTML =
                        'Chuyển khách <strong>' + draggedData.guest + '</strong> (' + draggedData.code + ') từ '
                        + '<strong>Phòng ' + draggedData.fromRoomNo + '</strong> sang '
                        + '<strong>Phòng ' + targetRoomNo + ' (' + targetRoomType + ')</strong>?';

                    var modalEl = document.getElementById('quickMoveModal');
                    if (modalEl && window.bootstrap) {
                        new bootstrap.Modal(modalEl).show();
                    }
                });
            });
        })();
    </script>
}
</div>
