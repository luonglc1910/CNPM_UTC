@model ReservationFormViewModel
@{
    ViewData["Title"] = "Sửa đơn đặt phòng";
}

<div class="alert alert-secondary small">
    Sửa được ngày, dòng phòng, số khách, nguồn đặt, khách đứng tên khi đơn ở trạng thái
    <strong>Nháp</strong> hoặc <strong>Đã xác nhận</strong>. Đổi ngày/phòng sẽ kiểm tra lại xung đột (BR-06).
</div>

<partial name="_Form" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_RoomLinesScript" model="Model" />
}
