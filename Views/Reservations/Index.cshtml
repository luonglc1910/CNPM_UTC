@model ReservationsPageViewModel
@{
    ViewData["Title"] = Model.IsNoShow ? "Đơn quá hạn / No-show" : "Đơn đặt phòng";
}

@*
    Hai tab là hai đường dẫn, mỗi tab giữ bảng và nút riêng. Gộp thành một bảng sẽ phải
    thêm hai cột và ba nút chỉ có nghĩa với đơn quá hạn vào bảng vốn đã mười cột.
*@
<ul class="nav nav-pills report-nav mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.IsNoShow ? "" : "active")" asp-action="Index">
            <i class="bi bi-journal-bookmark"></i> Tất cả đơn
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.IsNoShow ? "active" : "")" asp-action="Index" asp-route-tab="noshow">
            <i class="bi bi-person-x"></i>
            Quá hạn / No-show
            @if (Model.IsNoShow && Model.NoShow is { Items.Count: > 0 })
            {
                <span class="badge text-bg-danger ms-1">@Model.NoShow.Items.Count</span>
            }
        </a>
    </li>
</ul>

@if (Model.IsNoShow)
{
    <partial name="_NoShowList" model="Model.NoShow" />
}
else
{
    <partial name="_ReservationList" model="Model.List" />
}
