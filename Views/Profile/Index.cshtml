@model HotelManagement.Web.Models.ViewModels.ClientProfileViewModel
@{
    Layout = "_PortalLayout";
    ViewData["Title"] = "Hồ sơ của bạn - Aura Boutique Hotel";
}

<!-- Hero Section with Background -->
<div class="relative bg-primary-container pt-16 pb-32 overflow-hidden">
    <!-- Abstract Background Pattern -->
    <div class="absolute inset-0 opacity-10">
        <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
            <path d="M0,0 L100,100 M100,0 L0,100" stroke="white" stroke-width="0.5"></path>
        </svg>
    </div>
    <div class="max-w-[1000px] mx-auto px-4 md:px-8 relative z-10 flex flex-col md:flex-row items-center md:items-end justify-between gap-6">
        <div class="flex items-center gap-6">
            <div class="w-24 h-24 bg-gradient-to-br from-secondary-fixed to-secondary-container rounded-full p-1 shadow-2xl relative group">
                <div class="w-full h-full bg-primary-container rounded-full flex items-center justify-center text-secondary-fixed text-4xl font-display-lg font-bold">
                    @Model.FullName?.FirstOrDefault().ToString().ToUpper()
                </div>
                <div class="absolute bottom-0 right-0 w-8 h-8 bg-secondary rounded-full flex items-center justify-center border-2 border-primary-container shadow-md cursor-pointer hover:bg-secondary-container hover:text-on-secondary-container transition-colors">
                    <span class="material-symbols-outlined text-[16px] text-white group-hover:text-on-secondary-container">edit</span>
                </div>
            </div>
            <div class="text-white">
                <h1 class="text-3xl font-display-lg font-semibold tracking-wide">@Model.FullName</h1>
                <div class="flex items-center gap-2 mt-2">
                    <span class="material-symbols-outlined text-[16px] text-secondary-fixed">workspace_premium</span>
                    <span class="text-sm tracking-widest uppercase text-secondary-fixed font-medium">Hạng thẻ: @ViewData["Tier"]</span>
                </div>
            </div>
        </div>
        <div class="bg-white/10 backdrop-blur-md rounded-2xl px-6 py-4 border border-white/20 text-white min-w-[200px]">
            <div class="flex justify-between items-center mb-1">
                <span class="text-xs uppercase tracking-wider text-white/70">Điểm thưởng</span>
                <span class="material-symbols-outlined text-[16px] text-tertiary-fixed">stars</span>
            </div>
            <div class="text-2xl font-bold font-numeric-table text-tertiary-fixed mb-2">@ViewData["RewardPoints"] <span class="text-sm font-normal text-white/70">pts</span></div>
            <div class="w-full bg-white/20 rounded-full h-1">
                <div class="bg-tertiary-fixed h-1 rounded-full shadow-[0_0_8px_#a4f4c5]" style="width: @(ViewData["ProgressPercent"])%"></div>
            </div>
            @if (ViewData["PointsNeeded"] != null && (int)ViewData["PointsNeeded"] > 0)
            {
                <p class="text-[10px] text-white/60 text-right mt-1">@(ViewData["PointsNeeded"]) pts nữa để thăng hạng</p>
            }
            else
            {
                <p class="text-[10px] text-white/60 text-right mt-1">Đã đạt mức thẻ cao nhất</p>
            }
        </div>
    </div>
</div>

<div class="max-w-[1000px] mx-auto px-4 md:px-8 -mt-20 relative z-20 pb-20">
    <div class="bg-surface-container-lowest rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-surface-variant p-6 md:p-10">
        <form id="profileForm" asp-action="UpdateAjax" method="post">
            
            <div class="flex items-center justify-between border-b border-surface-variant pb-4 mb-8">
                <h3 class="text-xl font-headline-md font-semibold text-on-surface">Thông tin Cá nhân</h3>
                <span class="text-xs text-on-surface-variant flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">lock</span> Bảo mật thông tin</span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
                <!-- Cột trái -->
                <div class="space-y-6">
                    <div class="relative group">
                        <label asp-for="FullName" class="block text-xs uppercase tracking-wider font-semibold text-on-surface-variant mb-2"></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-on-surface-variant group-focus-within:text-primary transition-colors">
                                <span class="material-symbols-outlined text-[20px]">person</span>
                            </span>
                            <input asp-for="FullName" class="w-full pl-12 pr-4 py-3 bg-surface rounded-xl border border-surface-variant focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface font-medium placeholder:text-on-surface-variant/50" placeholder="Nguyễn Văn A" />
                        </div>
                        <span asp-validation-for="FullName" class="text-error text-xs mt-1 block"></span>
                    </div>
                    
                    <div class="relative group">
                        <label asp-for="IdNumber" class="block text-xs uppercase tracking-wider font-semibold text-on-surface-variant mb-2"></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-on-surface-variant group-focus-within:text-primary transition-colors">
                                <span class="material-symbols-outlined text-[20px]">badge</span>
                            </span>
                            <input asp-for="IdNumber" class="w-full pl-12 pr-4 py-3 bg-surface rounded-xl border border-surface-variant focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface font-medium placeholder:text-on-surface-variant/50" placeholder="Số CCCD / Hộ chiếu" />
                        </div>
                        <span asp-validation-for="IdNumber" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <div class="relative group">
                        <label asp-for="Gender" class="block text-xs uppercase tracking-wider font-semibold text-on-surface-variant mb-2"></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-on-surface-variant group-focus-within:text-primary transition-colors">
                                <span class="material-symbols-outlined text-[20px]">wc</span>
                            </span>
                            <select asp-for="Gender" asp-items="Html.GetEnumSelectList<HotelManagement.Web.Models.Gender>()" class="w-full pl-12 pr-4 py-3 bg-surface rounded-xl border border-surface-variant focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface font-medium appearance-none">
                                <option value="">— Vui lòng chọn —</option>
                            </select>
                            <span class="absolute inset-y-0 right-0 flex items-center pr-4 pointer-events-none text-on-surface-variant">
                                <span class="material-symbols-outlined text-[20px]">expand_more</span>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Cột phải -->
                <div class="space-y-6">
                    <div class="relative group">
                        <label asp-for="PhoneNumber" class="block text-xs uppercase tracking-wider font-semibold text-on-surface-variant mb-2"></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-on-surface-variant group-focus-within:text-primary transition-colors">
                                <span class="material-symbols-outlined text-[20px]">call</span>
                            </span>
                            <input asp-for="PhoneNumber" class="w-full pl-12 pr-4 py-3 bg-surface rounded-xl border border-surface-variant focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface font-medium placeholder:text-on-surface-variant/50" placeholder="09xxxx..." />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <div class="relative group">
                        <label asp-for="DateOfBirth" class="block text-xs uppercase tracking-wider font-semibold text-on-surface-variant mb-2"></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-on-surface-variant group-focus-within:text-primary transition-colors">
                                <span class="material-symbols-outlined text-[20px]">calendar_today</span>
                            </span>
                            <input asp-for="DateOfBirth" type="date" class="w-full pl-12 pr-4 py-3 bg-surface rounded-xl border border-surface-variant focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface font-medium" />
                        </div>
                        <span asp-validation-for="DateOfBirth" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <div class="relative group">
                        <label asp-for="Address" class="block text-xs uppercase tracking-wider font-semibold text-on-surface-variant mb-2"></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-on-surface-variant group-focus-within:text-primary transition-colors">
                                <span class="material-symbols-outlined text-[20px]">location_on</span>
                            </span>
                            <input asp-for="Address" class="w-full pl-12 pr-4 py-3 bg-surface rounded-xl border border-surface-variant focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-on-surface font-medium placeholder:text-on-surface-variant/50" placeholder="Nhập địa chỉ của bạn" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-10 flex justify-end">
                <button type="submit" class="group relative px-8 py-3 bg-primary text-on-primary rounded-xl font-label-lg font-semibold overflow-hidden shadow-lg hover:shadow-xl transition-all hover:-translate-y-0.5">
                    <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
                    <span class="relative flex items-center gap-2">
                        <span class="material-symbols-outlined text-[20px]">save</span> Lưu thay đổi
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('profileForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            
            const form = this;
            const submitBtn = form.querySelector('button[type="submit"]');
            const btnContentSpan = submitBtn.querySelector('span.relative');
            const originalHtml = btnContentSpan.innerHTML;
            
            // Loading state
            submitBtn.disabled = true;
            btnContentSpan.innerHTML = '<span class="material-symbols-outlined text-[20px] animate-spin">refresh</span> Đang lưu...';
            
            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                
                const result = await response.json();
                
                if (result.success) {
                    Toast.fire({ icon: 'success', title: result.message });
                    // Cập nhật tên trên thẻ hiển thị (tuỳ chọn)
                    const newName = formData.get('FullName');
                    if (newName) {
                        document.querySelector('h1.font-display-lg').innerText = newName;
                    }
                } else {
                    Toast.fire({ icon: 'error', title: result.message || 'Có lỗi xảy ra, vui lòng thử lại.' });
                }
            } catch (error) {
                Toast.fire({ icon: 'error', title: 'Không thể kết nối đến máy chủ.' });
            } finally {
                // Restore button state
                submitBtn.disabled = false;
                btnContentSpan.innerHTML = originalHtml;
            }
        });
    </script>
}
