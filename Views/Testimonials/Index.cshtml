@model TestimonialIndexViewModel
@{
    ViewData["Title"] = "Đánh giá của khách";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0 text-gray-800">Đánh giá của khách</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Thêm đánh giá mới
    </a>
</div>

@if (Model.Results.TotalItems == 0)
{
    <div class="card"><div class="card-body text-center text-muted py-5">
        <p class="mb-0">Chưa có đánh giá nào.</p>
    </div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 250px">Khách hàng</th>
                        <th>Nội dung đánh giá</th>
                        <th class="text-center">Số sao</th>
                        <th class="text-center">Nguồn</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Results.Items)
                {
                    <tr>
                        <td class="fw-semibold">
                            @item.CustomerName
                        </td>
                        <td>
                            <div class="text-truncate text-wrap" style="max-width: 400px; font-style: italic" title="@item.Content">
                                "@item.Content"
                            </div>
                        </td>
                        <td class="text-center text-warning">
                            @for (int i = 0; i < item.Rating; i++)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            @for (int i = item.Rating; i < 5; i++)
                            {
                                <i class="bi bi-star"></i>
                            }
                        </td>
                        <td class="text-center small">
                            <span class="badge text-bg-light border">@item.Source</span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id" title="Sửa"><i class="bi bi-pencil"></i></a>
                            <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('Xóa đánh giá này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pager" model="@((Model.Results.Page, Model.Results.TotalPages, Model.Results.TotalItems))" />
}
