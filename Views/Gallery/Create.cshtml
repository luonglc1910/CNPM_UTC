@{
    ViewData["Title"] = "Thêm ảnh thư viện";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 text-primary"><i class="bi bi-cloud-upload me-2"></i>Thêm hình ảnh vào thư viện</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tiêu đề / Ghi chú ảnh (không bắt buộc)</label>
                        <input type="text" name="title" class="form-control" placeholder="VD: Toàn cảnh bể bơi vô cực..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tải lên tệp ảnh từ máy tính</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <div class="form-text">Định dạng hỗ trợ: JPG, PNG, WEBP.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Hoặc nhập URL hình ảnh trực tiếp</label>
                        <input type="url" name="imageUrl" class="form-control" placeholder="https://example.com/photo.jpg" />
                        <div class="form-text">Nhập link ảnh ngoài nếu không muốn tải tệp từ máy.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Thứ tự hiển thị (Sort Order)</label>
                        <input type="number" name="sortOrder" value="0" class="form-control" style="width: 120px;" />
                        <div class="form-text">Số nhỏ hơn sẽ hiển thị trước.</div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Lưu hình ảnh
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
