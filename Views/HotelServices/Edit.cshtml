@model HotelServiceFormViewModel
@{
    ViewData["Title"] = $"Sửa dịch vụ {Model.Code}";
}

<div class="card">
    <div class="card-body">
        <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
            <partial name="_Form" model="Model" />
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
