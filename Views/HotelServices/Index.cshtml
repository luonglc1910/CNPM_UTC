@model HotelServiceIndexViewModel
@{
    ViewData["Title"] = "Dịch vụ";
    var isAdmin = User.IsInRole(Roles.Admin);
}

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-end mb-3">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
        <div>
            <label asp-for="Keyword" class="form-label mb-1 small text-muted"></label>
            <input asp-for="Keyword" class="form-control form-control-sm" style="min-width: 200px"
                   placeholder="VD: MB001 hoặc Bia" />
        </div>
        <div>
            <label asp-for="Category" class="form-label mb-1 small text-muted"></label>
            <select asp-for="Category" class="form-select form-select-sm">
                <option value="">— Tất cả nhóm —</option>
                @foreach (var category in Enum.GetValues<ServiceCategory>())
                {
                    <option value="@((int)category)" selected="@(Model.Category == category)">
                        @category.ToDisplayName()
                    </option>
                }
            </select>
        </div>
        <div class="form-check mb-2">
            <input asp-for="LowStockOnly" class="form-check-input" />
            <label asp-for="LowStockOnly" class="form-check-label small"></label>
        </div>
        <div class="form-check mb-2">
            <input asp-for="IncludeInactive" class="form-check-input" />
            <label asp-for="IncludeInactive" class="form-check-label small"></label>
        </div>
        <button type="submit" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="bi bi-search"></i> Tìm
        </button>
        @if (Model.HasFilter)
        {
            <a class="btn btn-link btn-sm mb-2" asp-action="Index">Bỏ lọc</a>
        }
    </form>

    @* Chặn ở server bằng [Authorize] rồi, đây chỉ là phần trải nghiệm (00-conventions mục 2). *@
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-lg"></i> Thêm dịch vụ
        </a>
    }
</div>

@if (Model.LowStockCount > 0 && !Model.LowStockOnly)
{
    <div class="alert alert-warning d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>
            Có <strong>@Model.LowStockCount</strong> dịch vụ đang ở dưới định mức tồn tối thiểu.
            <a asp-action="Index" asp-route-lowStockOnly="true">Xem danh sách</a>
        </span>
    </div>
}

@if (Model.Results.TotalItems == 0)
{
    <div class="card"><div class="card-body text-center text-muted py-5">
        @if (!Model.HasFilter)
        {
            <p class="mb-1">Chưa có dịch vụ nào.</p>
            @if (isAdmin)
            {
                <p class="mb-0 small">Nhấn <strong>Thêm dịch vụ</strong> để bắt đầu.</p>
            }
        }
        else
        {
            <p class="mb-0">Không tìm thấy dịch vụ nào khớp với bộ lọc hiện tại.</p>
        }
    </div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã</th>
                        <th>Tên dịch vụ</th>
                        <th>Nhóm</th>
                        <th class="text-end">Đơn giá</th>
                        <th>Đơn vị</th>
                        <th class="text-center">Quản lý kho</th>
                        <th class="text-end">Tồn hiện tại</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Results.Items)
                {
                    @* Dòng dưới định mức tồn được tô nền vàng kèm biểu tượng cảnh báo — SCR-A06. *@
                    <tr class="@(item.IsLowStock ? "table-warning" : "") @(item.IsActive ? "" : "opacity-50")">
                        <td><code>@item.Code</code></td>
                        <td>@item.Name</td>
                        <td><span class="badge @item.Category.ToBadgeClass()">@item.Category.ToDisplayName()</span></td>
                        <td class="text-end">@item.UnitPrice.ToString("N0") ₫</td>
                        <td>@item.Unit</td>
                        <td class="text-center">
                            @if (item.IsStockManaged)
                            {
                                <i class="bi bi-check-lg text-success" title="Có quản lý kho"></i>
                                @if (item.AllowNegativeStock)
                                {
                                    <i class="bi bi-unlock text-warning ms-1" title="Cho phép bán khi hết hàng"></i>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (item.IsStockManaged)
                            {
                                @if (item.IsLowStock)
                                {
                                    <i class="bi bi-exclamation-triangle-fill text-warning me-1"
                                       title="Tồn @item.StockQuantity, dưới định mức tối thiểu @item.MinStockLevel"></i>
                                }
                                <strong>@item.StockQuantity</strong>
                                <span class="text-muted small">/ @item.MinStockLevel</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge text-bg-success">Đang dùng</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Ngừng dùng</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (isAdmin)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id"
                                   title="Sửa"><i class="bi bi-pencil"></i></a>

                                @if (item.IsActive)
                                {
                                    <form method="post" asp-action="Deactivate" asp-route-id="@item.Id"
                                          class="d-inline"
                                          onsubmit="return confirm('Ngừng sử dụng dịch vụ @item.Code?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Ngừng sử dụng">
                                            <i class="bi bi-slash-circle"></i>
                                        </button>
                                    </form>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Chỉ xem</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Pager" model="@((Model.Results.Page, Model.Results.TotalPages, Model.Results.TotalItems))" />
}
