@model InventoryReceiveViewModel
@{
    ViewData["Title"] = "Nhập kho";
}

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @if (Model.ServiceOptions.Count == 0)
                {
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-info-circle"></i>
                        Chưa có dịch vụ nào đang dùng và bật quản lý kho. Bật "có quản lý kho" ở màn hình
                        <a asp-controller="HotelServices" asp-action="Index">Dịch vụ</a> trước đã.
                    </div>
                    <a class="btn btn-outline-secondary mt-3" asp-action="Index">Quay lại</a>
                }
                else
                {
                    <form method="post" asp-action="Receive">
                        <div class="mb-3">
                            <label asp-for="HotelServiceId" class="form-label">
                                Dịch vụ <span class="text-danger">*</span>
                            </label>
                            <select asp-for="HotelServiceId" asp-items="Model.ServiceOptions" class="form-select">
                                <option value="">— Chọn dịch vụ —</option>
                            </select>
                            <div class="form-text">Số trong ngoặc là tồn sổ sách hiện tại.</div>
                            <span asp-validation-for="HotelServiceId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label">
                                Số lượng nhập <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Quantity" class="form-control" type="number" min="1" autofocus />
                            <div class="form-text">Phải lớn hơn 0. Muốn giảm tồn thì dùng phiếu điều chỉnh.</div>
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Note" class="form-label"></label>
                            <input asp-for="Note" class="form-control"
                                   placeholder="VD: hóa đơn NCC số 0012345" />
                            <span asp-validation-for="Note" class="text-danger small"></span>
                        </div>

                        <div class="alert alert-secondary small">
                            <i class="bi bi-journal-text"></i>
                            Phiếu nhập sinh một dòng <strong>Nhập</strong> trong lịch sử kho kèm tồn sau giao dịch,
                            và được ghi vào nhật ký thao tác (BR-11). Lịch sử kho không sửa, không xóa được.
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-box-arrow-in-down"></i> Nhập kho
                            </button>
                            <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
