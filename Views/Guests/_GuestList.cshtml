@model GuestIndexViewModel
@*
    Tab "Danh sách" của màn Hồ sơ khách. Tách khỏi Index.cshtml khi gộp
    Khai báo tạm trú (SCR-B04) vào cùng màn, để mỗi file giữ một việc.
*@

<div class="guests-summary-grid">
    <div class="guests-summary-card"><span class="guests-summary-icon"><i class="bi bi-people"></i></span><div><small>Tổng hồ sơ</small><strong>@Model.TotalGuests</strong><span>Khách đã ghi nhận</span></div></div>
    <div class="guests-summary-card is-staying"><span class="guests-summary-icon"><i class="bi bi-door-open"></i></span><div><small>Đang lưu trú</small><strong>@Model.StayingGuests</strong><span>Có mặt tại khách sạn</span></div></div>
    <div class="guests-summary-card is-loyal"><span class="guests-summary-icon"><i class="bi bi-stars"></i></span><div><small>Khách quen</small><strong>@Model.LoyalGuests</strong><span>Đủ ngưỡng lượt ở</span></div></div>
    <div class="guests-summary-card is-limited"><span class="guests-summary-icon"><i class="bi bi-shield-exclamation"></i></span><div><small>Danh sách hạn chế</small><strong>@Model.BlacklistedGuests</strong><span>Cần lưu ý khi phục vụ</span></div></div>
</div>

<div class="guests-filter-panel">
    <div class="guests-section-heading"><div><span>Bộ lọc hồ sơ</span><small>Tìm nhanh theo thông tin khách hoặc lịch sử lưu trú</small></div>@if (Model.HasFilter) { <a asp-action="Index"><i class="bi bi-arrow-counterclockwise"></i> Xóa bộ lọc</a> }</div>
    <form method="get" class="guests-filter-grid">
        <div>
            <label asp-for="Keyword" class="form-label mb-1 small text-muted"></label>
            <input asp-for="Keyword" class="form-control"
                   placeholder="VD: Nguyễn Văn A, 0912345678, 001..." />
        </div>

        <div>
            <label asp-for="Nationality" class="form-label mb-1 small text-muted"></label>
            <select asp-for="Nationality" class="form-select">
                <option value="">— Tất cả —</option>
                @foreach (var nationality in Model.NationalityOptions)
                {
                    <option value="@nationality" selected="@(Model.Nationality == nationality)">@nationality</option>
                }
            </select>
        </div>

        <div>
            <label asp-for="Blacklisted" class="form-label mb-1 small text-muted"></label>
            <select asp-for="Blacklisted" class="form-select">
                <option value="">— Tất cả —</option>
                <option value="true" selected="@(Model.Blacklisted == true)">Đang bị hạn chế</option>
                <option value="false" selected="@(Model.Blacklisted == false)">Không hạn chế</option>
            </select>
        </div>

        <div>
            <label asp-for="LastStayFrom" class="form-label mb-1 small text-muted"></label>
            <input asp-for="LastStayFrom" class="form-control" type="date" />
        </div>

        <div>
            <label asp-for="LastStayTo" class="form-label mb-1 small text-muted"></label>
            <input asp-for="LastStayTo" class="form-control" type="date" />
        </div>

        <button type="submit" class="btn btn-primary guests-filter-submit">
            <i class="bi bi-search"></i> Tìm
        </button>
    </form>
</div>

@if (Model.Results.TotalItems == 0)
{
    <div class="card"><div class="card-body text-center text-muted py-5">
        @if (Model.HasFilter)
        {
            <p class="mb-0">Không tìm thấy khách nào khớp với bộ lọc hiện tại.</p>
        }
        else
        {
            <p class="mb-1">Chưa có hồ sơ khách nào.</p>
            <p class="mb-0 small">Nhấn <strong>Thêm khách</strong> để tạo hồ sơ đầu tiên.</p>
        }
    </div></div>
}
else
{
    <div class="card guests-table-card">
        <div class="guests-table-head"><div><strong>@Model.Results.TotalItems hồ sơ phù hợp</strong><span>Dữ liệu lưu trú được tổng hợp từ cả khách đứng tên và khách ở cùng</span></div></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Họ tên</th>
                        <th>Giới tính</th>
                        <th>Giấy tờ</th>
                        <th>SĐT</th>
                        <th>Quốc tịch</th>
                        <th>Lưu trú</th>
                        <th>Lần ở gần nhất</th>
                        <th>Nhãn</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Results.Items)
                {
                    <tr>
                        <td>
                            <a class="guests-name-link" asp-action="Details" asp-route-id="@item.Id">@item.FullName</a>
                            @if (item.IsStaying) { <span class="guests-live-badge"><i class="bi bi-circle-fill"></i> Đang ở</span> }
                        </td>
                        <td>@(item.Gender?.ToDisplayName() ?? "—")</td>
                        <td>
                            @* Danh sách chỉ hiện số giấy tờ dạng che; số đầy đủ nằm ở màn hình chi tiết. *@
                            <span class="text-muted small">@item.IdType.ToDisplayName()</span>
                            <code>@item.MaskedIdNumber</code>
                        </td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Nationality</td>
                        <td>
                            <strong>@item.TotalStayCount</strong> lượt
                            @if (item.CompletedStayCount != item.TotalStayCount) { <span class="d-block text-muted small">@item.CompletedStayCount đã hoàn tất</span> }
                        </td>
                        <td>
                            @if (item.LastStayAt is not null)
                            {
                                @item.LastStayAt.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">Chưa có lượt lưu trú</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (item.IsLoyal)
                            {
                                <span class="badge text-bg-success" title="Từ @item.LoyalThreshold lượt lưu trú trở lên">
                                    Khách quen
                                </span>
                            }
                            @if (item.IsBlacklisted)
                            {
                                <span class="badge text-bg-danger">Hạn chế</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id"
                               title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id"
                               title="Sửa"><i class="bi bi-pencil"></i></a>
                            @* Không có nút Xóa: hồ sơ khách không bao giờ xóa cứng (SCR-B01). *@
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Pager" model="@((Model.Results.Page, Model.Results.TotalPages, Model.Results.TotalItems))" />
}
